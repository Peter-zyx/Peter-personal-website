---
import type { Project } from "../lib/projects";
import { withBase } from "../lib/paths";
type Props = { project: Project };
const { project } = Astro.props;
const asset = (name: string) => withBase(`/images/projects/cp-app/${name}-en.webp`);
const screens = [
  { id: "home", label: "Home", number: "01", title: "A shared day, at a glance.", body: "The home screen brings the next small task, a personal note and the week’s memories into one familiar place. It gives everyday plans a home beyond the chat thread.", details: ["A relationship date chosen by the couple", "Tasks with a clear owner and date", "Shortcuts to wishes, notes and weekly reflection"], principle: "Make the next small action easy to find." },
  { id: "tasks", label: "Tasks", number: "02", title: "Clarity without a scoreboard.", body: "Shared tasks hold dates, ownership and reminders. A task can also open a conversation: each person keeps their own words, and a shared agreement needs both people to confirm the same version.", details: ["Start and due dates, owner and optional daily reminder", "Separate states for completing a task and ending a discussion", "Version checks protect a partner’s more recent edit"], principle: "Coordinate the work. Leave room for a conversation." },
  { id: "ledger", label: "Ledger", number: "03", title: "Know what was shared.", body: "The ledger makes the payer, amount and split explicit. Monthly summaries help both people understand shared spending without turning money into a measure of the relationship.", details: ["Equal, custom or no split", "Amounts stored as integer cents", "Settled and removed records have distinct states"], principle: "A record of expenses, with no payments or transfers." },
  { id: "wishes", label: "Wishes", number: "04", title: "A little idea can keep growing.", body: "The Wish Space replaced a generic shared notebook. A topic gives both people room to add thoughts over time, find a direction and turn an idea into a linked task.", details: ["Topics move from thinking to a direction to action", "Each person can edit their own contributions", "Little notes offer a separate, quieter form of expression"], principle: "Let a wish become a plan in its own time." },
  { id: "week", label: "Weekly journal", number: "05", title: "Keep the small things.", body: "The factual weekly journal brings together completed tasks, expenses, wishes and notes. It follows the underlying records, keeping a plan distinct from something that actually happened.", details: ["Weeks run Monday to Sunday in Beijing time", "Completion uses the server-recorded completion date", "Source records remain accessible for context"], principle: "Start with the record. Make AI an optional next step." },
];
---

<div class="cp-case">
  <header class="cp-hero cp-wrap">
    <a class="back-link" href={withBase("/#projects")}>← Back to the project circle</a>
    <div class="hero-layout">
      <div class="hero-copy">
        <div class="app-signature"><img src={withBase("/images/project-icons/cp-app.svg")} alt="" width="38" height="38" /><span class="cp-label">CP-APP / Our Little World</span></div>
        <h1>A little world.<br />Built for <em>two.</em></h1>
        <p class="hero-deck">The everyday things.<br />A place to keep them, together.</p>
        <p class="hero-description">A private app for shared plans, expenses and small memories. Designed and built with Cici, from a mobile-first Web experience to a native iPhone app.</p>
        <div class="hero-actions"><a class="primary-link" href="#cp-experience">Explore the experience <span aria-hidden="true">↓</span></a><a href="https://cp-app-sable.vercel.app/" target="_blank" rel="noopener">Open Web app <span aria-hidden="true">↗</span></a></div>
        <p class="hero-status"><span aria-hidden="true"></span>In personal use / Web + iPhone / 2026</p>
      </div>
      <div class="hero-visual" aria-label="English interface previews of the working iPhone app">
        <div class="visual-caption cp-label">Made for a life shared</div>
        <figure class="hero-phone phone-back"><img src={asset("ledger")} alt="CP-APP’s English ledger, displaying fictional shared expenses" width="1206" height="2622" /><figcaption>02 / Shared expenses</figcaption></figure>
        <figure class="hero-phone phone-front"><img src={asset("home")} alt="CP-APP’s English home screen, displaying fictional everyday plans" width="1206" height="2622" fetchpriority="high" /><figcaption>01 / Our everyday</figcaption></figure>
        <span class="visual-footnote">Actual SwiftUI interface · Fictional preview records</span>
      </div>
    </div>
    <dl class="project-facts"><div><dt>Collaboration</dt><dd>Peter × Cici</dd></div><div><dt>Practice</dt><dd>Product design & engineering</dd></div><div><dt>Development</dt><dd>Aug – Sep 2026</dd></div><div><dt>Delivery</dt><dd>Web + native SwiftUI</dd></div></dl>
    <nav class="chapter-nav" aria-label="Case study chapters"><a href="#cp-context">01 / The starting point</a><a href="#cp-experience">02 / The experience</a><a href="#cp-consent">03 / Personal choices</a><a href="#cp-system">04 / The system</a><a href="#cp-reflection">05 / In use</a></nav>
  </header>

  <section class="cp-section cp-wrap context" id="cp-context" aria-labelledby="context-title">
    <div><p class="cp-label">01 / A personal starting point</p><h2 id="context-title">Shared life.<br /><span>Scattered information.</span></h2></div>
    <div class="context-copy"><p class="lead">Who was picking that up? Which expense was shared? What was the place we wanted to visit?</p><p>We built CP-APP for the ordinary things that get buried in messages. It brings practical coordination and personal expression into the same space, while giving each person control over what they share.</p><p>The brief came from our own use. This is an independent collaboration, developed with Cici and installed on both of our iPhones.</p></div>
    <div class="principles"><div><span class="cp-label">01 / Coordinate</span><h3>Make the plan clear.</h3><p>Shared tasks and expenses carry the details needed to act.</p></div><div><span class="cp-label">02 / Remember</span><h3>Keep room for little things.</h3><p>Wishes and notes accumulate alongside the practical work.</p></div><div><span class="cp-label">03 / Choose</span><h3>Keep agency personal.</h3><p>Pairing a space never grants permission to track someone.</p></div></div>
  </section>

  <section class="experience" id="cp-experience" aria-labelledby="experience-title">
    <div class="cp-wrap">
      <div class="section-heading"><p class="cp-label">02 / Inside the app</p><h2 id="experience-title">One space.<br /><span>Different parts of everyday life.</span></h2><p>Five main destinations — Home, Tasks, Ledger, Location and Us — keep the navigation simple. Wishes, notes and weekly journals sit within those everyday paths.</p></div>
      <div class="screen-explorer" data-cp-explorer>
        <div class="screen-tabs" role="tablist" aria-label="Explore the app screens" hidden>{screens.map((screen, index) => <button type="button" role="tab" id={`cp-tab-${screen.id}`} aria-controls={`cp-panel-${screen.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>{screen.label}</button>)}</div>
        {screens.map(screen => <div class="screen-panel" id={`cp-panel-${screen.id}`} data-cp-panel>
          <figure class="screen-image"><a href={asset(screen.id)} target="_blank" rel="noopener" aria-label={`Enlarge the English ${screen.label} screenshot`}><img src={asset(screen.id)} alt={`Actual CP-APP ${screen.label} screen in English, using fictional Alex and Sam records`} width="1206" height="2622" loading="lazy" decoding="async" /></a><figcaption>Native iPhone / English <span>Enlarge ↗</span></figcaption></figure>
          <div class="screen-story"><p class="cp-label">{screen.number} / {screen.label}</p><h3>{screen.title}</h3><p>{screen.body}</p><ul>{screen.details.map(detail => <li>{detail}</li>)}</ul><blockquote>{screen.principle}</blockquote></div>
        </div>)}
      </div>
      <p class="capture-note">These are real SwiftUI views rendered in an iOS Simulator from the September 2026 build. Alex, Sam, dates, tasks and amounts are fictional local fixtures; no private account records were used. Interface labels and fixture text are English. Currency remains CNY.</p>
    </div>
  </section>

  <section class="cp-section cp-wrap" id="cp-consent" aria-labelledby="consent-title">
    <div class="section-heading"><p class="cp-label">03 / Designing personal choices</p><h2 id="consent-title">Together, with room<br /><span>to choose for yourself.</span></h2><p>Sharing a space creates a relationship in the product. It does not replace consent. That distinction shaped the location flows, editing rules and AI experience.</p></div>
    <div class="consent-layout"><div class="consent-copy"><span class="large-index" aria-hidden="true">01</span><h3>Location is an invitation.</h3><p>Seeing your own blue dot, sending a one-off check-in and sharing live are three different actions. Opening the map starts none of the sharing flows.</p><p>The map keeps system location separate from shared points. Freshness and accuracy checks filter uploads; a manual display correction can address a regional map offset without changing stored coordinates.</p></div>
      <ol class="location-modes"><li><span class="cp-label">Local only</span><h4>See my location</h4><p>View the system blue dot on this iPhone. No upload to the shared space.</p><span class="mode-limit">On this device</span></li><li><span class="cp-label">One moment</span><h4>Send a check-in</h4><p>Deliberately share a single point. It expires after 24 hours and can be removed earlier.</p><span class="mode-limit">One point / 24 h</span></li><li><span class="cp-label">A chosen window</span><h4>Share live</h4><p>Choose 1, 8 or 24 hours. Only the latest point is retained; a point over two minutes old is hidden from the partner.</p><span class="mode-limit">Time-limited / No route history</span></li></ol>
    </div>
    <div class="consent-layout ai-layout"><div class="consent-copy"><span class="large-index" aria-hidden="true">02</span><h3>A journal, grounded in records.</h3><p>The factual weekly journal works without AI. Optional generation begins with a chosen week and selected record types, followed by a preview of what will be sent.</p><p>Users supply their own provider and key. Prompts ask for quiet, specific reflection, preserve attribution and forbid invented experiences or relationship judgments. Output still needs the reader’s judgment.</p></div>
      <div class="journal-flow"><p class="cp-label">Optional AI / Off by default</p><ol><li><span>01</span><div><h4>Choose the source</h4><p>Pick the week and the kinds of records to include.</p></div></li><li><span>02</span><div><h4>Review before sending</h4><p>Preview the text. Precise locations and raw feedback or reply bodies are excluded.</p></div></li><li><span>03</span><div><h4>Generate deliberately</h4><p>A manual request to the chosen provider. API credentials stay in memory; journals are not yet archived to the cloud.</p></div></li></ol><p class="flow-footer">Supported protocols: OpenAI-compatible / Anthropic</p></div>
    </div>
    <div class="agreement-note"><span class="cp-label">A shared agreement is still two decisions.</span><p>Personal expressions are editable only by their author. Both people confirm the same agreement version; changing its text requires confirmation again. Closing a discussion never means the system declares it resolved.</p></div>
  </section>

  <section class="system-section" id="cp-system" aria-labelledby="system-title"><div class="cp-wrap">
    <div class="section-heading"><p class="cp-label">04 / From Web to native</p><h2 id="system-title">Two clients.<br /><span>One shared set of rules.</span></h2><p>We started with a mobile-first Web app while I was developing on Windows. Moving to the Mac made a native SwiftUI client possible, while the existing accounts, data and database permissions stayed in place.</p></div>
    <div class="system-diagram" role="group" aria-label="Web and native iPhone clients share Supabase authentication, PostgreSQL row-level access rules and controlled database functions">
      <div class="client-lanes"><div><span class="cp-label">01 / Web</span><h3>Next.js + React</h3><p>Vercel deployment<br />Private Realtime signals → data re-fetch</p></div><div><span class="cp-label">02 / iPhone</span><h3>Native SwiftUI</h3><p>iOS 17+ · Keychain · MapKit<br />Foreground refresh every ~15 seconds</p></div></div>
      <div class="connection-lines" aria-hidden="true"><span>↓</span><span>↓</span></div>
      <div class="shared-backend"><span class="cp-label">Shared Supabase backend</span><h3>Same accounts. Same space.</h3><div><span>Auth</span><span>PostgreSQL</span><span>Row-level security</span><span>Controlled RPCs</span></div><p>Access follows the current shared-space membership. Sensitive changes are checked in the database, beyond what either interface displays.</p></div>
    </div>
    <div class="engineering-notes"><article><span class="cp-label">Write carefully</span><h3>Protect the newer edit.</h3><p>Writes compare the original record version. Conflicts preserve a draft instead of silently overwriting the other person’s changes. A successful write followed by a failed refresh is handled separately.</p></article><article><span class="cp-label">Translate the interface</span><h3>Leave people’s words intact.</h3><p>English and Simplified Chinese are device-level choices in the native app. User notes, names and record content are not automatically translated. Database identifiers remain stable.</p></article><article><span class="cp-label">Be precise about delivery</span><h3>Reminders have limits.</h3><p>Native local task reminders are scheduled ahead. Partner activity banners appear while the app is open. Background APNs notifications are future work; cloud changes need a sync to update local schedules.</p></article></div>
  </div></section>

  <section class="cp-section cp-wrap" id="cp-reflection" aria-labelledby="reflection-title">
    <div class="section-heading"><p class="cp-label">05 / Built together, used together</p><h2 id="reflection-title">From a shared idea<br /><span>to two real phones.</span></h2><p>The product became more useful as the work moved from interface previews to real records, shared rules and native behaviour. The next measure is how reliably it fits into our days.</p></div>
    <div class="timeline"><div><span>30 AUG</span><h3>Define the space</h3><p>Product principles, five core destinations and the first Web structure.</p></div><div><span>08 SEP</span><h3>Shape the experience</h3><p>Cici’s frontend work brings the flows, visual language and Wish Space into the main project.</p></div><div><span>14–15 SEP</span><h3>Connect the product</h3><p>Real accounts, shared records, permissions and Web deployment; then native SwiftUI.</p></div><div><span>16 SEP</span><h3>Bring it into daily use</h3><p>Development builds on both iPhones, native English support, reminders and location refinement.</p></div></div>
    <div class="roles"><div><span class="cp-label">My contribution / Peter</span><p>Product direction, shared-backend integration and native iOS engineering, including AI journals, location, reminders and bilingual support.</p></div><div><span class="cp-label">Collaboration / Cici</span><p>Web interface design and frontend development, product-flow refinement, and contributions to task dates and reminder workflows. The final experience grew through both our work.</p></div></div>
    <div class="status-layout"><div><p class="cp-label">Status / 16 September 2026</p><h3>Working software.<br />Still being lived with.</h3><p>The Web app is deployed. Native development builds are installed on both collaborators’ iPhones. This is personal use, with no App Store or TestFlight release yet.</p></div><div class="validation"><h4>What the records establish</h4><p>The development record reports Web and database regression checks, native domain tests, simulator layout checks and successful device builds. These checks support the implementation; they do not establish long-term reliability.</p><h4>What comes next</h4><p>Two-device notification delivery, simultaneous edits, weak networks and background location need continued field validation. Native remote push, Web English support and persistent AI journal archives remain future work.</p></div></div>
    <div class="closing"><p class="cp-label">Reflection</p><p class="closing-line">The small details are<br /><em>the product.</em></p><p>A reminder that arrives at the right time. A draft that survives a conflict. A location shared by choice. Building for two people made those details concrete.</p><div class="hero-actions">{project.links?.map(link => <a href={link.url} target="_blank" rel="noopener">{link.label}<span aria-hidden="true">↗</span></a>)}</div><p class="closing-note">Web app requires an account; its current interface is Chinese. The native English interface is shown above.</p></div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-cp-explorer]").forEach(explorer => {
    const tablist = explorer.querySelector<HTMLElement>("[role=tablist]");
    const tabs = Array.from(explorer.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const panels = Array.from(explorer.querySelectorAll<HTMLElement>("[data-cp-panel]"));
    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => { tab.setAttribute("aria-selected", String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel, i) => { panel.hidden = i !== index; });
      if (focus) tabs[index].focus();
    }
    panels.forEach((panel, i) => { panel.setAttribute("role", "tabpanel"); panel.setAttribute("aria-labelledby", tabs[i].id); panel.tabIndex = 0; });
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", event => {
        let next: number;
        if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (event.key === "ArrowLeft") next = (i + tabs.length - 1) % tabs.length;
        else if (event.key === "Home") next = 0;
        else if (event.key === "End") next = tabs.length - 1;
        else return;
        event.preventDefault(); select(next, true);
      });
    });
    select(0);
    if (tablist) tablist.hidden = false;
  });
</script>

<style>
  .cp-case { --cp-rose: #f2a8b7; --cp-ink: #201a1c; --cp-muted: #b5aaad; --cp-line: #ffffff20; background: #110e10; color: #f7f1ef; overflow: clip; }
