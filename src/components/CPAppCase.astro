  .consent-copy h3 { font-size: 29px; font-weight: 500; letter-spacing: -.025em; margin-bottom: 22px; }
  .consent-copy p { font-size: 14px; color: var(--cp-muted); max-width: 47ch; margin-top: 18px; }
  .location-modes { list-style: none; margin: 0; padding: 0; }
  .location-modes li { position: relative; border-top: 1px solid var(--cp-line); padding: 22px 0 25px 28px; }
