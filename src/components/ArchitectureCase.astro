---
import CaseDecision from "./CaseDecision.astro";
import type { Project } from "../lib/projects";
type Props = { project: Project };
const { project } = Astro.props;
const img = "/images/projects/architecture-design";
const views = [
  { id:"overview",label:"Spatial overview",title:"A path with places to pause.",caption:"A continuous ground-level route connects sheltered seating, open gathering areas and a proposed play element.",source:"Presentation p. 10",alt:"Oblique CAD rendering of The Path, showing the curved ribbed walls, seating pockets, ground-level circulation and slide" },
  { id:"front",label:"Approach",title:"An open edge to the lawn.",caption:"The curved enclosure creates smaller places to sit while keeping the wider campus setting visible.",source:"Presentation p. 12",alt:"Front-view photomontage of the proposed Path structure on Queen's Lawn at Imperial College London" },
  { id:"inside",label:"Inside the curve",title:"Space for one, or a few.",caption:"Modular furniture and tables support individual rest and informal conversations within the curved boundary.",source:"Presentation p. 14",alt:"Interior photomontage of The Path showing people seated beneath curved timber-like ribs and on modular lounge seats" },
  { id:"night",label:"After dark",title:"A different rhythm after dusk.",caption:"The night visualisation explores illuminated edges and a more legible route through the social space.",source:"Presentation p. 15",alt:"Night-time concept visualisation of The Path with illuminated route edges and occupied seating areas" }
];
const concepts = [
  ["InnoRest","concept-bench","A multifunctional bench","Compact and adaptable, but a single unit offered limited scope for larger group activities."],
  ["HoloHub","concept-house","A glass-house environment","A rich programme of activities, with greater construction complexity and cost concerns."],
  ["Spiral structure","concept-spiral","A route with integrated seating","The selected direction combined movement and gathering; its height and scale needed refinement."]
];
---

<div class="path-case">
  <header class="path-hero path-wrap">
    <a class="back-link" href="/#projects">← Back to projects</a>
    <div class="hero-title"><div><p class="path-kicker">Architecture Design / {project.year}</p><h1>The Path<span>.</span></h1></div><span class="path-character" lang="zh" aria-label="径, Jìng">径</span></div>
    <div class="hero-intro"><p class="hero-deck">From passing through<br />to staying a while.</p><p>A proposal for Queen’s Lawn that brings seating, shelter and play into one curved landscape. Developed through site research, co-design and prototypes at the scale of both a place and a person.</p></div>
    <div class="spatial-viewer">
      <fieldset><legend class="sr-only">Explore the final architectural proposal</legend><div class="view-options">{views.map((view,i)=><label><input type="radio" name="path-view" value={view.id} checked={i===0}/><span><small>0{i+1}</small>{view.label}</span></label>)}</div></fieldset>
      <div class="view-panels">{views.map((view,i)=><figure class="view-panel" data-path-view={view.id}><a href={`${img}/${view.id}.webp`} target="_blank" rel="noopener" aria-label={`Enlarge ${view.label.toLowerCase()} rendering`}><img src={`${img}/${view.id}.webp`} alt={view.alt} width="1800" height="1000" loading={i===0?"eager":"lazy"} fetchpriority={i===0?"high":"auto"}/></a><figcaption><div><strong>{view.title}</strong><p>{view.caption}</p></div><span>Concept visualisation<br />{view.source} ↗</span></figcaption></figure>)}</div>
    </div>
    <div class="hero-facts"><div><span>Site</span><strong>Queen’s Lawn, Imperial College London</strong></div><div><span>My contribution</span><strong>Research, concepts, CAD, prototypes &amp; renders</strong></div><div><span>Scope</span><strong>Spatial proposal + tested furniture prototypes</strong></div></div>
  </header>

  <nav class="path-nav path-wrap" aria-label="Architecture case study chapters"><a href="#path-research">01 / Listen</a><a href="#path-selection">02 / Explore</a><a href="#path-prototypes">03 / Co-design</a><a href="#path-seating">04 / Reconfigure</a><a href="#path-outcome">05 / Resolve</a></nav>
  <CaseDecision slug={project.slug} />

  <section class="path-wrap path-section" id="path-research" aria-labelledby="research-title"><div class="section-heading"><p class="path-kicker">01 / Understanding the place</p><h2 id="research-title">A shared lawn.<br /><span>An uneven experience.</span></h2><p>Our research began across Queen’s Lawn and Dangoor Plaza. People moved through the area throughout the day, but staying comfortably depended on the weather, the available seating and the activity around them.</p></div><div class="research-band"><div><strong>45</strong><span>Students surveyed</span></div><div><strong>14</strong><span>Interviews: students, maintenance staff &amp; a professor</span></div><div><strong>12</strong><span>Participants in later prototype co-design</span></div></div><div class="site-observations"><figure><img src={`${img}/muddy-lawn.webp`} alt="Research photograph of worn and muddy grass on Queen's Lawn" width="729" height="698" loading="lazy"/><figcaption>Seasonal ground conditions / Discovery p. 4</figcaption></figure><div class="observation-copy"><article><span>Weather</span><h3>Comfort changes with the season.</h3><p>Winter observations recorded worn grass, mud and exposed seating. Seasonal shadow studies helped the team consider where users might seek sun or shade.</p></article><article><span>Capacity</span><h3>Lunch needs somewhere to land.</h3><p>Market-day observations showed people improvising places to sit and eat. Students wanted seating and useful surfaces close to their everyday routes.</p></article><article><span>Connection</span><h3>Make stopping part of the route.</h3><p>Interviews pointed towards connected facilities, a more welcoming environment and a clearer relationship with campus life and identity.</p></article></div><figure><img src={`${img}/market.webp`} alt="People using crowded outdoor seating during the campus market" width="624" height="713" loading="lazy"/><figcaption>Market-day use / Discovery p. 4</figcaption></figure></div><p class="source-note">Discovery research: 45 survey respondents; interviews with 10 students, 3 maintenance staff and 1 professor. Later co-design: 11 students and 1 professor. These are separate stages and are not combined into a total sample.</p></section>

  <section class="exploration-chapter" id="path-selection" aria-labelledby="selection-title"><div class="path-wrap path-section"><div class="section-heading"><p class="path-kicker">02 / Finding the right scale</p><h2 id="selection-title">Start with possibilities.<br /><span>Then reduce the distance.</span></h2><p>Fifteen initial ideas were developed into three broader concepts. Feedback favoured the spatial character of a route with seating, while questioning the feasibility of a large elevated structure.</p></div><div class="concept-grid">{concepts.map(([name,file,title,body],i)=><article><div class="concept-index"><span>0{i+1}</span><span>{i===2?"Selected direction":"Explored concept"}</span></div><img src={`${img}/${file}.webp`} alt={`${name} early concept illustration from the discovery report`} width="1100" height="1000" loading="lazy"/><h3>{name}</h3><strong>{title}</strong><p>{body}</p></article>)}</div><div class="selection-bridge"><span class="path-kicker">The key refinement</span><p>Bring the experience closer to the ground.</p><div>The staircase idea evolved into two lower, curved alternatives: <b>The Loop</b> and <b>The Path</b>. Physical models helped users compare how each would feel to move through and occupy.</div></div></div></section>

  <section class="path-wrap path-section" id="path-prototypes" aria-labelledby="prototype-title"><div class="section-heading"><p class="path-kicker">03 / Let people arrange the space</p><h2 id="prototype-title">Two models.<br /><span>One clear preference.</span></h2><p>Foam and cardboard models made the alternatives tangible. Small figures and seats allowed participants to arrange facilities and discuss privacy, connection and circulation.</p></div><div class="model-comparison"><figure><div class="model-label"><span>Alternative A</span><strong>The Loop</strong></div><img src={`${img}/loop-model.webp`} alt="Physical model of the elevated Loop alternative, with a raised curved route" width="477" height="540" loading="lazy"/><figcaption>Elevated route / Approx. 1:40 model</figcaption></figure><figure><div class="model-label"><span>Alternative B / Preferred</span><strong>The Path</strong></div><img src={`${img}/path-model.webp`} alt="Physical model of the lower Path alternative, showing a curved ground-level route" width="431" height="504" loading="lazy"/><figcaption>Lower spatial boundary / Approx. 1:21 model</figcaption></figure><div class="preference"><span class="path-kicker">Prototype co-design / n = 12</span><p class="preference-number">8<span>/12</span></p><h3>Preferred The Path.</h3><p>Participants valued the balance of privacy and social connection. The elevated Loop was perceived as separating people above from those below.</p><div class="vote-dots" aria-label="8 of 12 participants preferred the Path">{Array.from({length:12},(_,i)=><i class:list={{filled:i<8}} aria-hidden="true"></i>)}</div><p class="source-note">Reported preference within this small workshop / Final report p. 8</p></div></div><div class="codesign-row"><figure><img src={`${img}/spatial-codesign.webp`} alt="A participant arranges small figures and seating in the Path scale model during the co-design activity" width="632" height="699" loading="lazy"/><figcaption>Arrangement workshop / Original team photograph</figcaption></figure><div class="feedback-decisions"><article><span>Wet ground →</span><h3>Add a defined floor.</h3><p>Users wanted to sit without contact with muddy grass. Flooring became part of the proposed circulation and seating area.</p></article><article><span>Runoff →</span><h3>Design drainage into the form.</h3><p>Feedback identified where rainwater might collect. The revised concept includes drainage channels to address pooling.</p></article><article><span>Play →</span><h3>Give the curve another use.</h3><p>A slide and climbing feature were proposed along the structure, extending its role beyond sitting and passing through.</p></article></div></div><a class="text-link" href={`${img}/report-page-8.webp`} target="_blank" rel="noopener">Read the original spatial co-design sheet <span aria-hidden="true">↗</span></a></section>

  <section class="seating-chapter" id="path-seating" aria-labelledby="seating-title"><div class="path-wrap path-section"><div class="section-heading"><p class="path-kicker">04 / Design at the scale of the body</p><h2 id="seating-title">A seat for company.<br /><span>A place of your own.</span></h2><p>The seating explores a shared bench and an individual recliner using the same modular system. Full-size cardboard prototypes let people test posture, comfort and the value of changing the configuration.</p></div><div class="seat-explorer"><fieldset><legend>Explore the final seating proposal</legend><div class="seat-options"><label><input type="radio" name="path-seat" value="bench" checked/><span>01 / Shared bench</span></label><label><input type="radio" name="path-seat" value="lounge"/><span>02 / Individual recline</span></label></div></fieldset><div class="seat-panels"><div class="seat-panel" data-path-seat="bench"><figure><a href={`${img}/seat-bench.webp`} target="_blank" rel="noopener" aria-label="Enlarge the shared bench CAD concept"><img src={`${img}/seat-bench.webp`} alt="Compact modular bench CAD rendering, showing the timber-like finish and proposed charging components" width="860" height="624" loading="lazy"/></a><figcaption>Final seating CAD / Presentation p. 9 <span>↗</span></figcaption></figure><div><span class="path-kicker">Group configuration</span><h3>Make room<br />for conversation.</h3><p>The compact configuration is intended to seat two or three people for a short break or informal conversation.</p><div class="seat-spec"><strong>2–3</strong><span>Intended users in the bench configuration</span></div><p class="source-note">Concept capacity. The cardboard prototype explored seated use; this is not a certified load rating.</p></div></div><div class="seat-panel" data-path-seat="lounge"><figure><a href={`${img}/seat-lounge.webp`} target="_blank" rel="noopener" aria-label="Enlarge the individual recliner CAD concept"><img src={`${img}/seat-lounge.webp`} alt="Modular recliner CAD concept with a curved back, seat and separate front support" width="774" height="596" loading="lazy"/></a><figcaption>Final seating CAD / Presentation p. 9 <span>↗</span></figcaption></figure><div><span class="path-kicker">Individual configuration</span><h3>Let the posture<br />set the arrangement.</h3><p>The extended form supports a more reclined posture. Separating the front component allows the arrangement to adapt to the person using it.</p><div class="seat-spec"><strong>400 <small>mm</small></strong><span>Proposed seat height</span></div><p class="source-note">Design dimension from the final report. Comfort was explored through prototype feedback.</p></div></div></div></div><div class="seat-feedback"><div class="seat-vote"><span class="path-kicker">A decision changed by testing</span><strong>9<span>/12</span></strong><h3>Did not consider folding essential.</h3><p>Participants saw more versatility in separable modules. The final direction favours a detachable connection, with an interlocking joint and magnets proposed for the head-support component.</p></div><div class="prototype-strip"><figure><img src={`${img}/seat-print.webp`} alt="Small white 3D-printed seating prototype showing the curved reclining form" width="317" height="300" loading="lazy"/><figcaption>01 / Test the form<br />3D-printed model</figcaption></figure><figure><img src={`${img}/cardboard-bench.webp`} alt="Full-size cardboard modular chair arranged as a shared bench on the lawn" width="258" height="214" loading="lazy"/><figcaption>02 / Test the scale<br />1:1 cardboard bench</figcaption></figure><figure><img src={`${img}/cardboard-lounge.webp`} alt="Participant using the full-size cardboard recliner outdoors, with face anonymised in the original report" width="302" height="219" loading="lazy"/><figcaption>03 / Test the posture<br />1:1 recliner trial</figcaption></figure></div></div><p class="source-note">The report records positive comfort feedback from all 12 participants. This is an early, qualitative evaluation; long-term comfort, weathering and structural performance require further testing. Final report pp. 6–7.</p><a class="text-link" href={`${img}/report-page-7.webp`} target="_blank" rel="noopener">Explore the seating feedback and revisions <span aria-hidden="true">↗</span></a></div></section>

  <section class="path-wrap path-section outcome" id="path-outcome" aria-labelledby="outcome-title"><div class="section-heading"><p class="path-kicker">05 / Bringing the scales together</p><h2 id="outcome-title">A place to study,<br /><span>rest and play.</span></h2><p>The final proposal places modular seating and tables within a low, curved boundary. Sheltered pockets, a defined route and playful elements are intended to make staying on the lawn more inviting.</p></div><figure class="site-final"><img src={`${img}/site-aerial.webp`} alt="Aerial photomontage placing The Path architectural proposal on Queen's Lawn within the Imperial campus" width="1400" height="789" loading="lazy"/><figcaption>Final site visualisation / Presentation p. 11. The architectural structure is an unbuilt proposal.</figcaption></figure><div class="proposal-details"><article><span>Spatial envelope</span><h3>Lower the boundary.</h3><p>The curved wall ranges from 0.5 to 2.0 m in the proposed dimensions. The integrated slide and climbing feature reaches 2.2 m.</p></article><article><span>Material direction</span><h3>Plan for outdoor use.</h3><p>The final seating proposal specifies recycled plastic composite and a transparent polycarbonate component. These are design selections, pending detailed outdoor validation.</p></article><article><span>Everyday support</span><h3>Connect rest and work.</h3><p>Tables, proposed solar-assisted charging and campus information displays extend the space’s intended use. Their technical integration remains a development task.</p></article></div><div class="outcome-boundary"><div><span class="path-kicker">What the project demonstrated</span><h3>Research translated<br />into testable decisions.</h3><p>Site research informed the brief; comparative models shaped the architecture; full-size seating trials changed the furniture strategy.</p></div><div><span class="path-kicker">What comes next</span><h3>Resolve the proposal<br />as a real public space.</h3><p>Structural design, drainage performance, accessible circulation, play safety, maintenance, approvals and cost would need detailed development before construction.</p></div></div><div class="team-credit"><p class="path-kicker">Bdobe Outdesign / Team credits</p><h3>Simon Xia · Yuxuan Zhou · Cici Song<br />Ziqi Zhou · Simon Wang</h3><p>I contributed across the full process: site research, concept development, modular seating and architectural modelling, physical prototyping, user testing and final renders. The final proposal is a shared team outcome. Tools included Rhino, Fusion 360, Procreate and Adobe design software.</p></div><div class="report-links"><a href="/reports/the-path-discovery.pdf"><span>01 / Discovery</span><strong>The questions behind the brief <i aria-hidden="true">↗</i></strong><small>15 pages · Research, observation &amp; early concepts</small></a><a href="/reports/the-path-report.pdf"><span>02 / Final report</span><strong>The decisions behind the design <i aria-hidden="true">↗</i></strong><small>11 pages · Prototypes, feedback &amp; specifications</small></a><a href="/reports/the-path-presentation.pdf"><span>03 / Presentation</span><strong>The proposal in perspective <i aria-hidden="true">↗</i></strong><small>16 pages · Final renders &amp; project overview</small></a></div><a class="back-link" href="/#projects">← Return to the project circle</a></section>
</div>

<style>
  .path-case{--path-bg:#eeeee6;--path-ink:#29362d;--path-muted:#697165;--path-line:#ccd0c3;--path-accent:#455e45;background:var(--path-bg);color:var(--path-ink);color-scheme:light;overflow:clip}
  .path-wrap{width:min(100% - 64px,1280px);margin-inline:auto}
  .path-case :is(h1,h2,h3,h4,p,figure){margin:0}
  .path-case :is(h1,h2,h3,h4){font-family:"Space Grotesk",sans-serif;font-weight:500;letter-spacing:-.045em}
  .path-case p{font-size:1rem;line-height:1.75}
  .path-case img{height:auto}
  .path-case .path-kicker{font-size:.67rem;font-weight:650;line-height:1.6;letter-spacing:.13em;text-transform:uppercase;color:var(--path-muted)}
  .path-case .source-note{font-size:.73rem;line-height:1.7;color:var(--path-muted)}
  .path-case figcaption{font-size:.7rem;color:var(--path-muted);line-height:1.6}
  .path-case :is(a,input):focus-visible{outline:3px solid #7d9469;outline-offset:5px}
  .path-case a{text-underline-offset:5px}
  .path-case section[id]{scroll-margin-top:110px}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .back-link{display:inline-flex;min-height:44px;align-items:center;font-size:.8rem;color:var(--path-muted);text-decoration:none}
  .path-hero{padding-top:28px}
  .hero-title{display:flex;justify-content:space-between;align-items:end;gap:40px;margin:38px 0 30px}
  .hero-title h1{font-size:clamp(4.5rem,10.5vw,10rem);line-height:1;letter-spacing:-.075em;margin-top:18px}
  .hero-title h1>span{color:#99a282}
  .path-character{font-family:"Songti SC","STSong",serif;font-size:7rem;line-height:1;font-weight:400;color:#889477;margin-bottom:10px}
  .hero-intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;border-top:1px solid var(--path-line);padding:30px 0 35px}
  .path-case .hero-deck{font-family:"Space Grotesk",sans-serif;font-size:2rem;line-height:1.15;letter-spacing:-.04em}
  .hero-intro>p:last-child{font-size:.95rem;color:var(--path-muted);max-width:590px}
  fieldset{border:0;padding:0;margin:0;min-width:0}
  .view-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:#cbd1c1;border:1px solid #cbd1c1}
  .view-options label,.seat-options label{position:relative;cursor:pointer;min-width:0}
  .view-options input,.seat-options input{position:absolute;width:1px;height:1px;opacity:0}
  .view-options label>span{display:flex;align-items:center;gap:18px;background:#e4e7dc;padding:17px 20px;min-height:55px;font-size:.75rem}
  .view-options small{font-size:.6rem;color:#78816e}
  .view-options input:checked+span{background:#2e4134;color:#f1f2e6}
  .view-options input:checked+span small{color:#bac8ad}
  .view-options input:focus-visible+span,.seat-options input:focus-visible+span{outline:3px solid #889d65;outline-offset:-4px}
  .view-panel{display:none}
  .spatial-viewer:has([value="overview"]:checked) [data-path-view="overview"],.spatial-viewer:has([value="front"]:checked) [data-path-view="front"],.spatial-viewer:has([value="inside"]:checked) [data-path-view="inside"],.spatial-viewer:has([value="night"]:checked) [data-path-view="night"]{display:block}
  .view-panel>a{display:block;background:#c9cfb8}
  .view-panel img{width:100%;height:560px;object-fit:cover;object-position:center}
  .view-panel[data-path-view="overview"] img{object-fit:contain;background:#a7b48a}
  .view-panel[data-path-view="inside"] img,.view-panel[data-path-view="night"] img{object-position:50% 75%}
  .view-panel figcaption{display:flex;justify-content:space-between;gap:45px;align-items:center;padding:25px 0;border-bottom:1px solid var(--path-line)}
  .view-panel figcaption strong{font-family:"Space Grotesk",sans-serif;font-size:1.4rem;font-weight:500;letter-spacing:-.035em;color:var(--path-ink)}
  .view-panel figcaption p{font-size:.8rem;margin-top:9px;max-width:740px}
  .view-panel figcaption>span{font-size:.65rem;flex-shrink:0;line-height:1.8;text-align:right}
  .hero-facts{display:grid;grid-template-columns:1.1fr 1fr 1.2fr;gap:35px;padding:28px 0 34px}
  .hero-facts span{display:block;font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;color:var(--path-muted);margin-bottom:9px}
  .hero-facts strong{font-size:.78rem;font-weight:500;line-height:1.6}
  .path-nav{display:flex;gap:10px 40px;flex-wrap:wrap;padding:12px 0;border-block:1px solid var(--path-line)}
  .path-nav a{display:flex;min-height:32px;align-items:center;font-size:.72rem;text-decoration:none;color:var(--path-muted)}
  .path-nav a:hover{color:var(--path-ink)}
  .path-section{padding-block:95px}
  .section-heading{max-width:760px;margin-bottom:45px}
  .section-heading h2{font-size:clamp(2.35rem,4.4vw,4rem);line-height:1.06;margin:20px 0 24px}
  .section-heading h2 span{color:var(--path-muted)}
  .section-heading>p:last-child:not(.path-kicker){color:var(--path-muted);max-width:700px}
  .research-band{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:45px;border-block:1px solid var(--path-line);padding:30px 0}
  .research-band>div{display:flex;gap:25px;align-items:center}
  .research-band strong{font-family:"Space Grotesk",sans-serif;font-weight:500;font-size:3.7rem;letter-spacing:-.06em}
  .research-band span{font-size:.75rem;line-height:1.6;max-width:190px;color:var(--path-muted)}
  .site-observations{display:grid;grid-template-columns:.8fr 1fr .8fr;gap:38px;align-items:center;margin:40px 0 26px}
  .site-observations>figure{min-width:0}
  .site-observations>figure>img{width:100%;height:350px;object-fit:cover}
  .site-observations figcaption{margin-top:14px}
  .observation-copy article+article{margin-top:25px}
  .observation-copy article>span{font-size:.6rem;text-transform:uppercase;letter-spacing:.1em;color:var(--path-muted)}
  .observation-copy h3{font-size:1.35rem;line-height:1.15;margin:10px 0}
  .observation-copy p{font-size:.85rem;color:var(--path-muted)}
  .exploration-chapter{--path-muted:#b2b9a8;--path-line:#53604f;background:#2e3c32;color:#f0f1e6}
  .concept-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}
  .concept-grid article{border-top:1px solid var(--path-line);padding-top:20px}
  .concept-index{display:flex;justify-content:space-between;font-size:.62rem;color:#c4cbb8;margin-bottom:20px}
  .concept-grid img{width:100%;height:270px;object-fit:contain;background:#fff;padding:18px}
  .concept-grid h3{font-size:1.7rem;margin:22px 0 9px}
  .concept-grid strong{font-size:.8rem;font-weight:500}
  .concept-grid p{font-size:.85rem;color:var(--path-muted);margin-top:15px}
  .selection-bridge{display:grid;grid-template-columns:.55fr 1fr 1.3fr;gap:40px;align-items:start;margin-top:55px;border-top:1px solid var(--path-line);padding-top:30px}
  .selection-bridge>p{font-family:"Space Grotesk",sans-serif;font-size:1.8rem;line-height:1.1;letter-spacing:-.035em}
  .selection-bridge>div{font-size:.9rem;line-height:1.75;color:var(--path-muted)}
  .selection-bridge b{color:#e1e5d7;font-weight:500}
  .model-comparison{display:grid;grid-template-columns:1fr 1fr 1fr;gap:26px;align-items:stretch}
  .model-comparison>figure{background:#dedfd3;padding:22px;min-width:0}
  .model-comparison>figure:nth-child(2){background:#d1dac5}
  .model-label>span{display:block;font-size:.62rem;color:#646d5b;text-transform:uppercase;letter-spacing:.08em}
  .model-label strong{display:block;font-family:"Space Grotesk",sans-serif;font-size:1.8rem;font-weight:500;margin-top:10px}
  .model-comparison>figure>img{width:100%;height:290px;object-fit:contain;margin:22px 0 15px}
  .preference{padding:25px 12px 20px 20px}
  .path-case .preference-number{font-family:"Space Grotesk",sans-serif;font-size:6rem;line-height:1;letter-spacing:-.07em;margin:25px 0}
  .preference-number span{font-size:2.5rem;color:#839175;margin-left:8px}
  .preference h3{font-size:1.65rem;margin-bottom:16px}
