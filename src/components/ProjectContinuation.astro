---
import type {Project} from '../lib/projects';
import {projects} from '../lib/projects';
import {presentation,projectIcons} from '../lib/projectPresentation';
type Props={project:Project};
const {project}=Astro.props;
const next=(presentation[project.slug]?.related??[]).map(slug=>projects.find(p=>p.slug===slug)).filter((p):p is Project=>Boolean(p));
---
{next.length>0 && <footer class="project-continuation"><div class="continuation-wrap"><div class="continuation-heading"><div><span>THE WORK CONTINUES</span><h2>Explore another perspective.</h2></div><a href="/#projects">View the project circle ↗</a></div><div class="continuation-grid">{next.map(item=><a class="continuation-card" href={`/projects/${item.slug}/`}><div class="continuation-object"><img src={projectIcons[item.slug]} alt="" width="160" height="160" loading="lazy"/></div><div><span>{item.category}</span><h3>{presentation[item.slug].name}</h3><p>{item.summary}</p></div><b aria-hidden="true">↗</b></a>)}</div></div></footer>}
<style>
.project-continuation{background:#0c1011;color:#e4e8e3;border-top:1px solid #3c4443;padding:60px 0 72px}.continuation-wrap{width:min(1200px,calc(100% - 64px));margin:auto}.continuation-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:32px}.continuation-heading span{font:500 9px/1.6 ui-monospace,monospace;color:#a4b3ae}.continuation-heading h2{font:400 clamp(25px,3vw,36px)/1.15 Georgia,serif;letter-spacing:normal;margin:12px 0 0;text-wrap:balance}.continuation-heading>a{font:400 11px/1.5 Arial,sans-serif;min-height:44px;display:flex;align-items:center;text-decoration:none;color:#c3cec8}.continuation-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.continuation-card{display:grid;grid-template-columns:125px 1fr 20px;gap:20px;align-items:center;padding:24px 22px;border:1px solid #35403d;text-decoration:none;color:inherit;background:#151c1b}.continuation-object{aspect-ratio:1;display:grid;place-items:center}.continuation-object img{width:100%;height:100%;object-fit:contain}.continuation-card span{font:400 9px/1.6 Arial,sans-serif;color:#9facaa}.continuation-card h3{font:400 23px/1.2 Georgia,serif;margin:10px 0;letter-spacing:normal;text-wrap:balance}.continuation-card p{font:400 11px/1.75 Arial,sans-serif;color:#a9b5b0;margin:0;text-wrap:pretty}.continuation-card>b{font-weight:400;align-self:start;color:#b8c8bf}.continuation-card:hover{border-color:#b8c8bf;background:#1b2522}.project-continuation a:focus-visible{outline:2px solid #dceadd;outline-offset:4px}@media(max-width:900px){.continuation-card{grid-template-columns:88px 1fr 12px;gap:15px;padding:20px 15px}.continuation-card h3{font-size:21px}}@media(max-width:700px){.project-continuation{padding:45px 0}.continuation-wrap{width:calc(100% - 40px)}.continuation-heading{align-items:start;flex-direction:column;gap:15px;margin-bottom:22px}.continuation-grid{grid-template-columns:1fr}.continuation-card{grid-template-columns:84px 1fr 12px;gap:15px}.continuation-card h3{font-size:21px}.continuation-card p{font-size:11px}}
</style>
