---
import CaseDecision from "./CaseDecision.astro";
import type { Project } from "../lib/projects";

type Props = {
  project: Project;
};

const { project } = Astro.props;

const stages: [string, string, string][] = [
  ["01", "Clean", "Remove continuous outliers beyond |Z| > 3"],
  ["02", "Reduce", "Exclude weak or high-dimensional inputs"],
  ["03", "Balance", "Randomly undersample to 500 records per class"],
  ["04", "Split", "Stratified 80 / 20 train-validation partition"],
  ["05", "Classify", "Fit a Random Forest across seven cover types"]
];

const classMetrics: [string, number, string][] = [
  ["Type 1", 71.1, "#ef6c52"],
  ["Type 2", 73.4, "#f0a95f"],
  ["Type 3", 93.9, "#63b9a4"],
  ["Type 4", 99.0, "#d9c84f"],
  ["Type 5", 92.8, "#7c8fd3"],
  ["Type 6", 92.8, "#c477af"],
  ["Type 7", 95.5, "#b7c379"]
];
---

<div class="eco-case" data-eco-case>
  <header class="eco-hero">
    <div class="eco-hero__copy eco-reveal is-visible">
      <a class="eco-back" href="/#projects">Back to projects</a>
      <p class="eco-kicker">Ecological modelling / My section</p>
      <h1>Forest CoverType<br /><span>Classification</span></h1>
      <p class="eco-deck">
        I built a Random Forest pipeline to classify seven forest cover types from terrain and
        environmental signals, turning a heavily imbalanced dataset into a repeatable 88.6%
        validation result.
      </p>
      <div class="eco-tags" aria-label="Project skills">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
    </div>

    <figure class="eco-hero__visual eco-reveal is-visible">
      <img
        src="/images/projects/dataset-prediction/feature-pairplot.jpg"
        alt="Pair plot of elevation, slope and hillshade variables grouped by seven forest cover types"
      />
      <figcaption>
        <span>UCI Covertype / Roosevelt National Forest</span>
        <span>7 classes · terrain + environmental features</span>
      </figcaption>
    </figure>

    <div class="eco-metrics eco-reveal is-visible" aria-label="Project highlights">
      <div><strong>581k</strong><span>source observations</span></div>
      <div><strong>7</strong><span>cover types</span></div>
      <div><strong>3,500</strong><span>balanced records</span></div>
      <div><strong>88.6%</strong><span>validation accuracy</span></div>
    </div>
  </header>
  <CaseDecision slug={project.slug} />

  <div class="eco-body">
    <section class="eco-section eco-preparation" aria-labelledby="prep-title">
      <div class="eco-section__head eco-reveal">
        <p class="eco-index">01 / Preparing the signal</p>
        <h2 id="prep-title">The model starts before the model.</h2>
        <p>
          The original dataset was dominated by a small number of cover types. I treated class
          balance and feature discipline as part of the modelling problem, not as housekeeping,
          because a high headline accuracy would otherwise hide poor minority-class performance.
        </p>
      </div>

      <div class="pipeline eco-reveal" aria-label="Data preparation pipeline">
        {stages.map(([number, title, body]) => (
          <article>
            <span>{number}</span>
            <strong>{title}</strong>
            <p>{body}</p>
          </article>
        ))}
      </div>

      <div class="balance-readout eco-reveal">
        <div class="balance-before">
          <p>Original distribution</p>
          <strong>581,000+</strong>
          <span>Type 2 and 3 represented more than half of the source data.</span>
        </div>
        <div class="balance-arrow" aria-hidden="true">→</div>
        <div class="balance-after">
          <p>Training distribution</p>
          <strong>500 × 7</strong>
          <div class="class-dots" aria-label="Seven equally balanced classes">
            {classMetrics.map(([label, , color]) => <i title={label} style={`--dot: ${color}`}></i>)}
          </div>
          <span>Equal class support made the evaluation readable and comparable.</span>
        </div>
      </div>
    </section>

    <section class="eco-section eco-exploration" aria-labelledby="explore-title">
      <div class="eco-section__head eco-reveal">
        <p class="eco-index">02 / Reading the variables</p>
        <h2 id="explore-title">Weak linear signals. Strong combined structure.</h2>
        <p>
          Individual predictors showed little linear relationship with CoverType. The largest
          absolute coefficient was only 0.1307, so a linear classifier would miss much of the
          interaction between elevation, access, water distance and hillshade. That evidence led
          me towards a tree ensemble.
        </p>
      </div>

      <div class="correlation-layout">
        <figure class="report-figure report-figure--heatmap eco-reveal">
          <button
            class="eco-image-open"
            type="button"
            data-eco-lightbox-src="/images/projects/dataset-prediction/correlation-heatmap.png"
            data-eco-lightbox-alt="Predictor correlation heatmap including forest CoverType"
            aria-label="Enlarge predictor correlation heatmap"
          >
            <img
              src="/images/projects/dataset-prediction/correlation-heatmap.png"
              alt="Predictor correlation heatmap including forest CoverType"
              loading="lazy"
            />
          </button>
          <figcaption>Predictor correlation heatmap / exploratory evidence</figcaption>
        </figure>

        <aside class="correlation-notes eco-reveal">
          <p>Strongest direct correlations with CoverType</p>
          <div><span>Road distance</span><strong>−0.1307</strong></div>
          <div><span>Hillshade noon</span><strong>−0.1163</strong></div>
          <div><span>Fire-point distance</span><strong>−0.0920</strong></div>
          <small>
            Low Pearson values indicate weak linear relationships, not an absence of structure.
            Random Forest can combine multiple thresholds and non-linear interactions.
          </small>
        </aside>
      </div>
    </section>

    <section class="eco-section eco-model" aria-labelledby="model-title">
      <div class="eco-section__head eco-reveal">
        <p class="eco-index">03 / Model choice</p>
        <h2 id="model-title">Many weak trees form one useful decision.</h2>
        <p>
          Random Forest was a natural fit for mixed terrain signals: it does not assume linearity,
          handles interactions between variables, and reduces the instability of a single decision
          tree by aggregating many different training views.
        </p>
      </div>

      <div class="forest-vote eco-reveal" aria-label="Random Forest voting diagram">
        <div class="tree-field" aria-hidden="true">
          {Array.from({ length: 9 }).map((_, index) => (
            <div class:list={["decision-tree", `decision-tree--${(index % 3) + 1}`]}>
              <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
          ))}
        </div>
        <div class="vote-copy">
          <p>Ensemble vote</p>
          <strong>Mode(tree₁ … treeₙ)</strong>
          <span>Each tree sees a different sample and subset of features; the final class is decided collectively.</span>
        </div>
      </div>

      <div class="model-decisions eco-reveal">
        <div><span>Inputs retained</span><strong>Terrain + distance + hillshade</strong></div>
        <div><span>Inputs excluded</span><strong>Aspect, wilderness and soil one-hot columns</strong></div>
        <div><span>Evaluation</span><strong>Stratified 80 / 20 validation</strong></div>
      </div>
    </section>

    <section class="eco-section eco-results" aria-labelledby="results-title">
      <div class="eco-section__head eco-reveal">
        <p class="eco-index">04 / Results</p>
        <h2 id="results-title">The diagonal tells the story.</h2>
        <p>
          The model correctly classified 620 of 700 validation records. Types 3–7 were identified
          with strong consistency, while Types 1 and 2 remained the main source of uncertainty
          because their elevation and hillshade ranges overlap.
        </p>
      </div>

      <div class="results-grid">
        <figure class="confusion-figure eco-reveal">
          <button
            class="eco-image-open"
            type="button"
            data-eco-lightbox-src="/images/projects/dataset-prediction/confusion-matrix.png"
            data-eco-lightbox-alt="Seven-class confusion matrix for forest CoverType prediction"
            aria-label="Enlarge CoverType confusion matrix"
          >
            <img
              src="/images/projects/dataset-prediction/confusion-matrix.png"
              alt="Seven-class confusion matrix for forest CoverType prediction"
              loading="lazy"
            />
          </button>
          <figcaption>Validation confusion matrix / 100 records per class</figcaption>
        </figure>

        <div class="accuracy-card eco-reveal">
          <p>Validation accuracy</p>
          <strong>88.6%</strong>
          <div><span>Macro precision</span><b>88.3%</b></div>
          <div><span>Macro recall</span><b>88.6%</b></div>
          <div><span>Macro F1</span><b>88.4%</b></div>
        </div>
      </div>

      <div class="class-performance eco-reveal">
        <div class="class-performance__head">
          <span>Class</span><span>F1 score</span>
        </div>
        {classMetrics.map(([label, value, color]) => (
          <div class="class-row">
            <strong>{label}</strong>
            <div class="class-track"><i style={`--score: ${value}%; --class-color: ${color}`}></i></div>
            <span>{value}%</span>
          </div>
        ))}
      </div>
    </section>

    <section class="eco-section eco-reflection" aria-labelledby="reflection-title">
      <div class="eco-section__head eco-reveal">
        <p class="eco-index">05 / What I would change</p>
        <h2 id="reflection-title">Good performance, with visible limits.</h2>
        <p>
          Balancing made the classes comparable, but reducing 581k observations to 3,500 also
          discarded substantial natural variation. Excluding wilderness and soil simplified the
          pipeline, yet removed potentially useful ecological context. A stronger next iteration
          would compare class weighting against undersampling, retain encoded categorical features,
          and evaluate through cross-validation plus a held-out test set.
        </p>
      </div>

      <div class="next-steps eco-reveal">
        <article><span>01</span><strong>Keep more data</strong><p>Compare class weights and balanced ensembles with random undersampling.</p></article>
        <article><span>02</span><strong>Restore context</strong><p>Reintroduce soil and wilderness variables with controlled encoding.</p></article>
        <article><span>03</span><strong>Test harder</strong><p>Add cross-validation and a genuinely untouched final test set.</p></article>
      </div>
    </section>

    <section class="eco-close eco-reveal">
      <p class="eco-index">Project takeaway</p>
      <blockquote>
        The useful result was not only 88.6%. It was learning how sampling decisions, feature
        assumptions and evaluation design determine what that number actually means.
      </blockquote>
      <a href="/#projects">Return to project archive</a>
    </section>
  </div>

  <dialog class="eco-lightbox" data-eco-lightbox>
    <button type="button" data-eco-lightbox-close aria-label="Close image" title="Close">×</button>
    <img data-eco-lightbox-image src="" alt="" />
  </dialog>
</div>

<script>
  const ecoRoot = document.querySelector<HTMLElement>("[data-eco-case]");
  const ecoReveal = ecoRoot?.querySelectorAll<HTMLElement>(".eco-reveal") ?? [];

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -7%" }
    );
    ecoReveal.forEach((node) => observer.observe(node));
  } else {
    ecoReveal.forEach((node) => node.classList.add("is-visible"));
  }

  const lightbox = ecoRoot?.querySelector<HTMLDialogElement>("[data-eco-lightbox]");
  const lightboxImage = lightbox?.querySelector<HTMLImageElement>("[data-eco-lightbox-image]");

  ecoRoot?.querySelectorAll<HTMLButtonElement>("[data-eco-lightbox-src]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = button.dataset.ecoLightboxSrc ?? "";
      lightboxImage.alt = button.dataset.ecoLightboxAlt ?? "Project data visualisation";
      lightbox.showModal();
    });
  });

  lightbox?.querySelector<HTMLButtonElement>("[data-eco-lightbox-close]")?.addEventListener("click", () => lightbox.close());
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) lightbox.close();
  });
</script>

<style>
  .eco-case {
    --eco-ink: #101515;
    --eco-paper: #eef0eb;
    --eco-lime: #d9e650;
    --eco-coral: #ef6c52;
    --eco-mint: #63b9a4;
    margin-top: -82px;
    overflow: hidden;
    background: #060908;
    color: var(--text);
  }

  .eco-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(420px, 0.7fr);
    grid-template-rows: 1fr auto;
    gap: 54px 5vw;
    width: min(100% - 48px, 1440px);
    min-height: min(940px, 94svh);
    margin: 0 auto;
    padding: 152px 0 34px;
  }

  .eco-hero__copy {
    align-self: center;
    max-width: 850px;
  }

  .eco-back {
    display: inline-block;
    margin-bottom: clamp(40px, 7vh, 84px);
    color: rgba(246, 248, 243, 0.55);
    font-size: 0.82rem;
    text-underline-offset: 5px;
  }

  .eco-kicker,
  .eco-index {
    margin: 0 0 18px;
    color: var(--eco-lime);
    font-size: 0.72rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .eco-hero h1 {
    margin: 0;
    font-size: clamp(3.9rem, 7vw, 7.8rem);
    font-weight: 620;
    line-height: 0.84;
  }

  .eco-hero h1 span {
    color: rgba(246, 248, 243, 0.45);
    font-weight: 520;
  }

  .eco-deck {
    max-width: 700px;
    margin: 38px 0 0;
    color: rgba(238, 240, 235, 0.68);
    font-size: clamp(1.04rem, 1.35vw, 1.26rem);
    line-height: 1.67;
  }

  .eco-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .eco-tags span {
    padding: 7px 10px;
    border: 1px solid rgba(246, 248, 243, 0.14);
    border-radius: 999px;
    color: rgba(238, 240, 235, 0.6);
    font-size: 0.72rem;
  }

  .eco-hero__visual {
    position: relative;
    align-self: center;
    margin: 22px 0 0;
  }

  .eco-hero__visual::before {
    position: absolute;
    inset: -20px;
    z-index: 1;
    border: 1px solid rgba(217, 230, 80, 0.14);
    content: "";
    pointer-events: none;
  }

  .eco-hero__visual img {
    width: 100%;
    aspect-ratio: 0.84;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.8) contrast(1.1) brightness(0.78);
  }

  .eco-hero__visual figcaption {
    position: absolute;
    right: 0;
    bottom: -26px;
    left: 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: rgba(246, 248, 243, 0.42);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .eco-metrics {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(246, 248, 243, 0.13);
  }

  .eco-metrics div {
    display: grid;
    gap: 6px;
    padding: 22px 24px 0 0;
  }

  .eco-metrics strong {
    font-size: clamp(1.65rem, 2.8vw, 3rem);
    font-weight: 580;
  }

  .eco-metrics span {
    color: rgba(246, 248, 243, 0.43);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .eco-body {
    background: var(--eco-paper);
    color: var(--eco-ink);
  }

  .eco-section,
  .eco-close {
    width: min(100% - 48px, 1320px);
    margin: 0 auto;
    padding: clamp(92px, 12vw, 168px) 0;
  }

  .eco-section + .eco-section,
  .eco-close {
    border-top: 1px solid rgba(16, 21, 21, 0.15);
  }

  .eco-section__head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    column-gap: 8vw;
    align-items: start;
    margin-bottom: clamp(48px, 7vw, 90px);
  }

  .eco-section__head .eco-index,
  .eco-section__head h2 {
    grid-column: 1;
  }

  .eco-section__head h2 {
    margin: 0;
    font-size: clamp(2.65rem, 5.2vw, 5.9rem);
    font-weight: 570;
    line-height: 0.93;
  }

  .eco-section__head > p:last-child {
    grid-column: 2;
    grid-row: 1 / span 2;
    max-width: 610px;
    margin: 34px 0 0;
    color: rgba(16, 21, 21, 0.66);
    font-size: clamp(1.03rem, 1.34vw, 1.24rem);
    line-height: 1.72;
  }

  .eco-body .eco-index {
    color: #64720c;
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 2px solid var(--eco-ink);
  }

  .pipeline article {
    min-height: 220px;
    padding: 22px 24px 24px 0;
    border-bottom: 1px solid rgba(16, 21, 21, 0.18);
  }

  .pipeline article + article {
    padding-left: 20px;
    border-left: 1px solid rgba(16, 21, 21, 0.13);
  }

  .pipeline span,
  .next-steps span {
    color: #64720c;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
  }

  .pipeline strong {
    display: block;
    margin-top: 62px;
    font-size: 1.25rem;
  }

  .pipeline p {
    margin: 10px 0 0;
    color: rgba(16, 21, 21, 0.58);
    font-size: 0.84rem;
    line-height: 1.52;
  }

  .balance-readout {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    gap: 34px;
    align-items: center;
    margin-top: 72px;
    padding: 34px;
    background: #dfe2da;
  }

  .balance-readout > div:not(.balance-arrow) {
    display: grid;
    gap: 10px;
  }

  .balance-readout p {
    margin: 0;
    color: rgba(16, 21, 21, 0.48);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .balance-readout strong {
    font-size: clamp(2.6rem, 5vw, 5.4rem);
    font-weight: 550;
    line-height: 0.94;
  }

  .balance-readout span {
    max-width: 430px;
    color: rgba(16, 21, 21, 0.58);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .balance-arrow {
    color: #64720c;
    font-size: 2.2rem;
    text-align: center;
  }

  .class-dots {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 5px;
    width: min(100%, 360px);
  }

  .class-dots i {
    height: 14px;
    background: var(--dot);
  }

  .correlation-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(260px, 0.45fr);
    gap: 38px;
    align-items: stretch;
  }

  figure {
    margin: 0;
  }

  .eco-image-open {
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: white;
    cursor: zoom-in;
  }

  .eco-image-open img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 600ms cubic-bezier(0.2, 0.72, 0, 1);
  }

  .eco-image-open:hover img {
    transform: scale(1.015);
  }

  .report-figure--heatmap .eco-image-open {
    aspect-ratio: 1.46;
  }

  .report-figure figcaption,
  .confusion-figure figcaption {
    margin-top: 12px;
    color: rgba(16, 21, 21, 0.45);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .correlation-notes {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--eco-ink);
    color: var(--eco-paper);
  }

  .correlation-notes > p,
  .accuracy-card > p,
  .vote-copy > p {
    margin: 0 0 42px;
    color: rgba(238, 240, 235, 0.5);
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  .correlation-notes > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid rgba(238, 240, 235, 0.14);
  }

  .correlation-notes span {
    color: rgba(238, 240, 235, 0.62);
    font-size: 0.8rem;
  }

  .correlation-notes strong {
    color: var(--eco-lime);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
  }

  .correlation-notes small {
    margin-top: auto;
    padding-top: 46px;
    color: rgba(238, 240, 235, 0.56);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .forest-vote {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.5fr);
    min-height: 520px;
    background: var(--eco-ink);
    color: var(--eco-paper);
  }

  .tree-field {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 34px;
    align-content: center;
    padding: 56px;
    border-right: 1px solid rgba(238, 240, 235, 0.12);
  }

  .decision-tree {
    position: relative;
    height: 108px;
  }

  .decision-tree::before,
  .decision-tree::after,
  .decision-tree i {
    position: absolute;
    background: rgba(238, 240, 235, 0.48);
    content: "";
  }

  .decision-tree::before {
    bottom: 0;
    left: 50%;
    width: 2px;
    height: 96px;
  }

  .decision-tree::after {
    top: 32px;
    left: 22%;
    width: 56%;
    height: 2px;
  }

  .decision-tree i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--eco-lime);
  }

  .decision-tree i:nth-child(1) { top: 4px; left: calc(50% - 5px); }
  .decision-tree i:nth-child(2) { top: 27px; left: calc(22% - 5px); }
  .decision-tree i:nth-child(3) { top: 27px; right: calc(22% - 5px); }
  .decision-tree i:nth-child(4) { top: 60px; left: calc(10% - 5px); }
  .decision-tree i:nth-child(5) { top: 60px; left: calc(36% - 5px); }
  .decision-tree i:nth-child(6) { top: 60px; right: calc(36% - 5px); }
  .decision-tree i:nth-child(7) { top: 60px; right: calc(10% - 5px); }

  .decision-tree--2 { transform: scale(0.82); opacity: 0.72; }
  .decision-tree--3 { transform: scale(0.68); opacity: 0.48; }

  .vote-copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 38px;
  }

  .vote-copy strong {
    color: var(--eco-lime);
    font-size: clamp(1.8rem, 3vw, 3.4rem);
    font-weight: 560;
    line-height: 1.05;
