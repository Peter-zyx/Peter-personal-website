  .back-link{display:inline-flex;align-items:center;min-height:44px;font-size:.8rem;text-decoration:none;color:var(--sg-muted)!important}
  .segway-hero{padding-top:24px}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);gap:85px;align-items:center;padding:25px 0 60px}
  .hero-copy h1{font-size:clamp(3.5rem,5.8vw,5.65rem);line-height:1.02;margin:29px 0;letter-spacing:-.065em}
  .hero-copy h1 em{font-style:normal;color:var(--sg-accent)}
  .hero-deck{font-size:1.36rem;max-width:490px;line-height:1.4!important}
  .hero-description{font-size:.95rem;color:var(--sg-muted);max-width:530px;margin-top:21px!important}
