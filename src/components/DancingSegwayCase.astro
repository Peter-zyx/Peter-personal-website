  .hero-meta{display:grid;grid-template-columns:1fr 1fr;gap:25px;margin-top:48px;padding-top:22px;border-top:1px solid var(--sg-line)}
  .hero-meta span{display:block;color:var(--sg-muted);font-size:.64rem;text-transform:uppercase;letter-spacing:.1em;margin-bottom:9px}
  .hero-meta strong{font-weight:500;font-size:.75rem;line-height:1.6;display:block}
  .film-frame{max-width:405px;width:100%;justify-self:end;background:#1e231a;border:1px solid #404837;box-shadow:14px 14px 0 #191e15}
