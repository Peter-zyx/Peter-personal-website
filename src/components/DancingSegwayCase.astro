  .technical-strip{display:grid;grid-template-columns:repeat(3,1fr) 1fr;gap:35px;border-block:1px solid var(--sg-line);padding:28px 0}
  .technical-strip strong{font-family:"Space Grotesk",sans-serif;font-size:2.7rem;font-weight:500;letter-spacing:-.05em}
  .technical-strip small{font-size:1rem;color:var(--sg-accent);letter-spacing:0}
