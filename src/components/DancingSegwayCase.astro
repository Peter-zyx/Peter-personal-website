  .technical-strip>p{align-self:center;font-size:.8rem;color:var(--sg-muted);padding-left:25px;border-left:1px solid var(--sg-line)}
  .segway-nav{display:flex;flex-wrap:wrap;gap:8px 36px;padding-block:20px 30px}
  .segway-nav a{font-size:.7rem;min-height:32px;display:flex;align-items:center;text-decoration:none;color:var(--sg-muted)}
  .section-space{padding-block:90px}
  .section-heading{max-width:730px;margin-bottom:42px}
  .section-heading h2,.archive-heading h2{font-size:clamp(2.65rem,4.4vw,4.5rem);line-height:1.06;margin:18px 0 25px}
  .section-heading h2 span,.archive-heading h2 span{color:var(--sg-muted)}
  .section-heading>p:last-of-type{color:var(--sg-muted);max-width:650px;font-size:1rem}
  code{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.88em}
  .sequence-chapter{background:#e9e5d9;--sg-ink:#252b20;--sg-muted:#626b58;--sg-accent:#596b3c;--sg-line:#c5cab8;color:var(--sg-ink)}
  .sequencer{padding:28px;background:#f5f1e6;border:1px solid #b9c0a8;box-shadow:0 10px 0 #d8dacb}
  .console-top{display:flex;justify-content:space-between;gap:20px;padding-bottom:20px;border-bottom:1px solid #d0d3c3;font-family:ui-monospace,monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.08em}
  .interaction-hint{display:none;font-size:.8rem;color:var(--sg-muted);margin-top:20px!important}
  .is-ready .interaction-hint{display:block}
  .step-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px;margin-block:22px 30px;pointer-events:none}
  .is-ready .step-grid{pointer-events:auto}
  .step-grid button{display:flex;flex-direction:column;align-items:start;gap:12px;padding:14px 16px;color:#424c36;background:#e0e2d2;border:1px solid #bfc6ad;min-width:0;text-align:left}
  .step-grid button small{font-family:ui-monospace,monospace;font-size:.65rem}
  .step-grid button strong{font-family:"Space Grotesk",sans-serif;font-size:2.55rem;line-height:1;font-weight:500}
  .step-grid button>span{align-self:end;font-size:1.3rem}
  .step-grid button[aria-pressed="true"]{background:#34442b;color:#f4f3de;border-color:#34442b;box-shadow:inset 0 -5px 0 #e3b75e}
  .step-grid button:hover{border-color:#445234}
  .console-bottom{display:grid;grid-template-columns:1.15fr 1fr .8fr;gap:30px;align-items:center}
  .command-display{display:flex;gap:22px;align-items:center;min-width:0}
  .command-arrow{font-size:3.5rem;width:55px;text-align:center;flex-shrink:0;color:#647644}
  .console-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.09em;color:var(--sg-muted)}
  .command-display p{font-family:"Space Grotesk",sans-serif;font-size:1.5rem;line-height:1.2;margin:10px 0}
  [data-command-count]{font-size:.68rem;color:var(--sg-muted)}
  .motor-pair{display:grid;grid-template-columns:1fr 1fr;gap:22px;border-inline:1px solid #cbd0bd;padding-inline:28px}
  .motor-pair span,.motor-pair small{display:block;font-size:.6rem;color:var(--sg-muted)}
  .motor-pair strong{font-family:ui-monospace,monospace;font-size:2rem;display:block;font-weight:400;margin:8px 0;font-variant-numeric:tabular-nums}
  .console-actions{display:none;gap:8px}
  .is-ready .console-actions{display:grid}
  .beat-button{display:flex;justify-content:space-between;gap:20px;align-items:center;background:#34442b;color:#f7f2dc;border:0;padding:16px 18px;min-height:50px;font-size:.85rem!important}
  .reset-button{border:0;background:none;min-height:44px;font-size:.72rem!important;color:var(--sg-muted)}
  .console-foot{display:flex;justify-content:space-between;gap:25px;align-items:center;border-top:1px solid #cbd0bd;margin-top:28px;padding-top:20px;color:var(--sg-muted)}
  .console-foot>span{white-space:nowrap;font-size:.65rem}.console-foot p{font-size:.68rem;max-width:460px}
  .noscript-note{font-size:.8rem;margin-top:15px!important}
  .sequence-notes{display:grid;grid-template-columns:1fr 1fr;gap:60px;margin-top:35px}
  .sequence-notes p{font-size:.8rem;color:var(--sg-muted)}.sequence-notes b{color:var(--sg-ink);font-weight:600}
  .signal-layout{display:grid;grid-template-columns:1fr 1.15fr;gap:110px}
  .signal-flow{list-style:none;margin:0;padding:0}
  .signal-flow li{display:flex;gap:25px;position:relative;padding-bottom:32px}
  .signal-flow li:last-child{padding-bottom:0}
  .signal-flow li:not(:last-child):before{content:"";position:absolute;left:20px;top:42px;bottom:0;border-left:1px solid #505a42}
  .flow-number{width:42px;height:42px;flex-shrink:0;border:1px solid #505a42;display:grid;place-items:center;font-family:ui-monospace,monospace;font-size:.7rem;color:var(--sg-accent)}
  .signal-flow h3{font-size:1.55rem;line-height:1.2;margin:12px 0}
  .signal-flow p{font-size:.9rem;color:var(--sg-muted)}
  .source-link{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;min-height:44px;font-size:.76rem;text-decoration:none;border-bottom:1px solid var(--sg-line);margin-top:25px}
  .signal-note{display:grid;grid-template-columns:1fr 2fr;gap:40px;border-block:1px solid var(--sg-line);padding:25px 0;margin-top:45px}
