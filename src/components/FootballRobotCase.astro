---
import CaseDecision from "./CaseDecision.astro";
import type { Project } from "../lib/projects";
type Props = { project: Project };
const { project } = Astro.props;
const img = "/images/projects/ai-football-robot";
const media = "/videos/ai-football-robot";
const files = "/downloads/ai-football-robot";
const clips = [
  {id:"7982",title:"Red team / defence in play",time:"2:03",description:"The red robots occupy the near goal area as the grey robots and ball move across the pitch. This is the red-team match identified by the designer."},
  {id:"7983",title:"Another match / goal congestion",time:"3:13",description:"Yellow and magenta robots share a crowded pitch, with robots collecting around the goal openings. Additional competition context."},
  {id:"7985",title:"Close view / contact and boundaries",time:"0:27",description:"A short view of yellow, green and grey robots close to the ball and side walls. Additional competition context."},
  {id:"7986",title:"Another match / shared space",time:"1:07",description:"A longer view of yellow, green and grey robots moving, meeting and becoming crowded near the boundaries."},
  {id:"7988",title:"Project discussion",time:"2:39",description:"The recorded debrief explains two defenders and one attacker, goal-seeking behaviour, a reversed attacker motor direction, and the difficulty of seeing the goal from corners."}
];
const groups = [{id:"ball",label:"Football",count:202},{id:"goal",label:"Goal",count:72},{id:"robot",label:"Robot",count:84}];
const labels = [["ball","Ball","ID 1"],["goal","Opposing goal","ID 2 / goal"],["goal1","Own goal","ID 3 / goal1"],["redRobot","Red robot","ID 4"],["robot1","Robot1","ID 5"]];
const scores = [["Ball",.94],["Goal",.82],["Goal1",.84],["Red robot",.93],["Robot1",.95]] as const;
---

<div class="football-case">
  <header class="fb-wrap fb-hero">
    <a class="back-link" href="/#projects">← Back to projects</a>
    <div class="hero-top"><p class="fb-eyebrow">AI Football Robot / {project.year}</p><span class="team-marker"><i></i> Red team</span></div>
    <h1>Hold the line<span>.</span></h1>
    <div class="hero-intro"><p class="hero-statement">Recognise the goal.<br />Commit to defence.</p><p>A vision-guided football robot with a deliberately defensive match strategy. Embedded perception, simple motor rules and a crowded 3v3 pitch meet in one physical experiment.</p></div>
    <div class="tactics-hero">
      <div class="tactics-board"><div class="board-heading"><span>Match intention / 2 defend, 1 attacks</span><span>3v3</span></div>
        <svg class="pitch" viewBox="0 0 700 390" role="img" aria-label="Conceptual tactic diagram: two red defenders occupy their goal while a third red attacker faces the ball and opponents in open play. This is an illustration, not tracked match positions.">
          <defs><pattern id="pitch-grid" width="35" height="35" patternUnits="userSpaceOnUse"><path d="M35 0H0V35" fill="none" stroke="#f5f3df" stroke-opacity=".06"/></pattern></defs>
          <rect width="700" height="390" fill="url(#pitch-grid)"/><rect x="45" y="40" width="610" height="310" rx="4" fill="none" stroke="#c0c9a8" stroke-opacity=".55"/>
          <path d="M350 40V350M45 100H145V290H45M655 100H555V290H655M45 150H25V240H45M655 150H675V240H655" fill="none" stroke="#c0c9a8" stroke-opacity=".55"/><circle cx="350" cy="195" r="65" fill="none" stroke="#c0c9a8" stroke-opacity=".45"/>
          <path d="M69 137V253" stroke="#ecb2a0" stroke-width="3" stroke-dasharray="5 6"/><path d="M128 117Q195 195 128 274" fill="none" stroke="#ddb397" stroke-opacity=".45" stroke-dasharray="5 7"/>
          <g fill="#c44d3d" stroke="#efb6a3" stroke-width="2"><circle cx="80" cy="168" r="25"/><circle cx="80" cy="224" r="25"/><circle cx="350" cy="265" r="25"/></g>
          <g fill="#d4d5c6" stroke="#f2f1df" stroke-width="2"><circle cx="412" cy="128" r="23"/><circle cx="456" cy="270" r="23"/><circle cx="566" cy="181" r="23"/></g>
          <circle cx="274" cy="213" r="13" fill="#f3f0dc"/><path d="m274 204 8 6-3 9h-10l-3-9Z" fill="#334238"/>
          <text x="58" y="326" fill="#efc5b4" font-size="12" font-family="monospace">OUR GOAL</text><text x="506" y="326" fill="#c7cfb5" font-size="12" font-family="monospace">OPEN PLAY</text>
        </svg><div class="board-footer"><p>Two defenders cover the opening.<br /><strong>One attacker follows the ball.</strong></p><span>Strategy illustration<br />Not positional tracking</span></div>
      </div>
      <figure class="red-robot"><img src={`${img}/7982.webp`} alt="Frame from the supplied red-team match, with the red robots near the goal" width="1280" height="720" fetchpriority="high"/><figcaption><span>Our red team, in play</span><p>Actual match footage. Our strategy puts two defenders near the goal.</p><a href="#football-film">See it on the pitch ↗</a></figcaption></figure>
    </div>
    <div class="hero-facts"><div><span>Intent</span><strong>Goal recognition &amp; defensive play</strong></div><div><span>Tools</span><strong>Edge Impulse · OpenMV · MicroPython</strong></div><div><span>Evidence</span><strong>Training results, controller &amp; match footage</strong></div></div>
  </header>
  <nav class="fb-wrap fb-nav" aria-label="Football robot case study chapters"><a href="#football-film">01 / On the pitch</a><a href="#football-vision">02 / Learning to see</a><a href="#football-model">03 / Model evidence</a><a href="#football-control">04 / Decisions</a><a href="#football-reflection">05 / Reflection</a></nav>
  <CaseDecision slug={project.slug} />

  <section class="film-chapter" id="football-film" aria-labelledby="film-title"><div class="fb-wrap fb-section">
    <div class="section-heading"><p class="fb-eyebrow">01 / The match strategy</p><h2 id="film-title">Defence was<br /><span>the design decision.</span></h2><p>Our 3v3 strategy gave two robots defensive roles and one an attacking role. The defenders were intended to find our goal and occupy its left and right sides; the attacker followed the ball. The red-team footage shows that commitment to guarding the opening.</p></div>
    <ol class="defence-steps"><li><span>01 / Find</span><strong>Turn to see our goal.</strong><p>The recorded debrief describes rotating to locate the friendly goal.</p></li><li><span>02 / Approach</span><strong>Move towards the opening.</strong><p>Use the detected goal and a configured threshold to decide when to stop approaching.</p></li><li><span>03 / Defend</span><strong>Occupy the left and right.</strong><p>Position two defenders in the opening while a third robot takes the attacking role.</p></li></ol><p class="strategy-source">Strategy described in the project debrief, 00:38–01:28. The exact goal threshold and final defender implementation are not present in the supplied controller file.</p>
    <div class="match-gallery" data-football-gallery><figure class="match-player"><video controls playsinline preload="metadata" poster={`${img}/7982.webp`} aria-label="AI football robot match and project videos" aria-describedby="football-video-caption"><source src={`${media}/7982.mp4`} type="video/mp4"/></video><figcaption id="football-video-caption" data-clip-caption>{clips[0].description}</figcaption></figure><div class="clip-list"><p class="fb-eyebrow">Field recordings / 05 clips</p>{clips.map((clip,i)=><div class="clip-row"><button type="button" disabled data-clip-id={clip.id} data-clip-description={clip.description} aria-pressed={i===0?"true":"false"}><span class="clip-index">0{i+1}</span><span><strong>{clip.title}</strong><small>{clip.time} / Original audio</small></span><span aria-hidden="true">↗</span></button><a href={`${media}/${clip.id}.mp4`} target="_blank" rel="noopener" aria-label={`Open ${clip.title.toLowerCase()} video directly`}>Open clip</a></div>)}<p class="gallery-note">The first clip shows our red team. The other matches provide competition context; the final recording is a project discussion.</p></div></div>
  </div></section>

  <section class="fb-wrap fb-section" id="football-vision" aria-labelledby="vision-title"><div class="section-heading"><p class="fb-eyebrow">02 / Start with what the camera sees</p><h2 id="vision-title">A ball. A goal.<br /><span>Another robot.</span></h2><p>Training begins with ordinary views from the robot’s camera: the same object at different distances, angles and positions. The local capture script uses RGB565 colour and QVGA frames.</p></div>
    <div class="dataset-browser"><fieldset><legend>Explore the local capture folders</legend><div class="dataset-options">{groups.map((group,i)=><label><input type="radio" name="football-dataset" value={group.id} checked={i===0}/><span>{group.label}<small>{group.count} images</small></span></label>)}</div></fieldset>{groups.map(group=><div class="dataset-panel" data-dataset-panel={group.id}><div class="sample-grid">{[1,2,3].map(n=><figure><a href={`${img}/${group.id}-${n}.webp`} target="_blank" rel="noopener" aria-label={`Enlarge ${group.label.toLowerCase()} capture ${n}`}><img src={`${img}/${group.id}-${n}.webp`} alt={`Original ${group.label.toLowerCase()} camera capture ${n} from the local training folder`} width="320" height="240" loading="lazy"/></a><figcaption>Camera sample / 0{n}</figcaption></figure>)}</div></div>)}</div>
    <div class="data-context"><strong>358<span>local JPEGs</span></strong><p>202 football, 72 goal and 84 robot images are present in the supplied folder. The training screenshot shows a later five-object-label model, so this local capture collection is presented as a source subset, rather than a complete training export.</p></div>
    <div class="vision-path"><div><span>01 / Capture</span><strong>RGB camera frames</strong><p>Collect the environment from the camera’s point of view.</p></div><div><span>02 / Label</span><strong>Objects, not just scenes</strong><p>The training interface shows separate ball and goal bounding boxes in a shared image.</p></div><div><span>03 / Deploy</span><strong>Detections for control</strong><p>The OpenMV controller requests detections and turns object IDs into movement decisions.</p></div></div>
  </section>

  <section class="model-chapter" id="football-model" aria-labelledby="model-title"><div class="fb-wrap fb-section"><div class="section-heading"><p class="fb-eyebrow">03 / What the training run tells us</p><h2 id="model-title">Small model.<br /><span>Visible evidence.</span></h2><p>The supplied Edge Impulse screenshot records a quantized int8 model and its validation results. These numbers describe object detection on the validation set; match performance involves the controller, contact and the changing scene as well.</p></div>
    <div class="model-layout"><div class="model-score"><span class="fb-eyebrow">Validation / reported F1 score</span><strong>89.5<span>%</span></strong><p>Quantized int8 model</p><div class="precision-recall"><div><strong>0.87</strong><span>Precision</span></div><div><strong>0.92</strong><span>Recall</span></div></div><small>Non-background precision and recall, as shown in the supplied training result.</small></div><div class="class-scores"><h3>Where recognition varies</h3><p>Per-class F1 from the validation screenshot</p>{scores.map(([label,score])=><div class="score-row"><span>{label}</span><div class="score-track"><i style={`width:${score*100}%`}></i></div><strong>{score.toFixed(2)}</strong></div>)}<p class="score-note">Goal labels have the lowest F1 values in this run—an important area to improve for a goal-led strategy.</p></div></div>
    <dl class="training-settings"><div><dt>Training cycles</dt><dd>80</dd></div><div><dt>Learning rate</dt><dd>0.001</dd></div><div><dt>Validation split</dt><dd>20%</dd></div><div><dt>Augmentation</dt><dd>Enabled</dd></div></dl>
    <div class="training-evidence"><figure><a href={`${img}/features.webp`} target="_blank" rel="noopener"><img src={`${img}/features.webp`} alt="Supplied Edge Impulse screenshot showing ball and goal1 annotations, RGB image processing, 7 ms processing time and 4 KB peak RAM for the image-processing block" width="2282" height="1606" loading="lazy"/></a><figcaption><strong>Image processing &amp; annotations ↗</strong><p>The displayed 7 ms / 4 KB figures belong to the image-processing block, not the full detector or robot response.</p></figcaption></figure><figure><a href={`${img}/validation.webp`} target="_blank" rel="noopener"><img src={`${img}/validation.webp`} alt="Supplied Edge Impulse validation screenshot with 89.5 percent F1, per-class confusion matrix and quantized int8 training settings" width="2306" height="1626" loading="lazy"/></a><figcaption><strong>Training &amp; validation evidence ↗</strong><p>Five object labels plus background. Open the original screenshot to inspect the matrix and training settings.</p></figcaption></figure></div>
  </div></section>

  <section class="fb-wrap fb-section" id="football-control" aria-labelledby="control-title"><div class="section-heading"><p class="fb-eyebrow">04 / Inside the controller notebook</p><h2 id="control-title">What is visible<br /><span>changes the next move.</span></h2><p>The saved controller uses the presence of object labels to select a motor command. Explore its rule order below. It records broader movement experiments; the goal-centre and threshold-based defender described in the debrief is an implementation not included in this folder.</p></div>
    <div class="decision-lab" data-football-decisions><fieldset><legend>Choose the objects detected in a frame</legend><div class="detection-options">{labels.map(([id,label,number])=><label><input type="checkbox" data-detection={id} disabled/><span><small>{number}</small>{label}<i aria-hidden="true">+</i></span></label>)}</div></fieldset><div class="decision-output" aria-live="polite" aria-atomic="true"><div><span class="fb-eyebrow">Selected code branch</span><h3 data-decision-title>Turn to search</h3><p data-decision-detail>No objects detected: turn for 100 ms, then stop.</p></div><div class="wheel-commands"><div><span>Left wheel</span><strong data-left-command>−50</strong></div><div><span>Right wheel</span><strong data-right-command>+50</strong></div><small>Signed PWM commands / %</small></div></div><div class="lab-footer"><span>Source: main.py + HackbotV2.py</span><span>Rule illustration / not live inference</span></div><noscript><p class="nojs-note">Interactive selection requires JavaScript. The source controller is available below; no detected objects triggers a brief search turn followed by a stop.</p></noscript></div>
    <div class="controller-notes"><article><span>Decisions on a schedule</span><h3>A 400 ms interval.</h3><p>The script requests detections after more than 400 ms have elapsed. This is its configured decision interval, rather than a measured inference latency.</p></article><article><span>Order is part of the policy</span><h3>The first matching rule wins.</h3><p>Ball + goal precedes ball + goal1, then robot1, then ball alone. A red-robot detection is recorded but has no dedicated movement branch.</p></article><article><span>What remains in the snapshot</span><h3>Make fallback behaviour explicit.</h3><p>If detections exist but no movement rule matches, the saved script issues no new command. A refined controller would define that state deliberately.</p></article></div><a class="text-link" href={`${files}/main.py.txt`} target="_blank" rel="noopener">Inspect the saved controller ↗</a>
  </section>

  <section class="reflection-chapter" id="football-reflection" aria-labelledby="reflection-title"><div class="fb-wrap fb-section"><div class="reflection-heading"><div><p class="fb-eyebrow">05 / What the pitch teaches</p><h2 id="reflection-title">Recognition is<br /><span>only the beginning.</span></h2></div><p>The recorded debrief reports that the two defenders fitted the goal, while the attacker moved backwards after detecting the ball. It describes a tie, with the team then conceding to their opponents. These observations turn the match into specific next steps for the design.</p></div><div class="reflection-grid"><article><span>01</span><h3>Check direction before strategy.</h3><p>The debrief identifies reversed motor direction on the attacker: detecting the ball produced backward motion. A basic forward/turn check needs to come before a full match test.</p></article><article><span>02</span><h3>Make room to see the goal.</h3><p>From deep corners, the defenders struggled to recognise the goal. The suggested refinement was to move forward slightly before rotating to search again.</p></article><article><span>03</span><h3>Keep the evidence connected.</h3><p>Goal recognition, position and motor direction all affect the outcome. Future tests can connect validation scores to time covering the goal and recovery after displacement.</p></article></div><div class="debrief-links"><span>Listen to the project debrief</span><a href="/videos/ai-football-robot/7988.mp4#t=0" target="_blank" rel="noopener">00:00 / Team strategy ↗</a><a href="/videos/ai-football-robot/7988.mp4#t=38" target="_blank" rel="noopener">00:38 / Goal-seeking logic ↗</a><a href="/videos/ai-football-robot/7988.mp4#t=99" target="_blank" rel="noopener">01:39 / What happened ↗</a></div><div class="project-credit"><span>Project scope</span><p>Camera-data collection, Edge Impulse training, OpenMV/MicroPython control and a team match strategy. The red robot and defensive approach are identified by the designer.</p></div><div class="download-grid"><a href={`${files}/football-robot-source.zip`} download><span>Development archive</span><strong>Controller, driver &amp; capture scripts ↗</strong><small>Original source files + archive notes / ZIP</small></a><a href={`${media}/7982.mp4`} download><span>Red-team match</span><strong>Watch the defence in context ↗</strong><small>Complete original clip, web format / MP4</small></a></div><p class="archive-note">The supplied folder does not include the imported detection module or trained model. The archive preserves the available source, rather than a complete deployable inference package.</p><a class="return-link" href="/#projects">← Return to the project circle</a></div></section>
</div>

<script>
  import { withBase } from "../lib/paths";
  import { explainFootballCommand, type FootballDetections } from "../lib/footballController";
  const lab = document.querySelector<HTMLElement>("[data-football-decisions]");
  if (lab) {
    const inputs = Array.from(lab.querySelectorAll<HTMLInputElement>("[data-detection]"));
    const update = () => {
      const seen = Object.fromEntries(inputs.map(input => [input.dataset.detection, input.checked])) as FootballDetections;
      const command = explainFootballCommand(seen);
      lab.dataset.branch = command.id;
      const text = (selector: string, value: string) => { const el = lab.querySelector(selector); if (el) el.textContent = value; };
      const pwm = (value: number | null) => value === null ? "Held" : `${value > 0 ? "+" : ""}${value}`;
      text("[data-decision-title]", command.title); text("[data-decision-detail]", command.detail);
      text("[data-left-command]", pwm(command.left)); text("[data-right-command]", pwm(command.right));
    };
    inputs.forEach(input => { input.disabled = false; input.addEventListener("change", update); });
    update();
  }
  const gallery = document.querySelector<HTMLElement>("[data-football-gallery]");
  if (gallery) {
    const video = gallery.querySelector("video");
    const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-clip-id]"));
    if (video) buttons.forEach(button => {
      button.disabled = false;
      button.addEventListener("click", () => {
        if (button.getAttribute("aria-pressed") === "true") return;
        video.pause();
        buttons.forEach(item => item.setAttribute("aria-pressed", String(item === button)));
        video.poster = withBase(`/images/projects/ai-football-robot/${button.dataset.clipId}.webp`);
        video.src = withBase(`/videos/ai-football-robot/${button.dataset.clipId}.mp4`);
        const caption = gallery.querySelector("[data-clip-caption]");
        if (caption) caption.textContent = button.dataset.clipDescription ?? "";
        video.load();
      });
    });
  }
</script>

<style>
  @media(prefers-reduced-motion:reduce){:global(html:has(.football-case)){scroll-behavior:auto}}
  .football-case{--fb-ink:#24392f;--fb-muted:#637267;--fb-paper:#eeeee4;--fb-red:#ad3e31;--fb-line:#c8cec0;background:var(--fb-paper);color:var(--fb-ink)}
  .fb-wrap{width:min(1280px,calc(100% - 100px));margin-inline:auto}
  .football-case :is(h1,h2,h3,p,figure,dl,dd){margin:0}.football-case :is(h1,h2,h3){font-family:"Space Grotesk",sans-serif;font-weight:500;letter-spacing:-.055em}.football-case p{line-height:1.7}.football-case a{color:inherit;text-underline-offset:5px}.football-case img{display:block;max-width:100%}.football-case button{font:inherit;cursor:pointer}.football-case :is(a,button,input):focus-visible{outline:3px solid #d6774c;outline-offset:5px}.football-case section[id]{scroll-margin-top:110px}
  .fb-eyebrow{font-family:ui-monospace,SFMono-Regular,monospace;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--fb-red)}
  .back-link{display:inline-flex;align-items:center;min-height:44px;color:var(--fb-muted)!important;font-size:.8rem;text-decoration:none}.fb-hero{padding-top:23px}.hero-top{display:flex;justify-content:space-between;gap:20px;align-items:center;margin-top:32px}.team-marker{font-size:.7rem;text-transform:uppercase;letter-spacing:.09em}.team-marker i{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--fb-red);margin-right:9px}
  .fb-hero h1{font-size:clamp(4.3rem,11.9vw,11.5rem);line-height:1.02;letter-spacing:-.075em;margin:16px 0 28px}.fb-hero h1>span{color:var(--fb-red)}.hero-intro{display:grid;grid-template-columns:1fr 1fr;gap:85px;border-top:1px solid var(--fb-line);padding:25px 0 35px}.hero-statement{font-family:"Space Grotesk",sans-serif;font-size:1.9rem;line-height:1.15!important;letter-spacing:-.04em}.hero-intro>p:last-child{font-size:.95rem;color:var(--fb-muted);max-width:580px}
  .tactics-hero{display:grid;grid-template-columns:1.8fr 1fr;gap:22px}.tactics-board{background:#253f33;color:#eeefdb;display:flex;flex-direction:column;justify-content:space-between;padding:24px 28px}.board-heading{display:flex;justify-content:space-between;gap:20px;font-family:ui-monospace,monospace;font-size:.61rem;text-transform:uppercase;letter-spacing:.08em;color:#c0cbb3}.pitch{width:100%;height:auto;display:block;margin:15px 0}.board-footer{display:flex;justify-content:space-between;gap:25px;align-items:end}.board-footer p{font-size:.8rem;color:#c1cdb5}.board-footer strong{color:#f4eedb;font-weight:500}.board-footer>span{font-size:.61rem;color:#bcc8b1;text-align:right;line-height:1.6}
  .red-robot{background:#dedfd4;padding:20px;display:flex;flex-direction:column;justify-content:center}.red-robot img{width:100%;aspect-ratio:4/3;object-fit:cover}.red-robot figcaption{padding:23px 4px 5px}.red-robot figcaption>span{font-family:"Space Grotesk",sans-serif;font-size:1.45rem;letter-spacing:-.03em}.red-robot figcaption p{font-size:.75rem;color:var(--fb-muted);margin-top:10px}.red-robot a{display:inline-flex;min-height:44px;align-items:center;font-size:.75rem;margin-top:10px;text-decoration:none}.hero-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;padding:28px 0 30px}.hero-facts span{display:block;font-size:.61rem;color:var(--fb-muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:9px}.hero-facts strong{font-size:.77rem;font-weight:500;line-height:1.6;display:block}
