---
import geometry from '../data/faust-f2-geometry.json';
---
<div class="layout-diagram">
  <header><div><span>F2 / GEOMETRY COMPARISON</span><h3>Eight layouts. One clear view.</h3></div><p>Front view · Common scale</p></header>
  <div class="layout-legend"><span><i class="window-key"></i>Window</span><span><i class="source-key"></i>Projected LED centres</span><span>Ø14 mm camera hole · 2 mm wall</span></div>
  <div class="layout-grid">
    {geometry.cases.map(layout => <article class:list={['layout-card', { 'basis': layout.case === 'W45_N12_G10' }]}>
      <h4>{layout.case}</h4>
      <svg viewBox="-30 -30 60 60" role="img" aria-label={`${layout.window_od_mm} mm window, ${layout.count} projected LED centres, ${layout.gap_mm} mm gap`}>
        <circle r={layout.window_od_mm / 2} class="window"/>
        <circle r={layout.hole_diameter_mm / 2} class="hole"/>
        {Array.from({length: layout.count}, (_, i) => {
          const angle = 2 * Math.PI * i / layout.count;
          return <circle cx={layout.radius_mm * Math.cos(angle)} cy={layout.radius_mm * Math.sin(angle)} r="0.85" class="source"/>;
        })}
      </svg>
      <p><strong>Ø{layout.window_od_mm} mm</strong><span>{layout.count} LEDs · {layout.gap_mm} mm gap</span></p>
      {layout.case === 'W45_N12_G10' && <span class="basis-tag">MODEL LAB BASIS</span>}
    </article>)}
  </div>
  <p class="layout-note">Dots show emitters behind the window. The 8 / 10 mm gap is depth, so it does not change the front view. Dimensions are study assumptions.</p>
</div>
<style>
  .layout-diagram{padding:28px;color:#e1ece5;background:#111b17}
  header{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}
  header span{font:9px/1.5 ui-monospace,monospace;letter-spacing:.08em;color:#a9d2c4}
  header h3{font-size:26px;font-weight:450;letter-spacing:-.03em;margin:8px 0 0}
  header p{font:10px/1.6 ui-monospace,monospace;color:#b5c9bd;margin:0}
  .layout-legend{display:flex;flex-wrap:wrap;gap:12px 24px;font-size:11px;line-height:1.6;color:#b5c9bd;margin-bottom:22px}
  .layout-legend span{display:flex;align-items:center;gap:8px}
  .layout-legend i{display:inline-block;width:9px;height:9px;border-radius:50%}
  .window-key{background:#a1c7b5}.source-key{background:#e4ad75}
  .layout-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .layout-card{border:1px solid #34463c;border-radius:3px;padding:18px 14px 38px;position:relative;background:#15231b}
  .layout-card.basis{border-color:#a9d2c4;background:#1b2e24}
  .layout-card h4{font:11px/1.5 ui-monospace,monospace;margin:0;text-align:center;color:#d2e3d8}
  svg{display:block;width:100%;height:auto;max-width:190px;margin:15px auto}
  .window{fill:#547e6880;stroke:#a1c7b5;stroke-width:.45}.hole{fill:#111b17;stroke:#a1c7b5;stroke-width:.4}.source{fill:#f1b779}
  .layout-card p{margin:0;text-align:center;font-size:12px;line-height:1.7}
  .layout-card strong{display:block;font-weight:500}.layout-card p span{color:#bdd0c3;font-size:11px}
  .basis-tag{position:absolute;bottom:12px;left:0;right:0;text-align:center;font:8px/1.5 ui-monospace,monospace;letter-spacing:.08em;color:#bce3cb}
  .layout-note{font-size:11px;line-height:1.8;color:#b5c9bd;margin:18px 0 0;max-width:800px}
  @media(max-width:850px){.layout-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:700px){.layout-diagram{padding:18px 14px}header{display:block}header h3{font-size:23px}header p{margin-top:10px}.layout-legend{font-size:10px;gap:8px 15px}.layout-card{padding:14px 8px 34px}.layout-card h4{font-size:10px}.layout-grid{gap:8px}svg{margin:12px auto}.layout-card p span{font-size:10px}}
</style>
