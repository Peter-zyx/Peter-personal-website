---
import {presentation} from '../lib/projectPresentation';
const {slug}=Astro.props;
const item=presentation[slug];
---
{item && <aside class="case-decision" aria-label="Key project decision"><div class="decision-heading"><span>THE DESIGN DECISION</span><h2>{item.focus}</h2></div><div class="decision-context"><p>{item.reason}</p><a href={`#${item.anchor}`}>{item.action} <span aria-hidden="true">↗</span></a></div></aside>}
{item?.chapters && <nav class="case-chapters" aria-label="Case study chapters">{item.chapters.map(([label,id],i)=><a href={`#${id}`}><span>0{i+1}</span>{label}</a>)}</nav>}
<style>
.case-decision{width:min(1200px,calc(100% - 64px));margin:38px auto 0;padding:30px 0 32px;border-block:1px solid currentColor;display:grid;grid-template-columns:1fr 1fr;gap:64px;color:inherit}.decision-heading>span{font:600 10px/1.5 ui-monospace,monospace;opacity:.65}.decision-heading h2{font:400 clamp(24px,2.4vw,34px)/1.18 Georgia,serif!important;max-width:510px;margin:14px 0 0!important;color:inherit!important;text-wrap:balance}.decision-context p{font:400 13px/1.8 Arial,sans-serif!important;margin:0 0 13px!important;max-width:540px;opacity:.8;text-wrap:pretty}.decision-context a{font:600 11px/1.6 Arial,sans-serif;text-decoration:none;color:inherit;display:inline-flex;align-items:center;min-height:44px;gap:15px}.decision-context a:hover{text-decoration:underline;text-underline-offset:5px}.case-chapters{display:flex;gap:30px;flex-wrap:wrap;width:min(1200px,calc(100% - 64px));margin:0 auto;padding:20px 0;border-bottom:1px solid #ffffff30}.case-chapters a{display:flex;align-items:center;gap:12px;color:inherit;font:400 11px/1.5 Arial,sans-serif;min-height:44px;text-decoration:none}.case-chapters span{opacity:.5;font-variant-numeric:tabular-nums}.case-decision a:focus-visible,.case-chapters a:focus-visible{outline:2px solid currentColor;outline-offset:4px}@media(max-width:700px){.case-decision{width:calc(100% - 40px);grid-template-columns:1fr;gap:20px;margin-top:24px;padding-block:25px}.decision-heading h2{font-size:27px!important}.case-chapters{width:calc(100% - 40px);display:grid;grid-template-columns:1fr 1fr;gap:5px 20px}.case-chapters a{font-size:10px;gap:8px}}
</style>
