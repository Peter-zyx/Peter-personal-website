---
import type { Project } from "../lib/projects";

type Props = {
  project: Project;
};

const { project } = Astro.props;

const suvFeatures = [
  {
    label: "01 / Overview",
    title: "The vehicle geometry",
    body: "Explore the exterior concept, from its front channel and wheel region to the rear flow-control surfaces."
  },
  {
    label: "02 / Front air-channel",
    title: "Attached upper-surface flow",
    body: "Inspired by the Ferrari SF90, the front-end channel guides incoming airflow over the hood so it stays attached along the upper surface."
  },
  {
    label: "03 / Wheel air curtain",
    title: "Reduced wheel wake losses",
    body: "Air-curtain inlets create a thin jet around the wheel surface, while the outward fender bulge guides side flow and limits local separation."
  },
  {
    label: "04 / Rear channel",
    title: "Cleaner rear-quarter flow",
    body: "A BMW i8-inspired C-pillar channel aims to organise airflow around the rear quarter and control separation."
  },
  {
    label: "05 / Underbody",
    title: "Splitter and diffuser",
    body: "The front splitter regulates underbody aerodynamics, while the rear diffuser supports pressure recovery to reduce wake strength."
  }
];

const seatFeatures = [
  {
    label: "01 / Overview",
    title: "Three-seat cabin system",
    body: "A complete economy-class row integrating a lightweight shared base, ergonomic soft goods, and modular passenger accessories."
  },
  {
    label: "02 / Primary structure",
    title: "Lightweight modular load path",
    body: "High-recycled 6061-T6 aluminium extrusions and a removable perforated thermoplastic pan reduce mass while keeping repair and material separation straightforward."
  },
  {
    label: "03 / Comfort system",
    title: "Support without excess volume",
    body: "Dual-density FR foam, breathable side zones, a sculpted cushion, and adjustable neck support improve comfort for one-to-three-hour flights."
  },
  {
    label: "04 / Passenger interface",
    title: "Accessories built as modules",
    body: "The armrest-stowed tray, cup holder, bag hook, USB-C power, and tactile controls share accessible mounting points for quick replacement."
  },
  {
    label: "05 / Circularity",
    title: "Designed to come apart",
    body: "Tool-light disassembly separates soft goods, thermoplastics, aluminium, and fasteners into defined maintenance and end-of-life streams."
  }
];

const isPlaneSeat = project.slug === "sustainable-plane-seat";
const features = isPlaneSeat ? seatFeatures : suvFeatures;
const modelPath = isPlaneSeat
  ? "/images/projects/sustainable-plane-seat/model.stl"
  : "/images/projects/suv-battery-cooling/model.stl";
const railLabels = isPlaneSeat
  ? ["Cabin System", "Circular Design", "Scroll to inspect"]
  : ["Vehicle Concept", "Thermal Flow", "Scroll to inspect"];
---

<section
  class:list={["suv-cinematic", isPlaneSeat && "suv-cinematic--seat"]}
  data-suv-viewer
  data-experience={isPlaneSeat ? "plane-seat" : "suv"}
  data-model-path={modelPath}
>
  <div class="suv-stage">
    <img class="suv-fallback" src={isPlaneSeat ? "/images/projects/sustainable-plane-seat/final-render.png" : "/images/projects/suv-battery-cooling/studio-render.png"} alt={isPlaneSeat ? "Final cabin seat concept render" : "Final SUV concept render"} />
    <canvas data-suv-canvas aria-label={isPlaneSeat ? "3D aircraft seat model viewer" : "3D SUV model viewer"}></canvas>
    <div class="suv-dot-field" aria-hidden="true"></div>
    <div class="suv-vignette" aria-hidden="true"></div>
    <div class="suv-loader" data-suv-loader>Loading 3D model</div>
    <div class="suv-hero-copy" data-suv-hero-copy>
      <a class="suv-back" href="/#projects">Back to projects</a>
      <p class="suv-kicker">{project.category} / {project.year}</p>
      <h1>{project.title}</h1>
      <p class="suv-summary">{project.summary}</p>
      <div class="suv-tags" aria-label="Project skills">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <a class="suv-skip" href="#project-evidence">Skip to the design &amp; results ↘</a>
    </div>
    <div class="suv-rail" aria-hidden="true">
      {railLabels.map((label) => <span>{label}</span>)}
    </div>
    <div class="suv-feature-card" data-suv-card>
      <span data-suv-label>{features[0].label}</span>
      <h2 data-suv-title>{features[0].title}</h2>
      <p data-suv-body>{features[0].body}</p>
    </div>
  </div>

  <div class="suv-scroll-copy" aria-hidden="true">
    {
      features.map((feature, index) => (
        <article data-suv-step data-step={index}>
          <span>{feature.label}</span>
          <h3>{feature.title}</h3>
          <p>{feature.body}</p>
        </article>
      ))
    }
  </div>
</section>
<noscript><style>.suv-cinematic{height:auto!important;min-height:0!important}.suv-stage{position:relative!important}.suv-loader,.suv-feature-card,.suv-rail{display:none!important}</style></noscript>

<script>
  import { withBase } from "../lib/paths";
  import * as THREE from "three";
  import { STLLoader } from "three/examples/jsm/loaders/STLLoader.js";

  const root = document.querySelector<HTMLElement>("[data-suv-viewer]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-suv-canvas]");
  const loaderLabel = document.querySelector<HTMLElement>("[data-suv-loader]");
  const card = document.querySelector<HTMLElement>("[data-suv-card]");
  const cardLabel = document.querySelector<HTMLElement>("[data-suv-label]");
  const cardTitle = document.querySelector<HTMLElement>("[data-suv-title]");
  const cardBody = document.querySelector<HTMLElement>("[data-suv-body]");
  const heroCopy = document.querySelector<HTMLElement>("[data-suv-hero-copy]");
  const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-suv-step]"));
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  const suvFeatureData = [
    {
      label: "01 / Overview",
      title: "The vehicle geometry",
      body: "Explore the exterior concept, from its front channel and wheel region to the rear flow-control surfaces.",
      rotation: { x: -0.05, y: -0.78, z: 0.02 },
      camera: { x: 0.36, y: 1.42, z: 5.9 },
      target: { x: 0, y: 0.18, z: 0 }
    },
    {
      label: "02 / Front air-channel",
      title: "Attached upper-surface flow",
      body: "Inspired by the Ferrari SF90, the front-end channel guides incoming airflow over the hood so it stays attached along the upper surface.",
      rotation: { x: -0.08, y: -1.2, z: 0.01 },
      camera: { x: -0.58, y: 1.22, z: 4.25 },
      target: { x: -0.15, y: 0.18, z: -0.95 }
    },
    {
      label: "03 / Wheel air curtain",
      title: "Reduced wheel wake losses",
      body: "Air-curtain inlets create a thin jet around the wheel surface, while the outward fender bulge guides side flow and limits local separation.",
      rotation: { x: -0.02, y: -0.02, z: 0 },
      camera: { x: 0.14, y: 1.34, z: 4.75 },
      target: { x: 0.15, y: 0.16, z: -0.2 }
    },
    {
      label: "04 / Rear channel",
      title: "Cleaner rear-quarter flow",
      body: "A BMW i8-inspired C-pillar channel aims to organise airflow around the rear quarter and control separation.",
      rotation: { x: -0.03, y: 0.64, z: -0.02 },
      camera: { x: 0.42, y: 1.22, z: 4.55 },
      target: { x: 0.04, y: 0.08, z: 1.08 }
    },
    {
      label: "05 / Underbody",
      title: "Splitter and diffuser",
      body: "The front splitter regulates underbody aerodynamics, while the rear diffuser supports pressure recovery to reduce wake strength.",
      rotation: { x: 0.42, y: 0.72, z: -0.03 },
      camera: { x: 0.34, y: 0.78, z: 4.05 },
      target: { x: 0, y: -0.22, z: 0.18 }
    }
  ];

  const seatFeatureData = [
    {
      label: "01 / Overview",
      title: "Three-seat cabin system",
      body: "A complete economy-class row integrating a lightweight shared base, ergonomic soft goods, and modular passenger accessories.",
      rotation: { x: -0.08, y: -0.72, z: 0.01 },
      camera: { x: 0.3, y: 1.18, z: 6.2 },
      target: { x: 0, y: 0.1, z: 0 }
    },
    {
      label: "02 / Primary structure",
      title: "Lightweight modular load path",
      body: "High-recycled 6061-T6 aluminium extrusions and a removable perforated thermoplastic pan reduce mass while keeping repair and material separation straightforward.",
      rotation: { x: 0.22, y: -0.56, z: -0.02 },
      camera: { x: -0.36, y: 0.76, z: 4.55 },
      target: { x: 0, y: -0.42, z: 0.06 }
    },
    {
      label: "03 / Comfort system",
      title: "Support without excess volume",
      body: "Dual-density FR foam, breathable side zones, a sculpted cushion, and adjustable neck support improve comfort for one-to-three-hour flights.",
      rotation: { x: -0.05, y: -0.04, z: 0 },
      camera: { x: 0.16, y: 1.38, z: 4.65 },
      target: { x: 0, y: 0.38, z: 0 }
    },
    {
      label: "04 / Passenger interface",
      title: "Accessories built as modules",
      body: "The armrest-stowed tray, cup holder, bag hook, USB-C power, and tactile controls share accessible mounting points for quick replacement.",
      rotation: { x: -0.03, y: 0.7, z: 0.02 },
      camera: { x: 0.38, y: 1.18, z: 4.35 },
      target: { x: 0.28, y: 0.18, z: 0.18 }
    },
    {
      label: "05 / Circularity",
      title: "Designed to come apart",
      body: "Tool-light disassembly separates soft goods, thermoplastics, aluminium, and fasteners into defined maintenance and end-of-life streams.",
      rotation: { x: 0.42, y: 0.76, z: -0.04 },
      camera: { x: 0.22, y: 0.82, z: 4.18 },
      target: { x: 0, y: -0.22, z: 0.08 }
    }
  ];

  const isPlaneSeatExperience = root?.dataset.experience === "plane-seat";
  const featureData = isPlaneSeatExperience ? seatFeatureData : suvFeatureData;

  if (root && canvas) {
    const viewerRoot = root;
    const viewerCanvas = canvas;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.01, 100);
    const renderer = new THREE.WebGLRenderer({
      canvas: viewerCanvas,
      antialias: true,
      alpha: true,
      powerPreference: "high-performance"
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    const group = new THREE.Group();
    scene.add(group);

    const material = new THREE.MeshPhysicalMaterial({
      color: isPlaneSeatExperience ? 0xa9aaa3 : 0x939a97,
      roughness: isPlaneSeatExperience ? 0.42 : 0.28,
      metalness: isPlaneSeatExperience ? 0.58 : 0.86,
      clearcoat: isPlaneSeatExperience ? 0.54 : 0.82,
      clearcoatRoughness: isPlaneSeatExperience ? 0.24 : 0.16,
      reflectivity: 0.72,
      envMapIntensity: 1.15
    });

    const shadowMaterial = new THREE.ShadowMaterial({
      color: 0x000000,
      opacity: 0.26
    });

    const hemi = new THREE.HemisphereLight(0xf7fbff, 0x111514, 1.28);
    scene.add(hemi);

    const key = new THREE.DirectionalLight(0xffffff, 3.8);
    key.position.set(-5, 6.5, 5);
    scene.add(key);

    const rim = new THREE.DirectionalLight(0x98f2f4, 2.25);
    rim.position.set(4.8, 3.2, -4.2);
    scene.add(rim);

    const fill = new THREE.PointLight(0xb79a7c, 24, 12);
    fill.position.set(0, 2.4, 3.6);
    scene.add(fill);

    const stripLight = new THREE.PointLight(0xeef8f4, 42, 7);
    stripLight.position.set(-2.6, 1.05, -2.6);
    scene.add(stripLight);

    const floor = new THREE.Mesh(new THREE.CircleGeometry(4.9, 96), shadowMaterial);
    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -1.06;
    floor.position.z = 0.08;
    scene.add(floor);

    let model: THREE.Mesh | undefined;
    let progress = 0;
    let smoothProgress = 0;
    let activeIndex = 0;
    const target = new THREE.Vector3();
    const currentTarget = new THREE.Vector3();
    const cameraTarget = new THREE.Vector3();
    const rotationTarget = new THREE.Euler();

    function resize() {
      const rect = viewerCanvas.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height, false);
      camera.aspect = rect.width / Math.max(rect.height, 1);
      camera.updateProjectionMatrix();
    }

    function mix(a: number, b: number, t: number) {
      return a + (b - a) * t;
    }

    function getPose(scrollValue: number) {
      const scaled = scrollValue * (featureData.length - 1);
      const index = Math.min(Math.floor(scaled), featureData.length - 2);
      const local = Math.min(Math.max(scaled - index, 0), 1);
      const eased = local * local * (3 - 2 * local);
      const a = featureData[index];
      const b = featureData[index + 1];
      const nearestIndex = Math.min(Math.max(Math.round(scaled), 0), featureData.length - 1);
      return {
        index: nearestIndex,
        rotation: {
          x: mix(a.rotation.x, b.rotation.x, eased),
          y: mix(a.rotation.y, b.rotation.y, eased),
          z: mix(a.rotation.z, b.rotation.z, eased)
        },
        camera: {
          x: mix(a.camera.x, b.camera.x, eased),
          y: mix(a.camera.y, b.camera.y, eased),
          z: mix(a.camera.z, b.camera.z, eased)
        },
        target: {
          x: mix(a.target.x, b.target.x, eased),
          y: mix(a.target.y, b.target.y, eased),
          z: mix(a.target.z, b.target.z, eased)
        }
      };
    }

    function setActiveStep(index: number) {
      const clamped = Math.min(Math.max(index, 0), featureData.length - 1);
      if (clamped === activeIndex) return;
      activeIndex = clamped;
      const data = featureData[clamped];
      if (card) card.classList.remove("is-changing");
      requestAnimationFrame(() => card?.classList.add("is-changing"));
      if (cardLabel) cardLabel.textContent = data.label;
      if (cardTitle) cardTitle.textContent = data.title;
      if (cardBody) cardBody.textContent = data.body;
      steps.forEach((step, stepIndex) => step.classList.toggle("is-active", stepIndex === clamped));
    }

    function updateScrollProgress() {
      const rect = viewerRoot.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      progress = Math.min(Math.max(-rect.top / Math.max(travel, 1), 0), 1);
    }

    let frameId = 0;
    let viewerVisible = true;
    const resumeViewer = () => { if (viewerVisible && !document.hidden && !frameId) frameId = requestAnimationFrame(animate); };
    // The sticky header covers the top 82 px. A model hidden behind it need not render.
    new IntersectionObserver(entries => {
      viewerVisible = entries[0].isIntersecting && entries[0].intersectionRatio > 0;
      resumeViewer();
    }, { rootMargin: "-83px 0px 0px 0px" }).observe(viewerRoot);
    document.addEventListener("visibilitychange", resumeViewer);
    function animate() {
      frameId = 0;
      if (!viewerVisible || document.hidden) return;
      smoothProgress += (progress - smoothProgress) * (prefersReducedMotion.matches ? 1 : 0.075);
      const pose = getPose(smoothProgress);
      const heroFade = Math.min(Math.max((smoothProgress - 0.04) / 0.18, 0), 1);

      if (heroCopy) {
        heroCopy.style.opacity = `${1 - heroFade}`;
        heroCopy.style.transform = `translate3d(0, ${heroFade * -28}px, 0)`;
      }
      if (card) {
        card.style.opacity = `${0.74 + Math.min(Math.max(smoothProgress / 0.18, 0), 1) * 0.26}`;
      }
      rotationTarget.set(pose.rotation.x, pose.rotation.y, pose.rotation.z);
      group.rotation.x += (rotationTarget.x - group.rotation.x) * 0.075;
      group.rotation.y += (rotationTarget.y - group.rotation.y) * 0.075;
      group.rotation.z += (rotationTarget.z - group.rotation.z) * 0.075;

      const mobileDistance = isPlaneSeatExperience && window.innerWidth < 900 ? 1.22 : 1;
      cameraTarget.set(pose.camera.x, pose.camera.y, pose.camera.z * mobileDistance);
      camera.position.lerp(cameraTarget, 0.075);
      target.set(pose.target.x, pose.target.y, pose.target.z);
      currentTarget.lerp(target, 0.075);
      camera.lookAt(currentTarget);

      if (model) {
        model.rotation.y += prefersReducedMotion.matches ? 0 : 0.0018;
      }

      setActiveStep(pose.index);
      renderer.render(scene, camera);
      frameId = requestAnimationFrame(animate);
    }

    new STLLoader().load(
      viewerRoot.dataset.modelPath ?? withBase("/images/projects/suv-battery-cooling/model.stl"),
      (geometry: THREE.BufferGeometry) => {
        geometry.rotateX(-Math.PI / 2);
        geometry.computeVertexNormals();
        geometry.center();
        geometry.computeBoundingBox();
        const box = geometry.boundingBox ?? new THREE.Box3();
        const size = new THREE.Vector3();
        box.getSize(size);
        const scale = (isPlaneSeatExperience ? 4.45 : 3.85) / Math.max(size.x, size.y, size.z);
        geometry.scale(scale, scale, scale);
        model = new THREE.Mesh(geometry, material);
        model.position.y = isPlaneSeatExperience ? -0.06 : -0.16;
        group.add(model);
        viewerRoot.dataset.modelReady = "true";
        loaderLabel?.classList.add("is-hidden");
      },
      undefined,
      () => {
        if (loaderLabel) loaderLabel.textContent = "Showing the final render. Explore the design and results below.";
      }
    );

    resize();
    updateScrollProgress();
    setActiveStep(0);
    camera.position.set(
      isPlaneSeatExperience ? 0.3 : 0.36,
      isPlaneSeatExperience ? 1.18 : 1.42,
      isPlaneSeatExperience ? 6.2 : 5.9
    );
    camera.lookAt(0, 0.2, 0);
    renderer.render(scene, camera);
    animate();

    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("scroll", updateScrollProgress, { passive: true });
  }
</script>

<style>
  .suv-cinematic {
    position: relative;
    height: 430vh;
    min-height: 2600px;
    margin-top: 0;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 53% 24%, rgba(112, 201, 209, 0.14), transparent 32rem),
      radial-gradient(circle at 78% 54%, rgba(183, 154, 124, 0.1), transparent 28rem),
      radial-gradient(circle at 20% 76%, rgba(196, 212, 207, 0.07), transparent 24rem),
      #030403;
  }

  .suv-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 760px;
    overflow: hidden;
  }

  .suv-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .suv-dot-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.34;
    background-image:
      radial-gradient(circle, rgba(196, 212, 207, 0.36) 0 1px, transparent 1.8px),
      radial-gradient(circle, rgba(112, 201, 209, 0.34) 0 1px, transparent 1.8px);
    background-position:
      calc(50% - 30rem) 42%,
      calc(50% + 31rem) 52%;
    background-size:
      9px 9px,
      10px 10px;
    mask-image:
      radial-gradient(ellipse 28rem 9rem at 14% 58%, black 0 32%, transparent 72%),
      radial-gradient(ellipse 30rem 9rem at 86% 55%, black 0 35%, transparent 74%);
  }

  .suv-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 56% 48%, transparent 0 32%, rgba(3, 3, 3, 0.3) 72%),
      linear-gradient(90deg, rgba(3, 3, 3, 0.9), transparent 32%, transparent 68%, rgba(3, 3, 3, 0.8)),
      linear-gradient(180deg, rgba(3, 3, 3, 0.68), transparent 20%, transparent 78%, rgba(3, 3, 3, 0.78));
  }

  .suv-cinematic--seat .suv-vignette {
    background:
      radial-gradient(circle at 60% 48%, transparent 0 28%, rgba(3, 3, 3, 0.32) 72%),
      linear-gradient(90deg, rgba(3, 3, 3, 0.96), rgba(3, 3, 3, 0.7) 27%, transparent 58%, rgba(3, 3, 3, 0.7)),
      linear-gradient(180deg, rgba(3, 3, 3, 0.66), transparent 20%, transparent 76%, rgba(3, 3, 3, 0.82));
  }

  .suv-loader {
    position: absolute;
    top: 50%;
    left: 50%;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.42);
    color: var(--muted);
    font-size: 0.78rem;
    transform: translate(-50%, -50%);
    transition: opacity 220ms ease;
  }

  .suv-loader.is-hidden {
    opacity: 0;
  }

  .suv-hero-copy {
    position: absolute;
    top: clamp(92px, 13vh, 150px);
    left: clamp(20px, 5vw, 76px);
    z-index: 2;
    width: min(640px, 45vw);
    transition:
      opacity 180ms linear,
      transform 180ms linear;
    will-change: opacity, transform;
  }

  .suv-back {
    display: inline-flex;
    margin-bottom: clamp(32px, 6vh, 68px);
    color: rgba(246, 248, 243, 0.72);
    font-size: 0.9rem;
    text-decoration-color: rgba(196, 212, 207, 0.4);
    text-underline-offset: 5px;
  }

  .suv-kicker {
    margin: 0 0 12px;
    color: var(--metal);
    font-size: 0.72rem;
    font-weight: 780;
    text-transform: uppercase;
  }

  .suv-hero-copy h1 {
    max-width: 9.8em;
    margin: 0;
    color: var(--text);
    font-size: clamp(3.2rem, 6.4vw, 6.9rem);
    font-weight: 780;
    line-height: 0.88;
  }

  .suv-summary {
    max-width: 560px;
    margin: 24px 0 0;
    color: rgba(246, 248, 243, 0.68);
    font-size: clamp(1rem, 1.35vw, 1.28rem);
    line-height: 1.58;
  }

  .suv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 640px;
    margin-top: 24px;
  }

  .suv-tags span {
    padding: 7px 10px;
    border: 1px solid rgba(196, 212, 207, 0.18);
    border-radius: 999px;
    background: rgba(3, 4, 3, 0.3);
    color: rgba(246, 248, 243, 0.66);
    font-size: 0.78rem;
    backdrop-filter: blur(14px);
  }

  .suv-rail {
    position: absolute;
    right: clamp(18px, 4vw, 64px);
    top: clamp(96px, 13vh, 150px);
    z-index: 2;
    display: grid;
    gap: 12px;
    justify-items: end;
    color: rgba(246, 248, 243, 0.52);
    font-size: 0.72rem;
    font-weight: 760;
    text-transform: uppercase;
  }

  .suv-rail span {
    padding: 7px 10px;
    border: 1px solid rgba(196, 212, 207, 0.12);
    border-radius: 999px;
    background: rgba(5, 6, 5, 0.34);
    backdrop-filter: blur(12px);
  }

  .suv-feature-card {
    position: absolute;
    right: clamp(18px, 6vw, 96px);
    bottom: clamp(28px, 8vh, 86px);
    z-index: 2;
    width: min(420px, 34vw);
    padding: 22px;
    border: 1px solid rgba(246, 248, 243, 0.14);
    border-radius: 8px;
    background: rgba(6, 7, 6, 0.66);
