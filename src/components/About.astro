---
import { getProject } from "../lib/projects";
import { withBase } from "../lib/paths";

const capabilities = [
  { name: "Make", detail: "CAD · prototyping · electronics", slug: "pet-cleaning-tool", work: "Dooti", note: "Product & hardware" },
  { name: "Compute", detail: "Python · MATLAB · embedded systems · machine learning", slug: "dancing-segway", work: "Dancing Segway", note: "Code & control" },
  { name: "Design", detail: "Product design · interaction · Figma · systems thinking", slug: "smart-medication-monitor", work: "Smart Medication", note: "Sensing & interaction" },
  { name: "Validate", detail: "CFD · simulation · testing · physical experimentation", slug: "suv-battery-cooling", work: "SUV & Battery Cooling", note: "Analysis & experiment" },
].map((capability) => {
  const project = getProject(capability.slug);
  if (!project) throw new Error(`Missing About project: ${capability.slug}`);
  return { ...capability, href: withBase(`/projects/${project.slug}/`) };
});
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about-heading meta">
      <p>About</p>
      <p>Code / Hardware / Interaction</p>
    </div>

    <div class="about-grid">
      <h2 id="about-title" class="section-title">
        <span class="headline-line" style="--reveal-order: 0">A design engineer</span>{" "}
        <span class="headline-line" style="--reveal-order: 1">moving between</span>{" "}
        <span class="headline-line" style="--reveal-order: 2">digital intelligence</span>{" "}
        <span class="headline-line" style="--reveal-order: 3">and <em>physical systems.</em></span>
      </h2>

      <div class="identity">
        <div class="identity-details">
          <p class="identity-name">Yuxuan Zhou</p>
          <p>Design Engineering<br />Imperial College London</p>
          <p class="location meta">London / Shanghai</p>
        </div>
        <p class="identity-intro">I design across code, hardware and interaction — building intelligent products, physical systems and prototypes.</p>
        <div class="currently">
          <h3 class="meta">Currently</h3>
          <p>Looking for <strong>2027 placement and internship opportunities</strong> in product, hardware, AI and design engineering.</p>
        </div>
        <a class="work-fragment" href={capabilities[0].href}>
          <img src={withBase("/images/projects/pet-cleaning-tool/dooti-exploded.webp")} alt="Exploded CAD view of the Dooti prototype, showing the housing, electronics and roller assembly" width="773" height="787" loading="lazy" decoding="async" />
          <span><span class="meta">From the work</span><span class="fragment-title">Dooti <span aria-hidden="true">↗</span></span><span class="fragment-caption">CAD, electronics, assembly.<br />A team-built prototype.</span></span>
        </a>
      </div>
    </div>

    <div class="capabilities" aria-labelledby="capabilities-title">
      <div class="capabilities-heading meta">
        <h3 id="capabilities-title">Across the process</h3>
        <span>Selected work</span>
      </div>
      <ol class="capability-list">
        {capabilities.map((capability, index) => (
          <li>
            <a class="capability" href={capability.href}>
              <span class="capability-number meta" aria-hidden="true">0{index + 1}</span>
              <h4>{capability.name}</h4>
              <p class="capability-detail">{capability.detail}</p>
              <span class="capability-work"><span class="meta">{capability.note}</span><span>{capability.work}</span></span>
              <span class="capability-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <p class="languages"><span class="meta">Languages</span><span>English · Mandarin · Spanish B1</span></p>
  </div>
</section>

<script>
  const about = document.querySelector<HTMLElement>(".about");
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (about && !motion.matches && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        about.classList.add("has-entered");
        observer.disconnect();
      }
    }, { threshold: 0.08 });
    observer.observe(about);
  }
</script>

<style>
  .about {
    padding: 108px 0 100px;
    scroll-margin-top: 90px;
    background: var(--bg);
  }

  .meta {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.66rem;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-heading, .capabilities-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }

  .about-heading { margin-bottom: 42px; }
  .about-heading p, .identity p, .currently h3, .capabilities h3, .capability p, .capability h4 { margin: 0; }
  .about-heading p:first-child { color: var(--text); }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: start;
  }

  .section-title {
    font-size: 4.8rem;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .headline-line { display: block; }
  .headline-line em { color: var(--accent-cool); font-style: normal; }
  .identity { padding-top: 6px; }
  .identity-details { font-size: 0.94rem; line-height: 1.55; }
  .identity .identity-name { margin-bottom: 9px; font-size: 0.85rem; font-weight: 650; letter-spacing: 0.09em; text-transform: uppercase; }
  .identity .location { margin-top: 17px; }
  .identity .identity-intro { margin-top: 28px; color: var(--muted); font-size: 1rem; line-height: 1.65; max-width: 40ch; }

  .currently { margin-top: 30px; padding-left: 16px; border-left: 1px solid var(--accent-cool); }
  .currently h3 { color: var(--accent-cool); }
  .currently p { margin-top: 9px; font-size: 0.88rem; line-height: 1.6; color: var(--muted); max-width: 43ch; }
  .currently strong { color: var(--text); font-weight: 400; }

  .work-fragment { display: flex; align-items: center; gap: 20px; margin-top: 30px; width: fit-content; text-decoration: none; }
  .work-fragment img { width: 92px; height: 100px; object-fit: contain; filter: grayscale(1) invert(1); mix-blend-mode: screen; opacity: 0.7; }
  .work-fragment > span { display: grid; gap: 5px; }
  .fragment-title { font-size: 0.88rem; }
  .fragment-title span { margin-left: 8px; color: var(--muted); }
  .fragment-caption { color: var(--muted); font-size: 0.73rem; line-height: 1.5; }
  .work-fragment:hover .fragment-title, .work-fragment:focus-visible .fragment-title { color: var(--accent-cool); }
  .work-fragment:focus-visible, .capability:focus-visible { outline: 1px solid var(--accent-cool); outline-offset: 6px; }

  .capabilities { margin-top: 76px; }
  .capabilities-heading { padding-bottom: 18px; }
  .capabilities-heading h3 { font: inherit; }
  .capabilities-heading > span { width: 234px; }
  .capability-list { list-style: none; padding: 0; margin: 0; }
  .capability-list li { border-top: 1px solid var(--line); }
  .capability-list li:last-child { border-bottom: 1px solid var(--line); }
  .capability {
    display: grid;
    grid-template-columns: 36px minmax(140px, 0.55fr) minmax(0, 1.5fr) 196px 18px;
    align-items: center;
    gap: 20px;
    min-height: 106px;
    padding: 22px 0;
    text-decoration: none;
  }
  .capability h4 { font-size: 1.7rem; font-weight: 500; letter-spacing: -0.025em; text-transform: uppercase; }
  .capability-detail { color: var(--muted); font-size: 0.88rem; line-height: 1.7; max-width: 44ch; }
  .capability-work { display: grid; gap: 6px; font-size: 0.8rem; line-height: 1.5; color: var(--muted); }
  .capability-work .meta { font-size: 0.59rem; letter-spacing: 0.06em; }
  .capability-arrow { color: var(--muted); }
  .capability:hover h4, .capability:focus-visible h4 { color: var(--accent-cool); }
  .capability:hover .capability-work, .capability:focus-visible .capability-work { color: var(--text); }
  .languages { display: flex; flex-wrap: wrap; gap: 16px 30px; align-items: baseline; margin: 25px 0 0; color: var(--muted); font-size: 0.77rem; line-height: 1.6; }

  @media (max-width: 1100px) {
    .about-grid { grid-template-columns: 1fr; gap: 42px; }
    .identity { display: grid; grid-template-columns: 1fr 1fr; gap: 30px 48px; }
    .identity .identity-intro, .currently, .work-fragment { margin-top: 0; }
    .capabilities { margin-top: 64px; }
    .capability { grid-template-columns: 28px 145px minmax(0, 1fr) 170px 16px; gap: 16px; }
    .capabilities-heading > span { width: 202px; }
  }

  @media (max-width: 980px) {
    .capability { grid-template-columns: 24px 135px minmax(0, 1fr) 18px; }
    .capability-work { grid-column: 3; grid-row: 2; }
    .capability-work .meta { display: none; }
    .capability-arrow { grid-column: 4; grid-row: 1 / 3; }
    .capabilities-heading > span { width: auto; }
  }

  @media (max-width: 720px) {
    .about { padding: 68px 0 64px; }
    .about-heading { margin-bottom: 32px; }
    .about-heading p:last-child { text-align: right; max-width: 21ch; }
    .section-title { font-size: clamp(2.55rem, 7.8vw, 3.5rem); line-height: 1.08; }
    .identity { grid-template-columns: 1fr; gap: 26px; }
    .identity .identity-intro { max-width: 42ch; }
    .work-fragment { margin-top: 2px; }
    .capabilities { margin-top: 52px; }
    .capability { grid-template-columns: 22px minmax(0, 1fr) 18px; gap: 10px 14px; padding: 24px 0; }
    .capability h4 { font-size: 1.55rem; }
    .capability-detail { grid-column: 2; grid-row: 2; font-size: 0.83rem; }
    .capability-work { grid-column: 2; grid-row: 3; font-size: 0.75rem; }
    .capability-arrow { grid-column: 3; grid-row: 1; }
    .capability-number { align-self: center; }
    .languages { gap: 8px 20px; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .has-entered .headline-line { animation: about-enter 850ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--reveal-order) * 110ms); }
    .has-entered .identity-details { animation: about-enter 900ms 180ms both; }
    .capability h4, .capability-work, .capability-arrow { transition: color 260ms ease, transform 360ms ease; }
    .capability:hover h4, .capability:focus-visible h4 { transform: translateX(4px); }
    .capability:hover .capability-arrow, .capability:focus-visible .capability-arrow { transform: translate(2px, -2px); }
  }

  @keyframes about-enter {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
