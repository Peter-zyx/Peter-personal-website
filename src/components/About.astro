---
import { Image } from "astro:assets";
import portrait from "../assets/yuxuan-zhou-portrait.png";
import Skills from "./Skills.astro";
import { withBase } from "../lib/paths";
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about-heading meta"><p>01 / About me</p><p>London & Shanghai</p></div>
    <div class="about-grid">
      <figure class="portrait">
        <div class="portrait-image">
          <Image src={portrait} alt="Yuxuan Zhou wearing a grey jacket and black shirt" widths={[480, 800, 1100]} sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1000px) 38vw, 440px" width={800} format="webp" quality={85} loading="lazy" decoding="async" />
          <span class="portrait-index meta" aria-hidden="true">YZ / 01</span>
        </div>
        <figcaption><span>Yuxuan Zhou <span class="nickname">/ Peter</span></span><span class="meta">Design engineer</span></figcaption>
      </figure>
      <div class="identity">
        <p class="intro-label meta">A little about me</p>
        <h2 id="about-title">Curious by nature.<br />An engineer<br /><em>by design.</em></h2>
        <p class="identity-intro">I’m Yuxuan, a Design Engineering student at Imperial College London. I connect code, hardware and interaction to turn ideas into things people can use.</p>
        <p class="identity-description">From intelligent products to physical prototypes, I enjoy moving between the digital and the tangible — designing, making and testing along the way.</p>
        <div class="identity-footer">
          <div class="currently">
            <p class="availability meta"><span aria-hidden="true"></span>Open to opportunities</p>
            <p>2027 placements & internships</p>
            <span class="opportunity-fields">Product · Hardware · AI · Design engineering</span>
          </div>
          <a class="cv-link" href={withBase("/cv/yuxuan-zhou-cv.pdf")}>View CV <span aria-hidden="true">↗</span></a>
        </div>
        <div class="languages"><span class="meta">Languages</span><p><span>English</span><span>Mandarin</span><span>Spanish <small>B1</small></span></p></div>
      </div>
    </div>
    <Skills />
  </div>
</section>

<style>
  .about { padding: 100px 0 88px; scroll-margin-top: 90px; background: var(--bg); }
  .meta { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.66rem; font-weight: 400; line-height: 1.5; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); }
  .about-heading { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 38px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .about-heading p, .identity p { margin: 0; }
  .about-heading p:first-child { color: var(--text); }
  .about-grid { display: grid; grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.4fr); gap: clamp(48px, 7vw, 112px); align-items: center; }
  .portrait { margin: 0; }
  .portrait-image { position: relative; overflow: hidden; aspect-ratio: 4 / 5; background: #bfc1c5; border-radius: 3px; }
  .portrait-image img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 44%; }
  .portrait-index { position: absolute; top: 18px; left: 18px; color: #343b3d; border: 1px solid #70777a; padding: 5px 8px; }
  figcaption { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 16px; font-size: 0.88rem; font-weight: 550; }
  .nickname { color: var(--muted); font-weight: 400; }
  .identity .intro-label { color: var(--accent-cool); margin-bottom: 22px; }
  .identity h2 { margin: 0; font-size: clamp(2.8rem, 4.65vw, 4.3rem); letter-spacing: -0.055em; font-weight: 600; line-height: 1.06; }
  .identity h2 em { color: var(--accent-cool); font-style: normal; }
  .identity .identity-intro { margin-top: 28px; font-size: clamp(1rem, 1.35vw, 1.14rem); line-height: 1.7; max-width: 48ch; }
  .identity .identity-description { margin-top: 14px; color: var(--muted); font-size: 0.95rem; line-height: 1.75; max-width: 53ch; }
  .identity-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line); }
  .availability { display: flex; gap: 8px; align-items: center; color: var(--accent-cool); }
  .availability span { width: 6px; height: 6px; background: var(--accent-cool); border-radius: 50%; }
  .currently > p:nth-child(2) { margin-top: 9px; font-size: 0.92rem; }
  .opportunity-fields { display: block; color: var(--muted); font-size: 0.75rem; margin-top: 7px; line-height: 1.6; }
  .cv-link { display: inline-flex; gap: 20px; align-items: center; padding: 12px 0; font-size: 0.85rem; text-decoration: none; border-bottom: 1px solid var(--line-strong); }
  .cv-link:hover { color: var(--accent-cool); border-color: var(--accent-cool); }
  .cv-link:focus-visible { outline: 2px solid var(--accent-cool); outline-offset: 5px; }
  .languages { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px 22px; margin-top: 22px; }
  .languages p { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 0.75rem; line-height: 1.6; }
  .languages small { color: var(--accent-cool); font-size: 0.62rem; margin-left: 3px; }
  @media (max-width: 1000px) { .about-grid { gap: 40px; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.2fr); } .identity h2 { font-size: 3rem; } .identity-footer { gap: 12px; } }
  @media (max-width: 720px) { .about { padding: 64px 0; } .about > .container { width: calc(100% - 40px); } .about-heading { margin-bottom: 28px; } .about-grid { grid-template-columns: 1fr; gap: 36px; } .portrait { width: 100%; max-width: 440px; margin-inline: auto; } .portrait-image { aspect-ratio: 5 / 6; } .identity h2 { font-size: clamp(2.7rem, 9vw, 4rem); } .identity .intro-label { margin-bottom: 16px; } .identity .identity-intro { margin-top: 22px; } }
</style>
