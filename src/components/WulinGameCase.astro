---
import type { Project } from "../lib/projects";
import skills from "../../public/demos/wulin/skills.json";
import map from "../../public/demos/wulin/map1.json";
type Props = { project: Project };
const { project } = Astro.props;
const img = "/images/projects/webapp-game";
const repo = "https://github.com/Peter-zyx/wulin-tactical-roguelike-game";
const live = "https://peter-zyx.github.io/wulin-tactical-roguelike-game/";
const captures = [
  {id:"opening", label:"Read the arena", detail:"The opening state shows health, available techniques and reachable squares. Starting positions are randomised for each new encounter."},
  {id:"qi-step", label:"Extend your reach", detail:"Qi Step adds two movement points before moving. It opens more destinations without spending the turn’s action."},
  {id:"targeting", label:"Choose a target", detail:"After moving, Sword Slash highlights an adjacent enemy. The interface makes the current action and its legal target visible."},
  {id:"strike", label:"See the consequence", detail:"The hit updates enemy health and records the skill in the battle log. End turn hands control to the five bandits."}
];
---
<div class="wulin-case">
  <header class="wl-hero"><div class="wl-wrap">
    <div class="hero-top"><a href="/#projects">← Back to the circle</a><span>{project.year} / Independent game design &amp; development</span></div>
    <div class="hero-layout"><div class="hero-copy"><p class="wl-kicker">Webapp game / A martial arts tactics prototype</p><div class="title-lockup"><h1>Wulin<span>武林</span></h1><span class="seal" aria-hidden="true">一招<br/>一式</span></div><h2>Every step<br/>sets up the next strike.</h2><p>A lone disciple. Five bandits. One small arena where movement, timing and martial arts techniques decide what happens next.</p><div class="hero-actions"><a class="wl-button primary" href={live} target="_blank" rel="noopener">Play the game <span>↗</span></a><a class="wl-button" href={repo} target="_blank" rel="noopener">Explore the code <span>↗</span></a></div><span class="hero-note">Browser-based / Turn-based / Built with vanilla JavaScript</span></div>
    <div class="hero-art" aria-label="Wulin character and arena artwork"><div class="arena-disc"><img src={`${img}/arena.webp`} width="1254" height="1254" alt="Illustrated grassy arena divided by stone walls and water"/></div><div class="art-ring" aria-hidden="true"></div><img class="hero-player" src={`${img}/player.webp`} width="256" height="256" alt="The Wandering Disciple, wearing a straw hat and carrying a sword"/><span class="art-caption">THE WANDERING DISCIPLE <i>游侠</i></span><span class="art-index" aria-hidden="true">01 / ENTER THE JIANGHU</span></div></div>
    <dl class="hero-facts"><div><dt>Arena</dt><dd>10 × 10<span>fixed terrain grid</span></dd></div><div><dt>Techniques</dt><dd>11<span>3 starting · 8 in the reward pool</span></dd></div><div><dt>Encounter</dt><dd>1 vs 5<span>randomised starting positions</span></dd></div><div><dt>My role</dt><dd>End to end<span>game design, code, interface &amp; tests</span></dd></div></dl>
  </div></header>
  <nav class="wl-nav" aria-label="Wulin project chapters"><a href="#wulin-play">01 / In play</a><a href="#wulin-position">02 / Position</a><a href="#wulin-skills">03 / Techniques</a><a href="#wulin-code">04 / Under the hood</a></nav>

  <section class="wl-wrap wl-section" id="wulin-play"><div class="section-heading"><div><p class="wl-kicker">01 / The playable prototype</p><h2>A turn is a<br/><em>small commitment.</em></h2></div><p>Move once, then attack or use a technique. Acting first closes your movement for that turn. The challenge is to read the terrain and nearby enemies before committing.</p></div>
    <div class="capture-gallery"><fieldset><legend class="sr-only">Choose a moment from the game</legend><div class="capture-tabs">{captures.map((capture,i)=><label><input type="radio" name="wulin-capture" value={capture.id} checked={i===0}/><span><small>0{i+1}</small>{capture.label}</span></label>)}</div></fieldset>{captures.map(capture=><figure class="capture-panel" data-capture={capture.id}><a href={`${img}/${capture.id}.webp`} target="_blank" rel="noopener" aria-label={`Enlarge gameplay screenshot: ${capture.label}`}><img src={`${img}/${capture.id}.webp`} width="1440" height="1120" alt={`Actual Wulin gameplay: ${capture.label.toLowerCase()}`} loading="lazy"/></a><figcaption><strong>From the running game ↗</strong><p>{capture.detail}</p></figcaption></figure>)}</div>
    <div class="turn-sequence"><article><span>01 / Read</span><h3>See your options.</h3><p>Reachable cells and target highlights turn rules into visible choices.</p></article><article><span>02 / Commit</span><h3>Position, then act.</h3><p>A move changes who you can reach—and who can reach you.</p></article><article><span>03 / Respond</span><h3>Let the bandits answer.</h3><p>Each enemy attacks if adjacent; otherwise it moves towards the player.</p></article></div>
  </section>

  <section class="position-chapter" id="wulin-position"><div class="wl-wrap wl-section"><div class="section-heading"><div><p class="wl-kicker">02 / A playable movement study</p><h2>The same wall.<br/><em>Three ways to move.</em></h2></div><p>Try a technique, then select a highlighted square. This small example uses the game’s original movement rules and terrain, with a fixed starting position so the differences are easy to compare.</p></div>
    <div class="movement-study" data-wulin-study><div class="study-board"><div class="board-meta"><span>POSITION STUDY / 10 × 10</span><span>START C4</span></div><div class="tactics-grid" aria-label="Movement study board">{map.cells.flatMap((row,y)=>row.map((cell,x)=><button type="button" disabled data-cell={`${x},${y}`} data-terrain={cell} aria-label={`Column ${String.fromCharCode(65+x)}, row ${y+1}: ${cell}`}><span class="cell-marker" aria-hidden="true"></span></button>))}</div><div class="board-legend"><span><i class="legend-possible"></i>Available destination</span><span><i class="legend-blocked"></i>Blocked terrain</span></div></div><div class="study-controls"><p class="wl-kicker">Choose your technique</p><div class="technique-options">{[['walk','01','Standard move','Up to 4 steps along an open path'],['qi','02','Qi Step','Add 2 steps before moving'],['shadow','03','Shadow Step','Dash up to 3 cells across obstacles']].map(([id,number,title,body])=><button disabled type="button" data-mode={id} aria-pressed={id==='walk'?'true':'false'}><small>{number}</small><span><strong>{title}</strong><span>{body}</span></span><i aria-hidden="true">↗</i></button>)}</div><div class="study-result" aria-live="polite" aria-atomic="true"><strong data-study-count>—</strong><span data-study-status>Loading movement rules…</span></div><button class="study-reset" type="button" disabled data-study-reset>Reset position ↺</button><p class="study-note">Shadow Step is unlocked here for comparison. In the game, it belongs to the random reward pool. A dash can cross obstacles, but must land on an empty, open square.</p><noscript><p>Enable JavaScript to try the movement study. Standard movement follows open paths; Qi Step extends its range, while Shadow Step can cross a wall.</p></noscript></div></div>
  </div></section>

  <section class="wl-wrap wl-section" id="wulin-skills"><div class="section-heading"><div><p class="wl-kicker">03 / Techniques change the decision</p><h2>Learn another way<br/><em>out of a corner.</em></h2></div><p>Three techniques establish the opening choices: strike, reposition or guard. Defeating a bandit before the final kill unlocks a random new skill, adding options as the encounter unfolds.</p></div>
    <div class="starter-skills"><article><span class="skill-glyph" aria-hidden="true">斩</span><div><span class="wl-kicker">01 / Offence</span><h3>Sword Slash</h3><p>Strike an adjacent enemy. Close the distance before committing to the attack.</p><small>Adjacent target / Uses the action</small></div></article><article><span class="skill-glyph" aria-hidden="true">步</span><div><span class="wl-kicker">02 / Movement</span><h3>Qi Step</h3><p>Extend your reach before moving. Spend the extra distance to approach or escape.</p><small>+2 movement / Before moving</small></div></article><article><span class="skill-glyph" aria-hidden="true">守</span><div><span class="wl-kicker">03 / Defence</span><h3>Inner Guard</h3><p>Reduce incoming damage for the enemy turn. Surviving can be the useful action.</p><small>Defensive stance / Uses the action</small></div></article></div>
    <div class="reward-heading"><h3>Eight techniques to discover</h3><span>Random rewards / Within the encounter</span></div><div class="reward-grid">{skills.filter(skill=>!skill.initiallyUnlocked).map((skill,i)=><details><summary><span>0{i+1}</span><strong>{skill.name}</strong><i aria-hidden="true">+</i></summary><p>{skill.description}</p></details>)}</div>
    <div class="scope-note"><span>Designed for replay</span><p>The terrain stays fixed. Random spawn positions and skill rewards change the situation from run to run. This is a single-arena tactical roguelike prototype, with progression contained within each encounter.</p></div>
  </section>

  <section class="code-chapter" id="wulin-code"><div class="wl-wrap wl-section"><div class="section-heading"><div><p class="wl-kicker">04 / Making the rules dependable</p><h2>The rules live<br/><em>outside the screen.</em></h2></div><p>I separated combat and movement from DOM rendering. The same state functions drive the game, run in tests, and power the movement study on this page.</p></div>
    <div class="architecture-flow"><article><small>01 / DEFINE</small><strong>JSON data</strong><p>Characters, map cells and skill definitions.</p><code>assets/data/*.json</code></article><span aria-hidden="true">→</span><article><small>02 / RESOLVE</small><strong>Game state</strong><p>Validate a choice, copy state and apply its consequences.</p><code>game.js</code></article><span aria-hidden="true">→</span><article><small>03 / COMMUNICATE</small><strong>Browser interface</strong><p>Render positions, health, targeting and the battle log.</p><code>main.js + default.css</code></article></div>
    <div class="engineering-grid"><div class="test-card"><span class="wl-kicker">Mocha / Rule verification</span><strong class="test-total">32<span>passing tests</span></strong><p>Re-run against the repository snapshot used for this page.</p><div class="test-split"><span><b>12</b>Movement</span><span><b>11</b>Skills</span><span><b>9</b>Combat</span></div><a href={`${repo}/blob/main/web-app/tests/game.test.js`} target="_blank" rel="noopener">Inspect the test suite ↗</a></div><div class="engineering-notes"><article><span>Pathfinding</span><h3>Distance includes the route.</h3><p>Breadth-first search finds reachable cells around blocked and occupied squares. Enemy movement searches for a path to an open square next to the player.</p></article><article><span>State transitions</span><h3>Invalid actions leave no trace.</h3><p>Rule checks reject illegal moves before changing state. Tests cover obstacles, occupied cells, turn limits, skill effects and win/loss conditions.</p></article><article><span>Readable feedback</span><h3>Show why a choice matters.</h3><p>Target highlights, health bars, movement effects and a persistent battle log make the underlying rules visible during play.</p></article></div></div>
    <div class="closing"><div><p class="wl-kicker">From an idea to something playable</p><h2>A small arena.<br/>A complete game loop.</h2><p>I designed and implemented the concept, combat systems, enemy behaviour, interface and tests. The next useful step is structured playtesting: observe where players hesitate, then refine targeting feedback and difficulty.</p><p class="credit">Character and environment illustrations were created with generative-AI assistance. Game design, programming, integration and testing by Yuxuan Zhou.</p></div><div class="closing-links"><a href={live} target="_blank" rel="noopener"><small>OPEN IN YOUR BROWSER</small><strong>Enter the arena ↗</strong></a><a href={repo} target="_blank" rel="noopener"><small>SOURCE &amp; PROJECT README</small><strong>Explore the repository ↗</strong></a><a class="return-link" href="/#projects">← Return to the project circle</a></div></div>
  </div></section>
</div>

<script>
  import { withBase } from "../lib/paths";
  const study = document.querySelector<HTMLElement>('[data-wulin-study]');
  if (study) {
    const loadStudy = async () => {
      // Import the original, unmodified rules module; avoid a second movement implementation.
      const modulePath = withBase('/demos/wulin/game.js');
      const game = await import(/* @vite-ignore */ modulePath);
      const [map, characters, skills] = await Promise.all(['map1','characters','skills'].map(async name => {
        const response = await fetch(withBase(`/demos/wulin/${name}.json`));
        if (!response.ok) throw new Error(`Could not load ${name}`);
        return response.json();
      }));
      const cells = Array.from(study.querySelectorAll<HTMLButtonElement>('[data-cell]'));
      const modes = Array.from(study.querySelectorAll<HTMLButtonElement>('[data-mode]'));
      const reset = study.querySelector<HTMLButtonElement>('[data-study-reset]')!;
      const count = study.querySelector<HTMLElement>('[data-study-count]')!;
      const status = study.querySelector<HTMLElement>('[data-study-status]')!;
      let mode = 'walk';
      let state: ReturnType<typeof game.createInitialState>;
      let available = new Set<string>();
      const positionName = (x: number,y: number) => `${String.fromCharCode(65+x)}${y+1}`;
      const render = () => {
        const player = game.getPlayer(state);
        const moved = player.hasMoved;
        available = new Set<string>();
        if (!moved) {
          if (mode === 'shadow') {
            cells.forEach(cell => {
              const [x,y] = cell.dataset.cell!.split(',').map(Number);
              const next = game.useSkill(state,'player','shadow_step',{x,y});
              if (next !== state) available.add(`${x},${y}`);
            });
          } else {
            game.getReachableCells(state,'player').forEach((p: {x:number;y:number}) => available.add(`${p.x},${p.y}`));
          }
        }
        cells.forEach(cell => {
          const key = cell.dataset.cell!;
          const [x,y] = key.split(',').map(Number);
          const isPlayer = x === player.position.x && y === player.position.y;
          const isEnemy = x === 6 && y === 3;
          cell.dataset.reachable = String(available.has(key));
          cell.dataset.unit = isPlayer ? 'player' : isEnemy ? 'enemy' : '';
          cell.disabled = !available.has(key);
          cell.setAttribute('aria-label',`${positionName(x,y)}: ${isPlayer?'your position':isEnemy?'bandit':available.has(key)?'move here':cell.dataset.terrain==='grass'?'out of reach':'blocked terrain'}`);
        });
        count.textContent = moved ? positionName(player.position.x,player.position.y) : String(available.size);
        status.textContent = moved ? 'Position committed. Reset or choose another technique to compare.' : 'available destinations. Select a highlighted square to move.';
        study.dataset.mode = mode;
        modes.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.mode === mode)));
      };
      const start = () => {
        state = game.createInitialState({map,characters:{...characters,enemies:characters.enemies.slice(0,1)},skills,randomSpawns:false,playerStart:{x:2,y:3},enemyStarts:[{x:6,y:3}]});
        if(mode==='qi') state=game.useSkill(state,'player','qi_step');
        if(mode==='shadow') state.unlockedSkillIds.push('shadow_step');
        render();
      };
      modes.forEach(button => {button.disabled=false;button.addEventListener('click',()=>{mode=button.dataset.mode!;start();});});
      cells.forEach(cell => cell.addEventListener('click',()=>{
        if(!available.has(cell.dataset.cell!)) return;
        const [x,y]=cell.dataset.cell!.split(',').map(Number);
        state = mode==='shadow' ? game.useSkill(state,'player','shadow_step',{x,y}) : game.moveCharacter(state,'player',x,y);
        render();
        reset.focus({preventScroll:true});
      }));
      reset.disabled=false;
      reset.addEventListener('click',start);
      start();
    };
    loadStudy().catch(()=>{
      study.querySelector('[data-study-count]')!.textContent='—';
      study.querySelector('[data-study-status]')!.textContent='The movement study could not load. You can still explore the full game using the Play link.';
    });
  }
</script>

<style>
  .wulin-case{--wl-ink:#191e28;--wl-paper:#f2eee5;--wl-gold:#cfaf77;--wl-muted:#9fa6b0;--wl-line:#42454b;background:var(--wl-ink);color:var(--wl-paper);font-family:Arial,sans-serif}
  .wl-wrap{width:min(1200px,calc(100% - 96px));margin:auto}.wl-section{padding:106px 0}.wulin-case a{color:inherit}.wl-kicker{text-transform:uppercase;letter-spacing:.16em;font-size:10px;font-weight:700;color:var(--wl-gold);line-height:1.7;margin:0 0 20px}.wulin-case h1,.wulin-case h2,.wulin-case h3,.wulin-case p{margin-top:0}.wulin-case h2{font-family:Georgia,serif;font-size:clamp(36px,4.1vw,59px);font-weight:400;line-height:1.07;letter-spacing:-.045em}.wulin-case h2 em{font-weight:400;color:var(--wl-gold)}.wulin-case p{line-height:1.75;font-size:14px}.wl-hero{padding:32px 0 0;overflow:hidden;background:radial-gradient(ellipse at 77% 39%,#393a37 0,transparent 49%)}.hero-top{display:flex;justify-content:space-between;gap:20px;font-size:11px;color:#b6b6b4}.hero-top a{text-decoration:none}.hero-layout{display:grid;grid-template-columns:1.02fr 1fr;align-items:center;gap:20px;padding:76px 0 66px}.hero-copy{position:relative;z-index:1}.title-lockup{display:flex;gap:28px;align-items:center}.title-lockup h1{font-family:Georgia,serif;line-height:.95;font-size:clamp(80px,8.5vw,128px);font-weight:400;letter-spacing:-.07em;margin:0 0 32px}.title-lockup h1 span{font-family:serif;font-size:29px;letter-spacing:.2em;display:block;color:var(--wl-gold);margin:16px 0 0 5px}.seal{border:1px solid #b55a43;color:#d78669;font-family:serif;font-size:17px;padding:8px;line-height:1.25;transform:rotate(5deg);align-self:flex-start;margin-top:12px}.hero-copy h2{font-size:clamp(34px,3.4vw,48px);letter-spacing:-.04em;margin:0 0 24px}.hero-copy>p:not(.wl-kicker){max-width:430px;color:#bdc0c6}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 16px}.wl-button{padding:15px 20px;border:1px solid #686457;display:inline-flex;gap:28px;align-items:center;text-decoration:none;font-size:12px;font-weight:700}.wulin-case a.wl-button.primary{background:var(--wl-gold);border-color:var(--wl-gold);color:#20232a}.wulin-case a.wl-button:hover{background:#e0c291;color:#20232a}.hero-note{font-size:10px;color:#a9adb4}.hero-art{position:relative;aspect-ratio:1;min-width:0;isolation:isolate}.arena-disc{position:absolute;inset:9%;border-radius:50%;overflow:hidden;transform:rotate(-12deg);opacity:.5;filter:saturate(.5)}.arena-disc img{width:100%;height:100%;object-fit:cover}.art-ring{position:absolute;inset:3%;border-radius:50%;border:1px solid #7c776459}.art-ring:before{content:"";position:absolute;inset:5%;border:1px dashed #c7b17c60;border-radius:50%}.hero-player{position:absolute;width:94%;height:94%;object-fit:contain;left:4%;top:-6%;filter:drop-shadow(18px 28px 12px #0009);image-rendering:auto}.art-caption{position:absolute;left:11%;right:5%;bottom:5%;font-size:9px;letter-spacing:.15em;display:flex;justify-content:space-between;align-items:center}.art-caption i{font-family:serif;font-size:30px;color:var(--wl-gold);font-style:normal}.art-index{position:absolute;font-size:8px;letter-spacing:.2em;writing-mode:vertical-rl;right:0;top:15%;color:#a9a99a}.hero-facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--wl-line);margin:0;padding:28px 0 32px;gap:30px}.hero-facts dt{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:#aeb3ba;margin-bottom:10px}.hero-facts dd{margin:0;font-family:Georgia,serif;font-size:24px}.hero-facts dd span{display:block;font-family:Arial,sans-serif;font-size:10px;line-height:1.5;color:#aeb3ba;margin-top:8px}.wl-nav{display:flex;justify-content:center;gap:50px;border-block:1px solid var(--wl-line);padding:22px 24px}.wl-nav a{font-size:10px;letter-spacing:.09em;text-decoration:none;color:#c5c8cb}.wl-nav a:hover{color:var(--wl-gold)}[id^=wulin-]{scroll-margin-top:110px}.section-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:100px;align-items:end;margin-bottom:48px}.section-heading h2{margin-bottom:0}.section-heading>p{margin-bottom:3px;color:#bec2c8;max-width:480px}.capture-gallery{border:1px solid var(--wl-line);background:#141a20}.capture-gallery fieldset{border:0;margin:0;padding:0}.captu