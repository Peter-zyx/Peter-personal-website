---
import { withBase } from '../lib/paths';
import FaustAppEmbed from './FaustAppEmbed.astro';
import FaustLayoutDiagram from './FaustLayoutDiagram.astro';
const asset = (file: string) => withBase(`/images/projects/faust-light-system/${file}`);
const chapters = [['Brief','faust-brief'],['Light language','faust-language'],['Iteration','faust-iteration'],['Privacy','faust-privacy'],['Light Lab','faust-light-lab'],['Optical study','faust-optics'],['Handover','faust-handover']];
const states = [
  ['Ready','A quiet presence','A low, steady glow distinguishes availability from sleep.','ready'],
  ['Listening','A deliberate breath','A 2.8-second cycle provides a calm, continuous response.','listening'],
  ['Processing','A moving signal','A 90° arc travels around the ring over four seconds.','processing'],
  ['Speaking','A spatial response','Opposed light patches vary in emphasis with simulated speech.','speaking'],
];
---
<div class="faust-case">
  <header class="f-wrap f-hero">
    <a class="f-back" href={withBase('/#projects')}>← Back to projects</a>
    <div class="hero-layout">
      <div class="hero-copy"><p class="f-meta">FAUST / PRODUCT DESIGN INTERNSHIP</p><h1>Giving light<br/>a clear <em>purpose.</em></h1><p class="hero-deck">Light interaction & optical engineering.</p><p class="f-copy">I developed a smart device’s light behaviour, built tools to explore it, and connected design decisions with optical evidence.</p><div class="f-actions"><a class="f-button" href="#faust-light-lab">Try Light Lab <span>↗</span></a><a class="f-text-link" href="#faust-optics">Explore the engineering <span>↓</span></a></div></div>
      <figure class="hero-object"><div class="object-top"><span class="f-meta">01 / THE INTERFACE IS LIGHT</span><span class="object-dot" aria-hidden="true"></span></div><img src={asset('hero.webp')} alt="Faust interaction study: a transparent dome over a white light ring and black base" width="640" height="640" fetchpriority="high"/><figcaption><strong>Quiet presence. Clear feedback.</strong><span>Blender interaction visualisation · Week 3 form study</span></figcaption></figure>
    </div>
    <dl class="f-facts"><div><dt>ROLE</dt><dd>Product Designer</dd></div><div><dt>INTERNSHIP</dt><dd>Sep – 30 Nov 2026 <span>Ongoing · Remote</span></dd></div><div><dt>COMPANY</dt><dd>San Francisco HQ <span>Shenzhen office</span></dd></div><div><dt>PROJECT RECORD</dt><dd>Design → prototype → simulation <span>Work through 29 Sep 2026</span></dd></div></dl>
  </header>
  <nav class="f-chapters" aria-label="Faust case study chapters"><div class="f-wrap">{chapters.map(([label,id],i)=><a href={`#${id}`}><span>0{i+1}</span>{label}</a>)}</div></nav>
  <section class="f-wrap f-section" id="faust-brief">
    <div class="section-heading"><p class="f-meta">01 / THE BRIEF</p><h2>One ring.<br/><em>Several responsibilities.</em></h2><p class="f-copy">The same light system communicates device states, indicates camera activity and supports close-range illumination. Each purpose places different demands on the behaviour, geometry and optics.</p></div>
    <div class="brief-grid"><figure class="f-figure physical-photo"><img src={asset('physical-reference.webp')} alt="Supplied physical enclosure reference showing the clear dome and black base" width="720" height="960" loading="lazy"/><figcaption>Physical enclosure reference supplied for the project. My work here focused on the light system and its interaction.</figcaption></figure><div class="brief-decisions"><article><span class="f-meta">01 / UNDERSTAND THE SIGNAL</span><h3>Give each state a distinct behaviour.</h3><p>Define light semantics, transitions and interruption rules before selecting decorative effects.</p></article><article><span class="f-meta">02 / KEEP CAPTURE VISIBLE</span><h3>Give privacy its own priority.</h3><p>Camera activity needs a persistent signal, including when another state requests the ring.</p></article><article><span class="f-meta">03 / WORK WITH THE CONSTRAINTS</span><h3>Connect appearance with engineering.</h3><p>I reviewed requirement revisions, supplier proposals and mechanical references, then organised open optical, electrical and validation inputs.</p></article></div></div>
  </section>
  <section class="f-band" id="faust-language"><div class="f-wrap f-section">
    <div class="section-heading"><p class="f-meta">02 / A LANGUAGE OF LIGHT</p><h2>Calm enough to live with.<br/><em>Clear enough to understand.</em></h2><p class="f-copy">The “Calm Presence” direction uses rhythm and spatial distribution to distinguish normal interaction states. White carries the ordinary state language; red identifies camera activity.</p></div>
    <div class="state-grid">{states.map(([name,title,body,variant])=><article class="state-card"><div class:list={['state-symbol',`state-symbol--${variant}`]} aria-hidden="true"><svg viewBox="0 0 160 130"><ellipse cx="80" cy="67" rx="59" ry="35" class="state-track"/>{variant === 'processing' ? <path d="M 109.5 36.6891 A 59 35 0 0 1 131.0955 84.5" class="state-mark"/> : <ellipse cx="80" cy="67" rx="59" ry="35" class="state-mark"/>}<ellipse cx="80" cy="67" rx="20" ry="12" class="state-center"/></svg></div><span class="f-meta">{name}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
    <div class="f-note"><span class="note-dot" aria-hidden="true"></span><p><strong>Privacy is applied last.</strong> In Light Lab, a simulated capture hold retains red through state changes, dimming and pause. It ends only when the capture source is explicitly stopped.</p></div>
  </div></section>
  <section class="f-wrap f-section" id="faust-iteration">
    <div class="section-heading"><p class="f-meta">03 / DESIGNING THROUGH COMPARISON</p><h2>Change one thing.<br/><em>See what it changes.</em></h2><p class="f-copy">I compared breathing periods, arc lengths, rotation speed and response intensity under matched views. Moving the language onto a single-ring enclosure changed the Speaking behaviour and exposed the influence of the cover.</p></div>
    <div class="film-grid"><figure class="f-figure"><video controls playsinline preload="none" poster={asset('conversation-poster.webp')} aria-label="Silent Blender animation of the Ready, Listening, Processing and Speaking sequence"><source src={withBase('/videos/faust/conversation.mp4')} type="video/mp4"/></video><figcaption><strong>Conversation / Week 3 animation</strong>Ready → Listening → Processing → Speaking → Ready. Silent visual study; the later Light Lab review extends Listening to two complete breaths.</figcaption></figure><figure class="f-figure"><video controls playsinline preload="none" poster={asset('capture-poster.webp')} aria-label="Silent Blender animation showing a capture interruption and return to the previous state"><source src={withBase('/videos/faust/capture-interrupt.mp4')} type="video/mp4"/></video><figcaption><strong>Capture interruption / Week 3 animation</strong>Privacy appears first, capture acknowledges, then the prior state resumes.</figcaption></figure></div>
    <div class="comparison-takeaway"><div><p class="f-meta">THE DESIGN CHANGE</p><h3>Make the states different in space.</h3></div><p>Speaking B uses opposed patches. Error B preserves a broken-ring signature between pulses. The six-panel comparison makes these candidates readable alongside their baselines at the same instant.</p><a class="f-text-link" href={withBase('/apps/faust-light-lab/Behavior_Review.html')} target="_blank" rel="noopener">Open synchronised comparison ↗</a></div>
  </section>
  <section class="f-band" id="faust-privacy"><div class="f-wrap f-section">
    <div class="section-heading"><p class="f-meta">04 / PRIVACY & VISIBILITY</p><h2>A red signal only works<br/><em>if it can be seen.</em></h2><p class="f-copy">Adding more markers did not eliminate every low-angle blind spot. I separated layout changes from optical diagnostics to examine the role of the cover and emission geometry.</p></div>
    <div class="study-stats"><div><strong>112</strong><span>layout-study renders<br/>7 layouts × 8 directions × 2 elevations</span></div><div><strong>48</strong><span>diagnostic renders<br/>6 configurations × 8 views</span></div><div><strong>160</strong><span>controlled views<br/>Visual studies, not physical tests</span></div></div>
    <figure class="f-figure wide-evidence"><a href={asset('privacy-diagnostics.webp')} target="_blank" rel="noopener" aria-label="Enlarge the six optical diagnostic configurations"><img src={asset('privacy-diagnostics.webp')} alt="Six matched low-angle renders comparing the original cover, clear material, hidden cover, raised emitters and outward-facing emitters" width="1800" height="1200" loading="lazy"/></a><figcaption><strong>Same layout. Different optical conditions. <span>Enlarge ↗</span></strong>At the blind diagonal view, changes to the lower-edge material and emitter position or direction made the simulated red signal more visible.</figcaption></figure>
    <div class="two-notes"><article><h3>What the study changed</h3><p>Privacy visibility became an optical-path requirement, to be considered alongside light behaviour and LED layout.</p></article><article><h3>What still needs a sample</h3><p>The renders identify causes within the model. Real coverage, brightness and camera light leakage still require a powered prototype.</p></article></div>
  </div></section>
  <section class="f-wrap f-section" id="faust-light-lab">
    <div class="section-heading"><p class="f-meta">05 / LIGHT LAB · THREE.JS</p><h2>Put the design<br/><em>in someone else’s hands.</em></h2><p class="f-copy">I turned the Blender form and light engine into a working review tool. Switch states, rotate the model and interrupt the flow with a simulated capture. The full app adds timing controls, 4–36 logical zones, fixed views and JSON export.</p></div>
    <FaustAppEmbed name="Light Lab" number="01" kind="light" description="Explore the light language on the three-dimensional form. Try Listening, then start a capture hold." src="/apps/faust-light-lab/index.html?embed=1" full="/apps/faust-light-lab/index.html" poster="/images/projects/faust-light-system/hero.webp" alt="Blender render of the Faust form used in Light Lab"/>
    <p class="f-caption">Week 4 interaction prototype. The web material and logical emitters explain behaviour; they do not predict physical illuminance. Capture and speech are simulated.</p>
    <div class="feature-line"><div><span>01</span><strong>Repeat a view</strong><p>Use fixed camera directions for comparable observations.</p></div><div><span>02</span><strong>Compare a behaviour</strong><p>Review baseline and A/B variants with matching timing.</p></div><div><span>03</span><strong>Keep the context</strong><p>Export parameters, actual camera pose and capture activity.</p></div></div>
  </section>
  <section class="f-band" id="faust-optics"><div class="f-wrap f-section">
    <div class="section-heading"><p class="f-meta">06 / MODEL LAB · ANSYS SPEOS + JAVASCRIPT</p><h2>From a visible behaviour<br/><em>to a calculable system.</em></h2><p class="f-copy">The latest F2 study tests conditional window and LED layouts, then uses per-source optical responses to calculate changing light output. Model Lab brings those results into an explorable state sequence.</p></div>
    <div class="optics-grid"><figure class="f-figure"><FaustLayoutDiagram/><figcaption><strong>A separate engineering study</strong>F2 uses assumed planar windows and source geometry. These are conditional analysis envelopes, not a replacement production design for the earlier dome.</figcaption></figure><div class="optics-evidence"><p class="f-meta">F2 / 29 SEPTEMBER 2026</p><div><strong>8</strong><span>conditional optical configurations</span></div><div><strong>22</strong><span>Speos solves, including per-source responses and numerical checks</span></div><div><strong>5</strong><span>solved distances · 0.15–1.5 m</span></div><p>Only W45_N12_G10 has the interactive response basis. The other layouts have static evidence.</p></div></div>
    <FaustAppEmbed name="Model Lab" number="02" kind="model" description="Switch states and solved distances. Watch the target-plane illuminance respond over time, using the same F2 calculation engine as the full app." src="/apps/faust-model-lab/preview.html" full="/apps/faust-model-lab/index.html" poster="/images/projects/faust-light-system/model-preview.webp" alt="Model Lab F2 interface with a target-plane illuminance heatmap"/>
    <p class="f-caption">Conditional 555 nm optical model with assumed material properties. The preview recomputes from solved data; it does not run Ansys or establish actual RGB, current or thermal performance.</p>
    <div class="two-notes"><article><p class="f-meta">THE ENGINEERING QUESTION</p><h3>What happens between the states?</h3><p>The complete sequence connects 14 states across 42 seconds. Full-app export preserves every 0.5 ms sample, including all 25 target-plane bins.</p></article><article><p class="f-meta">A CONFLICT MADE VISIBLE</p><h3>A lighting floor meets a dark state.</h3><p>The model exposes the conflict between Regime A illumination and slew blanking. It keeps that conflict visible for review instead of silently changing the policy.</p></article></div>
    <details class="f-details"><summary>Read the calculation scope and evidence</summary><div><p>The full app includes an ideal PWM/exposure calculation, conditional current budgets, an optional one-node thermal estimate and a bilingual requirements view. These calculations depend on explicit inputs; unknown device parameters remain unfilled.</p><p>F2 supersedes the earlier study conclusions. Numerical consistency checks compare calculations under matching assumptions. They do not establish physical accuracy, camera performance or product acceptance.</p><a class="f-text-link" href={withBase('/apps/faust-model-lab/docs/English_Deliverable.pdf')} target="_blank" rel="noopener">Read the F2 engineering report · 33 pages ↗</a></div></details>
  </div></section>
  <section class="f-wrap f-section" id="faust-handover">
    <div class="section-heading"><p class="f-meta">07 / ENGINEERING HANDOVER</p><h2>Make the next decision<br/><em>easier to make.</em></h2><p class="f-copy">My contribution connected requirements, interaction design, visual studies, web development and conditional simulation. The handover makes the design choices and missing evidence traceable.</p></div>
    <div class="handover-grid"><article><span class="f-meta">DESIGN RECORD</span><h3>Behaviour & comparisons</h3><p>State language, timing, privacy priorities, Blender studies and synchronised candidate reviews.</p></article><article><span class="f-meta">WORKING TOOLS</span><h3>Two web applications</h3><p>Light Lab for behaviour; Model Lab for optical evidence, timing and parameter exploration.</p></article><article><span class="f-meta">ENGINEERING RECORD</span><h3>Requirements & validation</h3><p>F2’s 11 requirements, unresolved inputs, numerical evidence and the physical verification plan.</p></article></div>
    <div class="handover-footer"><div><p class="f-meta">ONGOING INTERNSHIP / SEPTEMBER–NOVEMBER 2026</p><h3>Design, prototype, test the assumptions.</h3><p>This case study records work through 29 September. Real material data, calibrated device measurements and physical validation are the next steps.</p></div><div class="handover-links"><a href={withBase('/apps/faust-light-lab/index.html')} target="_blank" rel="noopener">Open Light Lab ↗</a><a href={withBase('/apps/faust-model-lab/index.html')} target="_blank" rel="noopener">Open Model Lab ↗</a><a href={withBase('/apps/faust-model-lab/docs/English_Deliverable.pdf')} target="_blank" rel="noopener">Read the engineering report ↗</a><a href={withBase('/#experience')}>View internship experience ↗</a></div></div>
  </section>
</div>
<style>
  .faust-case{--f-accent:#a9d2c4;--f-muted:#aab8b1;--f-line:#2b3732;background:#080d0b;color:#eaf0e9}.f-wrap{width:min(1200px,calc(100% - 80px));margin-inline:auto}.f-meta{font:400 10px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.1em;color:var(--f-accent);text-transform:uppercase;margin:0 0 20px}.f-back{display:inline-flex;align-items:center;min-height:44px;color:var(--f-muted);font-size:12px;text-decoration:none;margin-bottom:45px}.f-hero{padding-top:24px}.hero-layout{display:grid;grid-template-columns:1.05fr 1fr;gap:40px;align-items:center}.hero-copy h1{font-size:clamp(54px,6.7vw,92px);font-weight:500;line-height:1.02;letter-spacing:-.065em;margin:0 0 28px}.faust-case em{font-style:normal;color:var(--f-accent)}.hero-deck{font-size:clamp(19px,2.2vw,28px);line-height:1.35;letter-spacing:-.025em;max-width:400px;margin:0 0 22px}.f-copy{color:var(--f-muted);font-size:15px;line-height:1.85;max-width:650px}.hero-copy>.f-copy{max-width:440px}.f-actions{display:flex;align-items:center;flex-wrap:wrap;gap:20px;margin-top:30px}.f-button{display:inline-flex;justify-content:space-between;align-items:center;gap:30px;min-height:46px;padding:13px 20px;background:#cbe4d7;color:#15261c;font-size:12px;font-weight:550;border-radius:3px;text-decoration:none}.f-text-link{display:inline-flex;align-items:center;gap:16px;color:#cbded3;text-decoration:none;font-size:12px;min-height:44px}.hero-object{position:relative;margin:0;border:1px solid #2b3935;border-radius:5px;background:#101a17;overflow:hidden}.hero-object>img{display:block;width:100%;height:auto;max-height:440px;object-fit:contain}.object-top{position:absolute;top:22px;left:24px;right:24px;display:flex;align-items:center;justify-content:space-between;z-index:1}.object-top .f-meta{font-size:8px;margin:0;color:#c5d4ce}.object-dot{height:5px;width:5px;border-radius:50%;background:#b8d9ca;box-shadow:0 0 14px #9fead9}.hero-object figcaption{padding:20px 24px;background:#111b18;display:flex;flex-direction:column;gap:7px}.hero-object figcaption strong{font-size:14px;font-weight:450}.hero-object figcaption span{font:9px/1.7 ui-monospace,monospace;color:#a9b9b1}.f-facts{display:grid;grid-template-columns:.8fr 1fr 1fr 1.3fr;margin:48px 0 0;padding:28px 0 35px;border-top:1px solid var(--f-line);gap:20px}.f-facts dt{color:var(--f-muted);font:9px/1.5 ui-monospace,monospace;margin-bottom:12px;letter-spacing:.08em}.f-facts dd{margin:0;font-size:13px;line-height:1.6}.f-facts dd span{display:block;font-size:11px;color:#94a89b;margin-top:4px}.f-chapters{background:#101914;border-block:1px solid var(--f-line)}.f-chapters>.f-wrap{display:flex;justify-content:space-between;gap:15px;overflow-x:auto;padding-block:19px}.f-chapters a{color:#d1dcd5;font-size:11px;text-decoration:none;white-space:nowrap;min-height:30px;display:flex;align-items:center;gap:8px}.f-chapters a span{color:#83aa94;font:9px ui-monospace,monospace}.f-section{padding-block:88px;scroll-margin-top:100px}.f-band{background:#0d1511;scroll-margin-top:90px}.section-heading{margin-bottom:38px}.section-heading h2{font-size:clamp(32px,4.1vw,55px);font-weight:450;line-height:1.08;letter-spacing:-.05em;margin:0 0 22px}.section-heading>.f-copy{margin-bottom:0}.brief-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px;align-items:start}.f-figure{margin:0;border:1px solid var(--f-line);border-radius:4px;overflow:hidden;background:#111a17}.f-figure img{display:block;width:100%;height:auto}.f-figure figcaption{padding:20px 22px;color:var(--f-muted);font-size:11px;line-height:1.8}.f-figure figcaption strong{display:block;color:#e2e9e2;font-size:12px;font-weight:450;margin-bottom:5px}.physical-photo img{height:380px;object-fit:cover;object-position:center 45%}.brief-decisions article{padding:0 0 25px;margin-bottom:25px;border-bottom:1px solid var(--f-line)}.brief-decisions article:last-child{margin-bottom:0}.brief-decisions .f-meta{margin-bottom:12px}.faust-case h3{font-weight:450;letter-spacing:-.025em}.brief-decisions h3{font-size:23px;margin:0 0 10px}.brief-decisions p:not(.f-meta){color:var(--f-muted);font-size:14px;line-height:1.8;margin:0;max-width:510px}.state-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--f-line);border:1px solid var(--f-line)}.state-card{background:#101a15;padding:20px 24px 30px}.state-card .f-meta{font-size:9px;margin-bottom:10px}.state-card h3{font-size:18px;margin:0 0 10px}.state-card p{font-size:12px;line-height:1.8;color:var(--f-muted);margin:0}.state-symbol{height:145px;margin-bottom:16px}.state-symbol svg{width:100%;height:100%;overflow:visible}.state-track{stroke:#31443a;stroke-width:8;fill:none}.state-mark{stroke:#d9e5db;stroke-width:7;fill:none}.state-center{fill:none;stroke:#3a5144;stroke-width:1}.state-symbol--ready .state-mark{opacity:.42}.state-symbol--listening .state-mark{stroke-width:10;filter:drop-shadow(0 0 6px #bbddc477)}.state-symbol--speaking .state-mark{stroke-dasharray:58 93;stroke-dashoffset:29}.f-note{display:flex;gap:18px;align-items:center;margin-top:25px;border-left:2px solid #c87567;padding:10px 20px;background:#38242133}.f-note p{font-size:13px;line-height:1.8;color:#bcbfb7;margin:0}.f-note strong{font-weight:500;color:#e1c7be}.note-dot{width:8px;height:8px;border-radius:50%;background:#d76755;flex-shrink:0}.film-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.film-grid video{display:block;width:100%;height:360px;object-fit:contain;background:#050908}.comparison-takeaway{display:grid;grid-template-columns:.8fr 1.2fr;gap:10px 50px;margin-top:36px;padding-top:30px;border-top:1px solid var(--f-line)}.comparison-takeaway .f-meta{margin-bottom:10px}.comparison-takeaway h3{font-size:27px;margin:0}.comparison-takeaway p:not(.f-meta){font-size:14px;line-height:1.8;color:var(--f-muted);margin:0}.comparison-takeaway a{grid-column:2}.study-stats{display:grid;grid-template-columns:1fr 1fr 1fr;border-block:1px solid var(--f-line);margin:30px 0;gap:30px;padding:25px 0}.study-stats>div{display:flex;gap:22px;align-items:center}.study-stats strong{font-weight:400;color:var(--f-accent);font-size:46px;letter-spacing:-.05em}.study-stats span{font-size:10px;color:var(--f-muted);line-height:1.8}.wide-evidence{background:#080d0b}.wide-evidence img{max-height:610px;object-fit:contain}.wide-evidence strong span{float:right;color:var(--f-accent)}.two-notes{display:grid;grid-template-columns:1fr 1fr;gap:55px;margin-top:35px}.two-notes article{border-top:1px solid var(--f-line);padding-top:22px}.two-notes h3{font-size:23px;margin:0 0 12px}.two-notes p{font-size:13px;line-height:1.8;color:var(--f-muted);margin:0}.two-notes .f-meta{font-size:9px;margin-bottom:13px;color:var(--f-accent)}.f-caption{font-size:11px;line-height:1.8;color:#94a99c;margin:16px 0 0;max-width:900px}.feature-line{display:grid;grid-template-columns:1fr 1fr 1fr;gap:30px;margin-top:40px}.feature-line>div{border-top:1px solid var(--f-line);padding-top:20px}.feature-line span{color:var(--f-accent);font:10px ui-monospace,monospace;margin-right:14px}.feature-line strong{font-size:15px;font-weight:450}.feature-line p{font-size:12px;line-height:1.8;color:var(--f-muted);margin:12px 0 0}.optics-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:45px;align-items:center}.optics-evidence>div{display:flex;align-items:center;gap:25px;border-bottom:1px solid var(--f-line);padding:18px 0}.optics-evidence strong{font-size:47px;font-weight:400;color:var(--f-accent);min-width:55px;letter-spacing:-.05em}.optics-evidence span{font-size:13px;color:#bbc9bf;line-height:1.7}.optics-evidence>p:not(.f-meta){font-size:11px;line-height:1.8;color:var(--f-muted);margin-top:20px}.f-details{border-block:1px solid var(--f-line);margin-top:35px}.f-details summary{cursor:pointer;font-size:13px;padding:22px 5px;color:#d1e2d6}.f-details>div{padding:0 5px 22px;max-width:830px}.f-details p{font-size:13px;line-height:1.8;color:var(--f-muted)}.handover-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.handover-grid article{border:1px solid