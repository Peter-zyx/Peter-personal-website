  .chapter-nav a:hover{color:var(--pet-teal)}
  .section{padding-block:100px}
  .section-heading{max-width:740px;margin-bottom:48px}
  .section-heading h2{font-size:clamp(2.25rem,4.2vw,3.6rem);line-height:1.07;margin:20px 0 24px}
  .section-heading h2 span{color:var(--pet-muted)}
  .section-heading>p:last-child{max-width:650px;color:var(--pet-muted)}
  .research-counts{display:grid;grid-template-columns:1fr 1.2fr 1fr;border-block:1px solid var(--pet-line);padding:30px 0;gap:35px}
  .research-counts strong{display:block;font-family:"Space Grotesk",sans-serif;font-size:3.4rem;letter-spacing:-.055em;font-weight:500;color:var(--pet-teal)}
  .research-counts span{display:block;font-size:.8rem;margin-top:9px}
  .research-insights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:42px;margin:42px 0 30px}
  .research-insights article>span{font-size:.65rem;color:var(--pet-muted);text-transform:uppercase;letter-spacing:.1em}
  .research-insights h3{font-size:1.5rem;margin:15px 0 12px;line-height:1.15}
  .research-insights p{font-size:.9rem;color:var(--pet-muted)}
  .personal-chapter{--pet-muted:#66695f;--pet-line:#d6d3c7;background:#f1eee5;color:#2c352c;color-scheme:light}
  .chapter-heading{display:flex;justify-content:space-between;gap:28px;align-items:center;border-bottom:1px solid var(--pet-line);padding-bottom:30px}
  .chapter-heading h2{font-size:clamp(4rem,9vw,8rem);line-height:1;margin-top:14px;letter-spacing:-.075em}
  .personal-chapter .title-dot{color:#a88e52}
  .ownership{border:1px solid var(--pet-line);padding:12px 18px;border-radius:100px;font-size:.75rem}
  .personal-intro{display:grid;grid-template-columns:1fr 1fr;gap:70px;padding:38px 0 55px;align-items:start}
  .personal-intro>p:last-child{max-width:530px;color:var(--pet-muted)}
  .concept-development{display:grid;grid-template-columns:1.2fr 1fr;gap:46px;align-items:center}
  .sketch-sheet{background:white;border:1px solid var(--pet-line);padding:12px}
  .sketch-sheet img{width:100%}
  .pet-case figcaption{font-size:.7rem;line-height:1.6;color:var(--pet-muted)}
  .sketch-sheet figcaption{display:flex;justify-content:space-between;padding:12px 8px 3px}
  .concept-count{display:grid;grid-template-columns:auto 1fr auto auto 1fr;align-items:center;gap:13px;margin-bottom:22px}
  .concept-count strong{font-family:"Space Grotesk",sans-serif;font-size:3rem;letter-spacing:-.05em;font-weight:500}
  .concept-count span{font-size:.7rem;max-width:70px;line-height:1.5}
  .concept-count i{font-style:normal;margin-right:10px}
  .concept-reasoning h3{font-size:1.8rem;margin-bottom:18px}
