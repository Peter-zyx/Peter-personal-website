  .pet-hero{padding-top:30px;padding-bottom:20px}
  .hero-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:70px;margin:40px 0 50px;align-items:end}
  .hero-heading .eyebrow{max-width:330px;margin-bottom:24px;color:var(--pet-muted)}
  .hero-heading h1{font-size:clamp(5rem,8.7vw,8.1rem);line-height:.94;letter-spacing:-.065em}
  .hero-heading h1 span{color:var(--pet-teal)}
  .pet-case .large-copy{font-family:"Space Grotesk",sans-serif;font-size:clamp(1.9rem,3.2vw,3rem);line-height:1.13;letter-spacing:-.045em}
  .hero-deck>p:nth-child(2){max-width:440px;color:var(--pet-muted);margin:20px 0}
  .hero-credit{display:flex;flex-wrap:wrap;gap:22px;font-size:.7rem;color:var(--pet-muted);margin:24px 0}
  .hero-credit b{display:block;color:#f1f1e9;font-size:.9rem;margin-top:6px;font-weight:500}
  .inline-link{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;min-height:44px;font-size:.8rem;text-decoration:none;border-bottom:1px solid currentColor}
  .hero-pair{display:grid;grid-template-columns:.65fr 1.35fr;gap:14px}
  .hero-pair>a{position:relative;display:block;min-width:0;height:420px;overflow:hidden;text-decoration:none;border-radius:4px}
  .petease-cover{background:#eeeae1;color:#343a31}
  .petease-cover>img{height:310px;width:auto;max-width:80%;object-fit:contain;margin:36px auto 0;mix-blend-mode:multiply}
  .cover-label{position:absolute;top:24px;left:26px;font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;font-weight:600}
  .cover-bottom{position:absolute;bottom:24px;left:26px;right:26px;display:flex;justify-content:space-between;align-items:end}
  .cover-bottom strong{display:block;font-family:"Space Grotesk",sans-serif;font-size:2rem;letter-spacing:-.05em;font-weight:500}
  .cover-bottom div>span{display:block;margin-top:5px;font-size:.75rem}
  .circle-arrow{display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;width:40px;height:40px;font-size:1.3rem;transition:transform .2s}
  .hero-pair>a:hover .circle-arrow{transform:translate(2px,2px)}
  .dooti-cover>img{width:100%;height:100%;object-fit:cover;object-position:50% 51%}
  .dooti-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.78),transparent 45%,rgba(0,0,0,.34))}
  .dooti-cover :is(.cover-label,.cover-bottom){z-index:1}
  .project-facts{display:grid;grid-template-columns:1fr 1fr 1.35fr;gap:24px;margin-top:28px;padding:23px 0}
  .project-facts span{display:block;font-size:.65rem;color:var(--pet-muted);margin-bottom:9px;text-transform:uppercase;letter-spacing:.08em}
  .project-facts strong{font-size:.8rem;font-weight:500;line-height:1.6}
