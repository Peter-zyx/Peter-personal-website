---
import CPAppCase from "../../components/CPAppCase.astro";
import SuvEngineeringCase from "../../components/SuvEngineeringCase.astro";
import PlaneSeatCase from "../../components/PlaneSeatCase.astro";
import ProjectContinuation from "../../components/ProjectContinuation.astro";
import "../../styles/project-refinement.css";
import Header from "../../components/Header.astro";
import DataAnalysisCase from "../../components/DataAnalysisCase.astro";
import SmartMedicationCase from "../../components/SmartMedicationCase.astro";
import ProstheticLimbCase from "../../components/ProstheticLimbCase.astro";
import PetCleaningCase from "../../components/PetCleaningCase.astro";
import ShyBloomCase from "../../components/ShyBloomCase.astro";
import ArchitectureCase from "../../components/ArchitectureCase.astro";
import DancingSegwayCase from "../../components/DancingSegwayCase.astro";
import FootballRobotCase from "../../components/FootballRobotCase.astro";
import WulinGameCase from "../../components/WulinGameCase.astro";
import ReverseEngineeringCase from "../../components/ReverseEngineeringCase.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../lib/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const Content = project.Content;
const isCPApp = project.slug === "cp-app";
const isSuv = project.slug === "suv-battery-cooling";
const isPlaneSeat = project.slug === "sustainable-plane-seat";
const isReverseEngineering = project.slug === "reverse-engineering-shaver";
const isDataAnalysis = project.slug === "dataset-prediction";
const isSmartMedication = project.slug === "smart-medication-monitor";
const isProsthetic = project.slug === "prosthetic-limb-analysis";
const isPetCleaning = project.slug === "pet-cleaning-tool";
const isShyBloom = project.slug === "light-control-lamp";
const isArchitecture = project.slug === "architecture-design";
const isDancingSegway = project.slug === "dancing-segway";
const isFootballRobot = project.slug === "ai-football-robot";
const isWulinGame = project.slug === "webapp-game";
const isImmersiveProject = isSuv;

---

<BaseLayout title={`${project.title} | Yuxuan Zhou`} description={project.summary}>
  <Header />
  <main>
    <article data-project-slug={project.slug} class={`project ${isImmersiveProject ? "project--suv" : ""}`}>
      {
        isCPApp ? (
          <CPAppCase project={project} />
        ) : isPlaneSeat ? (
          <PlaneSeatCase />
        ) : isWulinGame ? (
          <WulinGameCase project={project} />
        ) : isFootballRobot ? (
          <FootballRobotCase project={project} />
        ) : isDancingSegway ? (
          <DancingSegwayCase project={project} />
        ) : isArchitecture ? (
          <ArchitectureCase project={project} />
        ) : isShyBloom ? (
          <ShyBloomCase project={project} />
        ) : isPetCleaning ? (
          <PetCleaningCase project={project} />
        ) : isProsthetic ? (
          <ProstheticLimbCase project={project} />
        ) : isSmartMedication ? (
          <SmartMedicationCase project={project} />
        ) : isDataAnalysis ? (
          <DataAnalysisCase project={project} />
        ) : isReverseEngineering ? (
          <ReverseEngineeringCase project={project} />
        ) : isImmersiveProject ? (
          <SuvEngineeringCase project={project} />
        ) : (
          <header class="project-hero">
            <div class="container hero-grid">
              <div>
                <a class="back" href="/#projects">Back to projects</a>
                <p class="eyebrow">{project.category} / {project.year}</p>
                <h1>{project.title}</h1>
                <p>{project.summary}</p>
                <div class="tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </div>
              <img src={project.hero} alt="" />
            </div>
          </header>
        )
      }


      {!isCPApp && !isSuv && !isPlaneSeat && !isReverseEngineering && !isDataAnalysis && !isSmartMedication && !isProsthetic && !isPetCleaning && !isShyBloom && !isArchitecture && !isDancingSegway && !isFootballRobot && !isWulinGame ? (
      <section class={`container content-grid ${isImmersiveProject ? "content-grid--suv" : ""}`}>
        <aside>
          <div>
            <span>Type</span>
            <strong>{project.type}</strong>
          </div>
          <div>
            <span>Impact</span>
            <strong>{project.impact}</strong>
          </div>
          {
            project.links?.length ? (
              <div>
                <span>Links</span>
                {project.links.map((link) => (
                  <a class="text-link" href={link.url}>{link.label}</a>
                ))}
              </div>
            ) : null
          }
        </aside>
        <div class={`case-study ${isImmersiveProject ? "case-study--suv" : ""}`}>
          {
            isImmersiveProject ? (
              <div class="case-study-copy" id="project-analysis"><Content /></div>
            ) : (
              <Content />
            )
          }
        </div>
      </section>
      ) : null}
      <ProjectContinuation project={project} />
    </article>
  </main>
</BaseLayout>

<style>
  .project-hero {
    padding: 54px 0 74px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(360px, 0.58fr);
    gap: 52px;
    align-items: end;
  }

  .back {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--muted);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.9;
  }

  .project-hero p:not(.eyebrow) {
    max-width: 700px;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .project-hero img {
    width: 100%;
    aspect-ratio: 1.1;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .tags span {
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 760px);
    gap: 70px;
    align-items: start;
    padding-bottom: 120px;
  }

  :global(.content-grid.content-grid--suv) {
    grid-template-columns: minmax(0, 1fr);
    gap: 64px;
    padding-top: 88px;
  }

  :global(.content-grid--suv > aside) {
    position: static;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 30px;
  }

  :global(.content-grid--suv > aside div) {
    min-height: 0;
    padding: 16px 0 0;
    border: 0;
    border-top: 1px solid rgba(246, 248, 243, 0.16);
    border-radius: 0;
    background: transparent;
  }

  aside {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 14px;
  }

  aside div {
    display: grid;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
  }

  aside span {
    color: var(--metal);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  aside strong,
  aside a {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 560;
    line-height: 1.5;
  }

  .case-study {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.76;
  }

  :global(.case-study--suv) {
    max-width: none;
  }

  :global(.case-study-copy) {
    display: grid;
    gap: 24px;
    max-width: 860px;
    margin: 0 auto;
    padding: 68px 0 10px;
    border-top: 1px solid rgba(246, 248, 243, 0.12);
  }

  :global(.case-study-copy p) {
    margin: 0;
    color: rgba(227, 231, 226, 0.68);
    font-size: clamp(1.06rem, 1.45vw, 1.28rem);
    line-height: 1.72;
  }

  :global(.case-study-copy p:first-child) {
    color: rgba(246, 248, 243, 0.9);
    font-size: clamp(1.22rem, 1.8vw, 1.5rem);
    line-height: 1.58;
  }

  :global(.suv-render-showcase) {
    display: grid;
    gap: 24px;
    margin-bottom: 72px;
  }

  :global(.suv-render-copy) {
    display: grid;
    max-width: 780px;
  }

  :global(.suv-render-copy h2) {
    margin: 0;
    color: var(--text);
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.96;
  }

  :global(.suv-render-copy p:not(.eyebrow)) {
    max-width: 720px;
    margin: 18px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  :global(.suv-render-frame) {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(246, 248, 243, 0.14);
    border-radius: 8px;
    background:
      radial-gradient(circle at 50% 12%, rgba(196, 212, 207, 0.12), transparent 28rem),
      #080909;
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.42);
  }

  :global(.suv-render-frame::after) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
    background:
      linear-gradient(180deg, rgba(3, 3, 3, 0.04), transparent 38%, rgba(3, 3, 3, 0.18)),
      radial-gradient(circle at 48% 80%, transparent 0 42%, rgba(3, 3, 3, 0.24) 76%);
  }

  :global(.suv-render-frame img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 58%;
    filter: saturate(0.92) contrast(1.04) brightness(0.9);
  }

  :global(.suv-render-frame--seat) {
    background:
      radial-gradient(circle at 50% 42%, rgba(196, 212, 207, 0.13), transparent 31rem),
      #090a0a;
  }

  :global(.suv-render-frame--seat img) {
    padding: clamp(24px, 5vw, 72px);
    object-fit: contain;
    object-position: center;
    filter: saturate(0.82) contrast(1.05) brightness(0.86);
  }

  :global(.suv-render-frame figcaption) {
    position: absolute;
    right: 18px;
    bottom: 18px;
    left: 18px;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.suv-render-frame figcaption span) {
    padding: 8px 10px;
    border: 1px solid rgba(246, 248, 243, 0.16);
    border-radius: 999px;
    background: rgba(3, 4, 3, 0.5);
    color: rgba(246, 248, 243, 0.78);
    font-size: 0.78rem;
    backdrop-filter: blur(16px);
  }

  :global(.suv-feature-strip) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  :global(.suv-feature-strip article) {
    display: grid;
    gap: 8px;
    padding: 16px;
    border: 1px solid rgba(246, 248, 243, 0.1);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
  }

  :global(.suv-feature-strip span) {
    color: var(--metal);
    font-size: 0.72rem;
    font-weight: 760;
  }

  :global(.suv-feature-strip strong) {
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.2;
  }

  :global(.suv-feature-strip p) {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .case-study :global(h2) {
    margin: 52px 0 14px;
    color: var(--text);
    font-size: clamp(1.65rem, 3vw, 2.6rem);
    line-height: 1.08;
  }

  .case-study :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study :global(p) {
    margin: 0 0 18px;
  }

  .case-study :global(ul) {
    padding-left: 1.1rem;
  }

  .case-study :global(li) {
    margin-bottom: 10px;
  }

  @media (max-width: 920px) {
    .hero-grid,
    .content-grid {
      grid-template-columns: 1fr;
    }

    aside {
      position: static;
      grid-template-columns: repeat(2, 1fr);
    }

    :global(.content-grid--suv > aside) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(.suv-feature-strip) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    h1 {
      font-size: clamp(2.45rem, 16vw, 4.4rem);
    }

    aside {
      grid-template-columns: 1fr;
    }

    :global(.content-grid.content-grid--suv) {
      gap: 44px;
      padding-top: 56px;
    }

    :global(.content-grid--suv > aside) {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    :global(.case-study-copy) {
      padding-top: 44px;
    }

    :global(.suv-render-frame img) {
      aspect-ratio: 4 / 5;
      object-position: 50% 50%;
    }

    :global(.suv-render-frame--seat img) {
      padding: 22px;
      object-fit: contain;
    }

    :global(.suv-feature-strip) {
      grid-template-columns: 1fr;
    }
  }
</style>
