---
import Header from "../components/Header.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories, projects as allProjects } from "../lib/projects";

const projects = allProjects.filter(
  (project) => !["modular-shoe", "mechanics-experiment"].includes(project.slug)
);
---

<BaseLayout>
  <Header />
  <main>
    <section class="hero">
      <canvas class="fluid-canvas" data-fluid-canvas aria-hidden="true"></canvas>
      <div class="fluid-cursor" data-fluid-cursor aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <p class="eyebrow">Design Engineering Portfolio</p>
          <h1 data-fluid-title>
            Designing for the future.
          </h1>
          <p class="hero-name">Yuxuan Zhou</p>
          <p class="hero-intro">
            I am a Design Engineering student at Imperial College London, working across AI vision, robotics,
            mobility, simulation, sustainability, and product experience.
          </p>
          <div class="hero-actions">
            <a class="primary" href="#projects">Explore projects</a>
            <a href="mailto:zhouyuxuanpeter@outlook.com">Contact</a>
          </div>
          <div class="hero-meta" aria-label="Portfolio highlights">
            <span><strong>{projects.length}</strong> case studies</span>
            <span><strong>{categories.length - 1}</strong> disciplines</span>
            <span><strong>2024-2026</strong> archive</span>
          </div>
        </div>
      </div>
      <div class="container scroll-row" aria-hidden="true">
        <span>Scroll for profile and archive</span>
        <span></span>
      </div>
    </section>

    <section class="about" id="about">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">About</p>
          <h2 class="section-title">A design engineer moving between digital intelligence and physical systems.</h2>
        </div>
        <div class="about-copy">
          <p>
            I study Design Engineering at Imperial College London, with project work spanning robot vision,
            mobility concepts, sustainable product redesign, CAD modelling, simulation analysis, and human-centred
            research.
          </p>
          <p>
            I am looking for placement and internship opportunities in AI-enabled products, design engineering,
            mobility, game-adjacent interaction, automotive technology, and future-facing product teams.
          </p>
        </div>
      </div>
      <div class="container toolkit">
        <div>
          <span>Languages</span>
          <strong>English, Mandarin, Spanish B1</strong>
        </div>
        <div>
          <span>Design & CAD</span>
          <strong>Fusion 360, Blender, Figma, InDesign</strong>
        </div>
        <div>
          <span>Code & AI</span>
          <strong>Python, MATLAB, MicroPython, Edge Impulse</strong>
        </div>
        <div>
          <span>Engineering</span>
          <strong>ANSYS, Granta EduPack, 3D printing, prototyping</strong>
        </div>
      </div>
    </section>

    <ProjectGrid projects={projects} categories={categories} />

    <section class="contact" id="contact">
      <div class="container contact-card">
        <p class="eyebrow">Contact</p>
        <h2>Open to placement and internship conversations.</h2>
        <div class="contact-actions">
          <a href="mailto:zhouyuxuanpeter@outlook.com">zhouyuxuanpeter@outlook.com</a>
          <a href="/cv/yuxuan-zhou-cv.pdf">Download CV</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline type="module" src="/fluid-hero.js"></script>

<style>
  .fluid-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 1;
  }

  .fluid-cursor {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 999px;
    background: var(--metal-bright);
    box-shadow:
      0 0 14px rgba(246, 251, 247, 0.34),
      0 0 28px rgba(112, 201, 209, 0.18);
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  main {
    position: relative;
    z-index: 1;
  }

  .hero {
    position: relative;
    min-height: calc(100vh - 82px);
    display: grid;
    align-items: center;
    padding: 96px 0 38px;
    overflow: hidden;
    text-align: center;
  }

  .hero::before {
    position: absolute;
    inset: -120px 0 auto;
    height: 440px;
    pointer-events: none;
    content: "";
    background:
      radial-gradient(circle at 50% 14%, rgba(236, 246, 242, 0.14), transparent 21rem),
      radial-gradient(circle at 50% 42%, rgba(112, 201, 209, 0.1), transparent 24rem);
    filter: blur(12px);
  }

  .hero::after {
    position: absolute;
    inset: 28px 24px 0;
    z-index: -1;
    pointer-events: none;
    content: "";
    border: 1px solid rgba(246, 248, 243, 0.08);
    border-radius: 28px;
    opacity: 0.65;
    background:
      radial-gradient(circle at calc(var(--cursor-xn) * 100%) calc(var(--cursor-yn) * 100%), rgba(246, 248, 243, 0.08), transparent 18rem),
      radial-gradient(circle at 50% 50%, transparent 0 42%, rgba(246, 248, 243, 0.035) 42.2%, transparent 42.6%);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
  }

  .hero-copy {
    display: grid;
    justify-items: center;
  }

  .hero-copy h1 {
    max-width: 1120px;
    margin: 0;
    font-size: 8.15rem;
    font-family: "Space Grotesk", Inter, ui-sans-serif, system-ui, sans-serif;
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: 0;
    color: var(--metal-bright);
    text-shadow: 0 18px 70px rgba(246, 248, 243, 0.11);
    text-wrap: balance;
    transition: opacity 0s linear 360ms;
  }

  .hero.is-fluid-ready .hero-copy h1 {
    opacity: 0;
  }

  .hero-copy .hero-name {
    margin: 28px 0 0;
    color: var(--metal-bright);
    font-size: clamp(1.28rem, 2vw, 1.9rem);
    font-weight: 680;
    line-height: 1;
  }

  .hero-copy .hero-intro {
    max-width: 760px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 1.16rem;
    line-height: 1.7;
  }

  .hero-actions,
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-actions a,
  .contact-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 17px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .hero-actions a:hover,
  .contact-actions a:hover,
  .hero-actions .primary {
    border-color: var(--line-strong);
    background: var(--metal-soft);
  }

  .hero-actions .primary {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 650px;
    gap: 10px;
    margin-top: 34px;
  }

  .hero-meta span {
    min-height: 74px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.025);
    color: var(--muted);
    font-size: 0.82rem;
    text-align: left;
  }

  .hero-meta strong {
    display: block;
    margin-bottom: 6px;
    color: var(--text);
    font-size: 1.02rem;
  }

  .scroll-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: center;
    margin-top: 42px;
    color: var(--soft);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .scroll-row span:last-child {
    height: 1px;
    background: transparent;
  }

  .about {
    padding: 110px 0;
    border-block: 0;
    background: transparent;
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(300px, 0.7fr);
    gap: 54px;
  }

  .about-copy p {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .toolkit {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-top: 52px;
  }

  .toolkit div {
    min-height: 132px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
  }

  .toolkit span {
    display: block;
    margin-bottom: 18px;
    color: var(--metal);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .toolkit strong {
    display: block;
    font-size: 1rem;
    font-weight: 560;
    line-height: 1.5;
  }

  .contact {
    padding: 110px 0 130px;
  }

  .contact-card {
    padding: clamp(28px, 6vw, 72px);
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background:
      radial-gradient(circle at 88% 18%, rgba(112, 201, 209, 0.12), transparent 22rem),
      rgba(255, 255, 255, 0.03);
  }

  .contact-card h2 {
    max-width: 800px;
    margin: 0;
    font-size: 4.8rem;
    line-height: 0.98;
  }

  @media (max-width: 1180px) {
    .hero-copy h1 {
      font-size: 6.2rem;
    }

    .contact-card h2 {
      font-size: 3.8rem;
    }
  }

  @media (max-width: 980px) {
    .hero-grid,
    .about-grid {
      grid-template-columns: 1fr;
    }

    .toolkit {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-copy h1 {
      font-size: 4.8rem;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 44px;
    }

    .hero-copy h1 {
      font-size: 3.25rem;
    }

    .hero-meta {
      grid-template-columns: 1fr;
    }

    .toolkit {
      grid-template-columns: 1fr;
    }

    .contact-card h2 {
      font-size: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      animation: rise-in 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-copy {
      animation-delay: 80ms;
    }
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
